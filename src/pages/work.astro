<script is:inline>
  (() => {
    const explorer = document.querySelector('[data-project-explorer]');
    if (!explorer) return;

    const panels            = [...explorer.querySelectorAll('[data-project-panel]')];
    const steps             = [...explorer.querySelectorAll('[data-project-step]')];
    const navBtns           = [...explorer.querySelectorAll('[data-project-nav]')];
    const currentCountEl    = explorer.querySelector('[data-current-count]');
    const progressBars      = [...explorer.querySelectorAll('[data-progress-bar]')];
    const indexCursor       = explorer.querySelector('.index-cursor');
    const indexRows         = [...explorer.querySelectorAll('.index-row')];
    const indexItems        = [...explorer.querySelectorAll('.index-item')];
    const projectIndex      = explorer.querySelector('.project-index');
    const indexPreview      = explorer.querySelector('[data-index-preview]');
    const indexPreviewImage = explorer.querySelector('[data-index-preview-image]');
    const mobileQuery = window.matchMedia('(max-width: 991px)');

    const total = panels.length;
    let activeIndex = 0;
    let isTransitioning = false;
    let previewRequest  = 0;

    function pad(n) { return String(n + 1).padStart(2, '0'); }

    function setTheme(index) {
      if (mobileQuery.matches) return;
      const p = panels[index];
      if (!p) return;
      explorer.style.setProperty('--surface', p.dataset.surface);
      explorer.style.setProperty('--ink',     p.dataset.ink);
      explorer.style.setProperty('--muted',   p.dataset.muted);
      explorer.style.setProperty('--accent',  p.dataset.accent);
    }

    function updateProgress(index) {
      const pct = ((index + 1) / total) * 100;
      progressBars.forEach(b => { b.style.width = pct + '%'; });
      explorer.style.setProperty('--active-project', index + 1);
    }

    function updateCursor(index) {
      if (!indexCursor) return;
      indexCursor.style.setProperty('--active-offset', (index / total * 100) + '%');
    }

    function updateCounter(index) {
      if (!currentCountEl) return;
      currentCountEl.textContent = pad(index);
    }

    function updateNavItems(index) {
      indexRows.forEach((row, i) => row.classList.toggle('is-active', i === index));
      indexItems.forEach((item, i) => {
        item.classList.toggle('is-active', i === index);
        item.setAttribute('aria-current', i === index ? 'true' : 'false');
      });
    }

    function activatePanel(newIndex) {
      if (mobileQuery.matches || newIndex === activeIndex || isTransitioning) return;
      isTransitioning = true;

      const prev = panels[activeIndex];
      const next = panels[newIndex];

      if (prev) {
        prev.classList.add('is-leaving');
        prev.classList.remove('is-active');
        prev.setAttribute('aria-hidden', 'true');
      }

      if (next) {
        next.classList.add('is-active');
        next.classList.remove('is-leaving');
        next.setAttribute('aria-hidden', 'false');
      }

      setTheme(newIndex);
      updateProgress(newIndex);
      updateCursor(newIndex);
      updateCounter(newIndex);
      updateNavItems(newIndex);

      activeIndex = newIndex;

      setTimeout(() => {
        if (prev) prev.classList.remove('is-leaving');
        isTransitioning = false;
      }, 350);
    }

    // IntersectionObserver for scroll-driven steps on Desktop
    if (!mobileQuery.matches) {
      const stepObserver = new IntersectionObserver((entries) => {
        entries.forEach(entry => {
          if (!entry.isIntersecting) return;
          const idx = Number(entry.target.dataset.index);
          activatePanel(idx);
        });
      }, { threshold: 0.4 });

      steps.forEach(step => stepObserver.observe(step));
    }

    // Trigger enter animations when explorer comes into view
    const introObserver = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) explorer.classList.add('is-entered');
      });
    }, { threshold: 0.05 });

    introObserver.observe(explorer);

    // Hover preview in sidebar
    function hideIndexPreview() {
      previewRequest += 1;
      if (indexPreview) indexPreview.classList.remove('is-visible');
    }

    async function showIndexPreview(button) {
      if (!indexPreview || !indexPreviewImage || !projectIndex ||
          mobileQuery.matches || button.closest('.index-row')?.classList.contains('is-active')) {
        hideIndexPreview();
        return;
      }

      const image = button.dataset.projectImage;
      if (!image) return;

      const request = ++previewRequest;
      indexPreview.classList.remove('is-visible');
      indexPreviewImage.src = image;
      indexPreviewImage.alt = button.dataset.projectAlt || '';

      try { await indexPreviewImage.decode(); } catch {}
      if (request !== previewRequest) return;

      const indexRect  = projectIndex.getBoundingClientRect();
      const buttonRect = button.getBoundingClientRect();
      const previewRect = indexPreview.getBoundingClientRect();
      const previewHalf = Math.max(90, previewRect.height / 2);
      const minY = previewHalf + 16;
      const maxY = indexRect.height - previewHalf - 16;
      let targetY = buttonRect.top - indexRect.top + buttonRect.height / 2;

      const previewY = Math.min(maxY, Math.max(minY, targetY));
      indexPreview.style.setProperty('--preview-y', `${previewY}px`);
      indexPreview.style.setProperty('--preview-accent', button.dataset.projectAccent || 'var(--sky-600)');
      requestAnimationFrame(() => indexPreview.classList.add('is-visible'));
    }

    navBtns.forEach(btn => {
      btn.addEventListener('pointerenter', () => showIndexPreview(btn));
      btn.addEventListener('pointerleave', hideIndexPreview);
      btn.addEventListener('click', () => {
        hideIndexPreview();
        const idx  = Number(btn.dataset.index);
        const step = steps[idx];
        if (step) step.scrollIntoView({ behavior: 'smooth', block: 'center' });
        else activatePanel(idx);
      });
    });

    // Initialize
    updateProgress(0);
    updateCursor(0);
  })();
</script>
