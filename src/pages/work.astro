    client: "Ask Kubeir",
    status: "Design / Concept",
    pdfLink: "/ui&pdf/WhiteHorseLandingPage.pdf",
    image: "/products/whitehorse.webp",
    imageRatio: "1536 / 1024",
    titleLines: ["Ask Kubeir"],
    composition: "editorial",
    surface: "#f4f7f6",
