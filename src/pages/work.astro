const selectedProjects = projects;
const totalProjects = selectedProjects.length;
const projectCount = String(totalProjects).padStart(2, '0');
---

<Layout
  title="Portfolio & Case Studies"
  description="Real client success stories spanning renewable energy, automotive e-commerce, AI talent ecosystems, 3D websites, custom CRMs, aviation portals and digital transformation."
  keywords="software development portfolio, web development case studies, renewable energy website, automotive e-commerce, custom CRM examples, 3D website portfolio, digital transformation case studies, aviation website, AI talent platform"
>
  <div class="work-page">
    <Navbar />

    <main>
      <header class="work-intro" data-work-intro>
        <div class="container-wide work-intro__frame">
          <div class="work-intro__register">
            <p>Selected work</p>
            <span>{projectCount} projects</span>
          </div>

          <div class="work-intro__statement">
            <h1 aria-label="We design digital experiences for ambitious businesses.">
              <span>We design</span>
              <span>digital experiences</span>
              <span>for ambitious businesses.</span>
            </h1>
          </div>

          <div class="work-intro__footer">
            <p>
              A focused collection of <a href="/custom-software-development/">digital products</a>, commerce, AI, and
              <a href="/saas-development-company/">software systems</a> designed for real operational needs.
            </p>
            <a class="work-intro__cue" href="#selected-work" aria-label="Scroll to selected projects">
              <span>Explore projects</span>
              <span class="work-intro__cue-line" aria-hidden="true"></span>
              <svg viewBox="0 0 20 20" fill="none" aria-hidden="true">
                <path d="M10 3v13M5.5 11.5 10 16l4.5-4.5" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
            </a>
          </div>
        </div>
      </header>

      <section
        id="selected-work"
        class="project-explorer"
        data-project-explorer
        style={`--project-count: ${totalProjects}; --surface: ${selectedProjects[0].surface}; --ink: ${selectedProjects[0].ink}; --muted: ${selectedProjects[0].muted}; --accent: ${selectedProjects[0].accent}`}
        aria-label="Selected client projects"
      >
        <div class="explorer-sticky">
          <span class="explorer-chapter" data-ambient-count aria-hidden="true">01</span>

          <div class="container-wide explorer-frame">
            <div class="project-stage" aria-live="polite">
              {selectedProjects.map((project, index) => {
                const number = String(index + 1).padStart(2, '0');
                const destination = project.link || project.pdfLink;
                const destinationLabel = project.link ? 'Visit website' : 'View UI design';

                return (
                  <article
                    class:list={["project-panel", { "is-active": index === 0 }]}
                    id={`project-${number}`}
                    data-project-panel
                    data-index={index}
                    data-surface={project.surface}
                    data-ink={project.ink}
                    data-muted={project.muted}
                    data-accent={project.accent}
                    data-composition={project.composition}
                    data-title-lines={(project.titleLines || [project.name]).length}
                    style={`--panel-index: ${index + 1}; --panel-surface: ${project.surface}; --panel-ink: ${project.ink}; --panel-muted: ${project.muted}; --panel-accent: ${project.accent}; --project-ratio: ${project.imageRatio}; --project-width: ${project.visualWidth}; --project-offset: ${project.visualOffset}`}
                    aria-hidden={index === 0 ? "false" : "true"}
                  >
                    <div class="project-watermark" aria-hidden="true">{project.name}</div>

                    <div class="project-heading">
                      <p class="project-kicker">
                        <span>{number}</span>
                        <span>{project.category}</span>
                      </p>

                      <div class="project-title-mask">
                        <h2>
                          {(project.titleLines || [project.name]).map((line) => <span>{line}</span>)}
                        </h2>
                      </div>
                    </div>

                    <button
                      class="project-visual project-detail-trigger"
                      type="button"
                      aria-label={`Open ${project.name} project overview`}
                      data-name={project.name}
                      data-title-lines={JSON.stringify(project.titleLines || [project.name])}
                      data-category={project.category}
                      data-desc={project.desc}
                      data-tech={project.technologies}
                      data-client={project.client}
                      data-status={project.status || ""}
                      data-link={project.link || ""}
                      data-pdf={project.pdfLink || ""}
                      data-image={project.image}
                      data-accent={project.accent}
                      data-surface={project.surface}
                      data-ink={project.ink}
                      data-muted={project.muted}
                      data-number={number}
                    >
                      <span class="project-visual__frame">
                        <img
                          src={project.image}
                          alt={`${project.name} digital product interface`}
                          width={project.imageRatio.split(' / ')[0]}
                          height={project.imageRatio.split(' / ')[1]}
                          loading={index === 0 ? "eager" : "lazy"}
                          fetchpriority={index === 0 ? "high" : "auto"}
                        />
                      </span>
                      <span class="project-visual__command" aria-hidden="true">
                        <span>Inspect Case Study</span>
                        <svg viewBox="0 0 20 20" fill="none">
                          <path d="M6 14 14 6m0 0H8m6 0v6" stroke="currentColor" stroke-width="1.25" stroke-linecap="round" stroke-linejoin="round" />
                        </svg>
                      </span>
                    </button>

                    <div class="project-dek-wrap">
                      <p class="project-dek">{project.desc}</p>
                    </div>

                    <div class="project-panel__footer">
                      <dl class="project-meta">
                        <div>
                          <dt>Client</dt>
                          <dd>{project.client}</dd>
                        </div>
                        <div>
                          <dt>Capabilities</dt>
                          <dd>{project.technologies}</dd>
                        </div>
                        {project.status && (
                          <div>
                            <dt>Status</dt>
                            <dd>{project.status}</dd>
                          </div>
                        )}
                      </dl>

                      {destination && (
                        <a class="project-link" href={destination} target="_blank" rel="noopener noreferrer">
                          <span>{project.link ? 'Visit website' : destinationLabel}</span>
                          <svg viewBox="0 0 20 20" fill="none" aria-hidden="true">
                            <path d="M6 14 14 6m0 0H8m6 0v6" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round" />
                          </svg>
                        </a>
                      )}
                    </div>
                  </article>
                );
              })}
            </div>

            <aside class="project-index" aria-label="Project index">
              <div class="project-index__head">
                <div>
                  <span class="index-label">Selected work</span>
                  <span class="index-instruction">Scroll to explore</span>
                </div>
                <div class="index-counter" aria-label={`Project 1 of ${totalProjects}`}>
                  <span data-current-count>01</span>
                  <span class="index-counter__divider">/</span>
                  <span>{projectCount}</span>
                </div>
              </div>

              <div class="index-hover-preview" data-index-preview aria-hidden="true">
                <img data-index-preview-image src="" alt="" />
              </div>

              <div class="project-index__rail">
                <span class="index-timeline" aria-hidden="true"></span>
                <span class="index-cursor" aria-hidden="true"></span>
                <ol class="project-index__list">
                  {selectedProjects.map((project, index) => {
                    const number = String(index + 1).padStart(2, '0');
                    return (
                      <li class:list={["index-row", { "is-active": index === 0 }]}>
                        <button
                          class:list={["index-item", { "is-active": index === 0 }]}
                          type="button"
                          data-project-nav
                          data-index={index}
                          data-project-name={project.indexName || project.name}
                          data-project-image={project.image}
                          data-project-alt={`${project.name} project preview`}
                          data-project-accent={project.accent}
                          aria-controls={`project-${number}`}
                          aria-current={index === 0 ? "true" : undefined}
                        >
                          <span class="index-item__number">{number}</span>
                          <span class="index-item__copy">
                            <strong>{project.indexName || project.name}</strong>
                            <small>{project.indexCategory || project.category}</small>
                          </span>
                          <span class="index-item__arrow" aria-hidden="true">
                            <svg viewBox="0 0 18 18" fill="none">
                              <path d="M3 9h12m-4-4 4 4-4 4" stroke="currentColor" stroke-width="1.15" stroke-linecap="round" stroke-linejoin="round" />
                            </svg>
                          </span>
                        </button>
                      </li>
                    );
                  })}
                </ol>
              </div>

              <div class="project-index__foot">
                <span>Scroll through projects</span>
                <div class="index-progress" aria-hidden="true"><span data-progress-bar></span></div>
              </div>
            </aside>
          </div>
        </div>

        <div class="project-scroll-track" aria-hidden="true">
          {selectedProjects.map((_, index) => {
            const number = String(index + 1).padStart(2, '0');
            return <div class="project-scroll-step" id={`project-step-${number}`} data-project-step data-index={index}></div>;
          })}
        </div>
      </section>

      <section class="collection-end" aria-labelledby="collection-end-title">
        <div class="container-wide collection-end__inner">
          <div class="collection-end__heading">
            <p class="collection-end__count">{projectCount} / {projectCount} &nbsp; Selected work complete</p>
            <h2 id="collection-end-title"><span>Let's build</span><span>what's next.</span></h2>
          </div>
          <div class="collection-end__action">
            <p>Have a complex product, platform, or digital transformation in mind?</p>
            <a href="/contact">
              <span>Start a project</span>
              <svg viewBox="0 0 20 20" fill="none" aria-hidden="true">
                <path d="M4 10h12m-5-5 5 5-5 5" stroke="currentColor" stroke-width="1.35" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
            </a>
          </div>
        </div>
      </section>
    </main>

    <Footer />
  </div>

  <ProjectViewer projects={selectedProjects} />
</Layout>

<style>
  :global(html) {
    scroll-padding-top: 5rem;
  }

  :global(body) {
    background: var(--white);
  }

  :root {
    --lab-ease: cubic-bezier(0.16, 1, 0.3, 1);
  }

  .work-page {
    min-height: 100vh;
    overflow: clip;
    background: var(--white);
    color: var(--gray-900);
  }

  /* ─── INTRO ─── */

  .work-intro {
    position: relative;
    min-height: 100svh;
    overflow: hidden;
    background: var(--white);
  }

  .work-intro__frame {
    display: grid;
    min-height: 100svh;
    grid-template-rows: auto 1fr auto;
    padding-top: clamp(7.5rem, 13vh, 10rem);
    padding-bottom: clamp(2.25rem, 5vh, 4rem);
  }

  .work-intro__register {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-bottom: 1.15rem;
    border-bottom: 1px solid var(--gray-200);
    color: var(--sky-700);
    font-size: 0.64rem;
    font-weight: 560;
    letter-spacing: 0.13em;
    text-transform: uppercase;
    animation: intro-register 700ms cubic-bezier(0.16, 1, 0.3, 1) 100ms both;
  }

  .work-intro__register span {
    color: var(--gray-500);
  }

  .work-intro__statement {
    display: flex;
    justify-content: center;
    align-items: center;
    width: 100%;
  }

  .work-intro h1 {
    align-self: center;
    margin: clamp(2.5rem, 6vh, 5.5rem) auto;
    width: fit-content;
    max-width: 100%;
    color: var(--gray-900);
    font-size: clamp(3.8rem, 8.5vw, 8.8rem);
    font-weight: 420;
    line-height: 0.84;
    letter-spacing: -0.075em;
  }

  .work-intro h1 span {
    display: table;
    opacity: 0;
    transform: translate3d(0, 105%, 0);
    animation: intro-line 900ms cubic-bezier(0.16, 1, 0.3, 1) forwards;
  }

  .work-intro h1 span:nth-child(1) { animation-delay: 160ms; }
  .work-intro h1 span:nth-child(2) { margin-left: 4.5vw; animation-delay: 240ms; }
  .work-intro h1 span:nth-child(3) { margin-left: 9vw; color: var(--sky-600); animation-delay: 320ms; }

  @keyframes intro-register {
    from { opacity: 0; transform: translate3d(0, -10px, 0); }
    to   { opacity: 1; transform: none; }
  }

  @keyframes intro-line {
    from { opacity: 0; transform: translate3d(0, 105%, 0); }
    to   { opacity: 1; transform: none; }
  }

  .work-intro__footer {
    display: grid;
    grid-template-columns: minmax(18rem, 0.62fr) minmax(17rem, 0.38fr);
    gap: clamp(4rem, 11vw, 11rem);
    align-items: end;
    padding-top: 1.4rem;
    border-top: 1px solid var(--gray-200);
    animation: intro-register 700ms cubic-bezier(0.16, 1, 0.3, 1) 420ms both;
  }

  .work-intro__footer > p {
    max-width: 40rem;
    margin: 0;
    color: var(--gray-600);
    font-size: clamp(0.86rem, 1vw, 0.98rem);
    line-height: 1.6;
  }

  .work-intro__footer a:not(.work-intro__cue) {
    color: var(--gray-900);
    text-decoration-color: var(--sky-300);
    text-underline-offset: 0.2em;
  }

  .work-intro__cue {
    display: grid;
    grid-template-columns: auto minmax(2rem, 1fr) 1.1rem;
    gap: 0.85rem;
    align-items: center;
    color: var(--sky-700);
    font-size: 0.66rem;
    font-weight: 560;
    letter-spacing: 0.1em;
    text-decoration: none;
    text-transform: uppercase;
  }

  .work-intro__cue-line {
    height: 1px;
    background: var(--sky-400);
    transform-origin: left;
    transition: transform 300ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  .work-intro__cue svg {
    width: 1.05rem;
    height: 1.05rem;
    transition: transform 260ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  .work-intro__cue:hover .work-intro__cue-line { transform: scaleX(0.86); }
  .work-intro__cue:hover svg { transform: translateY(4px); }

  /* ─── PROJECT EXPLORER (DESKTOP) ─── */

  .project-explorer {
    --surface: var(--sky-50);
    --ink: var(--gray-900);
    --muted: var(--gray-600);
    --accent: var(--sky-600);
    position: relative;
    height: calc(var(--project-count) * 102svh);
    scroll-margin-top: -5rem;
    background: var(--surface);
    color: var(--ink);
    transition: background-color 650ms ease, color 450ms ease;
  }

  .explorer-sticky {
    position: sticky;
    top: 0;
    z-index: 2;
    height: 100svh;
    overflow: hidden;
    background: var(--surface);
    transition: background-color 650ms ease;
  }

  .explorer-sticky::before {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background: linear-gradient(105deg, color-mix(in srgb, var(--ink) 3%, transparent), transparent 46%);
    content: '';
  }

  .explorer-chapter {
    display: none;
  }

  .project-watermark {
    position: absolute;
    top: -4%;
    left: -4%;
    z-index: 0;
    font-size: clamp(12rem, 25vw, 34rem);
    font-weight: 900;
    letter-spacing: -0.06em;
    line-height: 0.75;
    text-transform: uppercase;
    color: color-mix(in srgb, var(--panel-ink) 4.5%, transparent);
    pointer-events: none;
    user-select: none;
    white-space: nowrap;
    opacity: 0;
    transform: translate3d(-45px, 0, 0);
    transition: opacity 520ms ease, transform 750ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  .explorer-frame {
    position: relative;
    z-index: 1;
    display: grid;
    height: 100%;
    grid-template-columns: minmax(0, 1fr) clamp(18rem, 21.5vw, 21.5rem);
    gap: clamp(2.75rem, 5vw, 6rem);
    padding-top: clamp(5.75rem, 9vh, 7rem);
    padding-bottom: clamp(1.5rem, 4vh, 2.75rem);
  }

  .project-stage {
    position: relative;
    min-width: 0;
    height: 100%;
  }

  .project-panel {
    position: absolute;
    inset: 0;
    min-width: 0;
    color: var(--panel-ink);
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transition: opacity 450ms ease, visibility 450ms ease;
  }

  .project-panel.is-active {
    opacity: 1;
    visibility: visible;
    z-index: 3;
    pointer-events: auto;
  }

  .project-panel.is-leaving {
    opacity: 0;
    visibility: visible;
    z-index: 2;
  }

  .project-heading {
    position: absolute;
    top: 0;
    left: 0;
    z-index: 5;
    width: min(95%, 62rem);
    pointer-events: none;
  }

  .project-kicker {
    display: inline-flex;
    align-items: center;
    gap: 0.85rem;
    margin: 0 0 clamp(0.7rem, 1.4vh, 1rem);
    padding: 0.38rem 1.1rem;
    border-radius: 100px;
    background: color-mix(in srgb, var(--panel-ink) 6%, transparent);
    backdrop-filter: blur(16px);
    border: 1px solid color-mix(in srgb, var(--panel-ink) 14%, transparent);
    color: var(--panel-muted);
    font-size: clamp(0.6rem, 0.68vw, 0.72rem);
    font-weight: 650;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    opacity: 0;
    transform: translate3d(0, 8px, 0);
    transition: opacity 260ms ease, transform 420ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  .project-kicker span:first-child {
    color: var(--panel-accent);
    font-variant-numeric: tabular-nums;
    font-weight: 700;
  }

  .project-title-mask {
    overflow: visible;
    padding: 0.04em 0 0.08em;
    pointer-events: auto;
    margin-top: -0.2rem;
  }

  .project-title-mask h2 {
    margin: 0;
    color: var(--panel-ink);
    font-size: clamp(4.2rem, 8vw, 9.5rem);
    font-weight: 350;
    line-height: 0.86;
    letter-spacing: -0.072em;
    transition: letter-spacing 300ms ease, transform 300ms ease;
    cursor: default;
    text-shadow: 0 10px 40px color-mix(in srgb, var(--panel-surface) 80%, transparent);
  }

  .project-title-mask h2:hover {
    letter-spacing: -0.04em;
    transform: translateY(-2px);
  }

  .project-title-mask h2 span {
    display: table;
    padding-right: 0.14em;
    opacity: 0;
    transform: translate3d(0, 115%, 0) skewY(3deg);
    transition: opacity 400ms ease, transform 650ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  .project-title-mask h2 span:nth-child(2) {
    margin-left: clamp(2rem, 5vw, 6rem);
    font-weight: 300;
    transition-delay: 60ms;
  }

  .project-visual {
    position: absolute;
    bottom: clamp(5.4rem, 9vh, 7rem);
    left: var(--project-offset);
    z-index: 2;
    display: block;
    width: var(--project-width);
    aspect-ratio: var(--project-ratio);
    overflow: visible;
    padding: 0;
    border: 0;
    background: transparent;
    color: var(--panel-ink);
    cursor: zoom-in;
    opacity: 0;
    transform: translate3d(0, 24px, 0) scale(1.01);
    transition: opacity 400ms ease, transform 650ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  .project-visual__frame {
    position: absolute;
    inset: 0;
    display: block;
    overflow: hidden;
    background: transparent;
    box-shadow: 0 2.4rem 5.5rem -4rem color-mix(in srgb, var(--panel-ink) 55%, transparent);
    clip-path: inset(0 0 100% 0);
    transition: clip-path 700ms cubic-bezier(0.16, 1, 0.3, 1), box-shadow 280ms ease;
  }

  .project-visual img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top center;
    transform: scale(1.035);
    transition: transform 750ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  .project-visual__command {
    position: absolute;
    right: 0;
    bottom: -2rem;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--panel-ink);
    font-size: 0.58rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    opacity: 0;
    text-transform: uppercase;
    transform: translate3d(-8px, 0, 0);
    transition: opacity 220ms ease, transform 280ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  .project-visual__command svg { width: 0.9rem; height: 0.9rem; }
  .project-visual:hover .project-visual__command { opacity: 1; transform: none; }

  .project-dek-wrap { display: block; }

  .project-dek {
    position: absolute;
    top: clamp(3rem, 6vh, 5rem);
    right: 0;
    z-index: 6;
    display: -webkit-box;
    width: min(30%, 20rem);
    overflow: hidden;
    margin: 0;
    color: var(--panel-muted);
    font-size: clamp(0.78rem, 0.88vw, 0.95rem);
    font-weight: 420;
    line-height: 1.6;
    opacity: 0;
    transform: translate3d(0, 16px, 0);
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 5;
    transition: opacity 400ms ease, transform 520ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  .project-panel__footer {
    position: absolute;
    right: 0;
    bottom: clamp(0.75rem, 1.6vh, 1.25rem);
    left: 7%;
    z-index: 6;
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: clamp(2rem, 4vw, 4.5rem);
    align-items: end;
  }

  .project-meta {
    display: grid;
    grid-template-columns: minmax(8rem, 1.05fr) minmax(10rem, 1.35fr) minmax(6rem, 0.7fr);
    gap: clamp(1.5rem, 3.5vw, 4rem);
    align-items: end;
    margin: 0;
  }

  .project-meta div {
    min-width: 0;
    opacity: 0;
    transform: translate3d(0, 14px, 0);
    transition: opacity 360ms ease, transform 520ms var(--lab-ease);
  }

  .project-meta dt {
    margin: 0 0 0.42rem;
    color: var(--panel-muted);
    font-size: 0.48rem;
    font-weight: 620;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .project-meta dd {
    margin: 0;
    color: var(--panel-ink);
    font-size: clamp(0.7rem, 0.76vw, 0.79rem);
    font-weight: 480;
    line-height: 1.35;
  }

  .project-link {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: space-between;
    min-width: clamp(8.5rem, 11vw, 10.5rem);
    gap: 0.65rem;
    padding: 0 0 0.55rem;
    color: var(--panel-ink);
    font-size: 0.67rem;
    font-weight: 620;
    letter-spacing: 0.07em;
    opacity: 0;
    text-decoration: none;
    text-transform: uppercase;
    transform: translate3d(0, 12px, 0);
    transition: color 200ms ease, opacity 360ms ease, padding-left 200ms ease, transform 520ms var(--lab-ease);
  }

  .project-link::after {
    position: absolute;
    right: 0;
    bottom: 0;
    left: 0;
    height: 1px;
    background: var(--panel-accent);
    content: '';
    transform: scaleX(0.72);
    transform-origin: left;
    transition: transform 320ms var(--lab-ease);
  }

  .project-link svg {
    width: 0.9rem;
    height: 0.9rem;
    transition: transform 240ms var(--lab-ease);
  }

  .project-link:hover { color: var(--panel-accent); padding-left: 0.22rem; }
  .project-link:hover::after { transform: scaleX(1); }
  .project-link:hover svg { transform: translate3d(4px, -4px, 0); }

  /* Active panel animations */
  .project-explorer.is-entered .project-panel.is-active .project-kicker,
  .project-explorer.is-entered .project-panel.is-active .project-title-mask h2 span,
  .project-explorer.is-entered .project-panel.is-active .project-visual,
  .project-explorer.is-entered .project-panel.is-active .project-dek,
  .project-explorer.is-entered .project-panel.is-active .project-link,
  .project-explorer.is-entered .project-panel.is-active .project-meta div {
    opacity: 1;
    transform: none;
  }

  .project-explorer.is-entered .project-panel.is-active .project-visual__frame { clip-path: inset(0 0 0 0); }
  .project-explorer.is-entered .project-panel.is-active .project-visual img { transform: scale(1); }

  .project-explorer.is-entered .project-panel.is-active .project-kicker { transition-delay: 100ms; }
  .project-explorer.is-entered .project-panel.is-active .project-title-mask h2 span:first-child { transition-delay: 140ms; }
  .project-explorer.is-entered .project-panel.is-active .project-title-mask h2 span:nth-child(2) { transition-delay: 190ms; }
  .project-explorer.is-entered .project-panel.is-active .project-visual { transition-delay: 30ms; }
  .project-explorer.is-entered .project-panel.is-active .project-visual__frame { transition-delay: 30ms; }
  .project-explorer.is-entered .project-panel.is-active .project-dek { transition-delay: 240ms; }
  .project-explorer.is-entered .project-panel.is-active .project-link { transition-delay: 300ms; }
  .project-explorer.is-entered .project-panel.is-active .project-meta div { transition-delay: 280ms; }

  /* Leaving panel exit */
  .project-panel.is-leaving .project-kicker,
  .project-panel.is-leaving .project-title-mask h2 span,
  .project-panel.is-leaving .project-visual,
  .project-panel.is-leaving .project-dek,
  .project-panel.is-leaving .project-link,
  .project-panel.is-leaving .project-meta div {
    opacity: 0;
    transition-duration: 250ms;
  }

  .project-panel.is-leaving .project-title-mask h2 span { transform: translate3d(0, -100%, 0); }
  .project-panel.is-leaving .project-visual { transform: translate3d(0, -16px, 0) scale(0.99); }

  /* ─── INDEX SIDEBAR ─── */

  .project-index {
    position: relative;
    z-index: 12;
    display: flex;
    min-width: 0;
    height: 100%;
    flex-direction: column;
    overflow: visible;
    color: var(--ink);
    opacity: 0;
    transform: translate3d(18px, 0, 0);
    transition: color 520ms ease, opacity 560ms ease 200ms, transform 680ms var(--lab-ease) 200ms;
  }

  .project-explorer.is-entered .project-index { opacity: 1; transform: none; }

  .project-index__head {
    display: flex;
    flex: 0 0 auto;
    align-items: flex-end;
    justify-content: space-between;
    gap: 1rem;
    padding-bottom: clamp(1.25rem, 2vh, 1.75rem);
    border-bottom: 1px solid color-mix(in srgb, var(--ink) 22%, transparent);
  }

  .project-index__head > div:first-child {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
  }

  .index-label,
  .index-instruction {
    font-size: 0.58rem;
    font-weight: 620;
    letter-spacing: 0.13em;
    text-transform: uppercase;
  }

  .index-instruction {
    color: var(--muted);
    font-size: 0.49rem;
    font-weight: 520;
  }

  .index-counter {
    display: flex;
    align-items: flex-end;
    gap: 0.36rem;
    padding-bottom: 0.1rem;
    color: var(--muted);
    font-size: 0.68rem;
    font-variant-numeric: tabular-nums;
  }

  .index-counter [data-current-count] {
    display: inline-block;
    min-width: 1.5em;
    color: var(--accent);
    font-size: clamp(3.2rem, 4vw, 4.25rem);
    font-weight: 540;
    letter-spacing: -0.04em;
    line-height: 0.7;
    transition: color 400ms ease;
  }

  .index-counter__divider { opacity: 0.35; }

  .project-index__rail {
    position: relative;
    min-height: 0;
    flex: 1;
    overflow: visible;
    padding-left: 0;
  }

  .index-timeline,
  .index-cursor {
    display: none !important;
  }

  .project-index__list {
    display: flex;
    height: 100%;
    min-height: 0;
    flex-direction: column;
    overflow: visible;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .project-index__list li {
    min-height: 0;
    flex: 0.7;
    transition: flex 560ms var(--lab-ease);
  }

  .project-index__list li.is-active {
    flex: 2.35;
  }

  /* Hover Preview Card */
  .index-hover-preview {
    --preview-y: 50%;
    --preview-accent: var(--sky-600);
    position: absolute;
    top: var(--preview-y);
    right: calc(100% + clamp(1.5rem, 2.8vw, 3rem));
    z-index: 20;
    width: clamp(15rem, 22vw, 22rem);
    aspect-ratio: 3 / 2;
    overflow: hidden;
    background: var(--surface);
    box-shadow: 0 2.5rem 5rem -3.8rem color-mix(in srgb, var(--ink) 48%, transparent);
    clip-path: inset(0 0 100% 0);
    opacity: 0;
    pointer-events: none;
    transform: translate3d(1.25rem, -50%, 0) scale(0.975);
    transform-origin: right center;
    transition: clip-path 450ms var(--lab-ease), opacity 220ms ease, transform 500ms var(--lab-ease);
  }

  .index-hover-preview.is-visible {
    clip-path: inset(0);
    opacity: 1;
    transform: translate3d(0, -50%, 0) scale(1);
  }

  .index-hover-preview img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .index-item {
    position: relative;
    display: grid;
    width: 100%;
    height: 100%;
    grid-template-columns: 1.45rem minmax(0, 1fr) 1.2rem;
    gap: 0.55rem;
    align-content: center;
    align-items: center;
    padding: 0.3rem 0;
    border: 0;
    background: transparent;
    color: var(--muted);
    cursor: pointer;
    text-align: left;
    transition: color 220ms ease;
  }

  .index-item::after {
    display: none !important;
  }

  .index-item:hover,
  .index-item.is-active { color: var(--ink); }

  .index-item__number {
    align-self: start;
    padding-top: 0.14rem;
    color: var(--muted);
    font-size: 0.54rem;
    font-variant-numeric: tabular-nums;
  }

  .index-item__copy {
    display: flex;
    min-width: 0;
    flex-direction: column;
    gap: 0.08rem;
    justify-content: center;
    transition: transform 340ms var(--lab-ease);
  }

  .index-item:hover .index-item__copy { transform: translate3d(0.42rem, 0, 0); }

  .index-item__copy strong {
    max-width: 100%;
    overflow: hidden;
    font-size: clamp(0.66rem, 0.74vw, 0.77rem);
    font-weight: 510;
    letter-spacing: -0.008em;
    line-height: 1.05;
    text-overflow: ellipsis;
    text-transform: uppercase;
    white-space: nowrap;
    transition: color 260ms ease, font-size 450ms var(--lab-ease);
  }

  .index-item__copy small {
    max-height: 1.2em;
    overflow: hidden;
    color: var(--muted);
    font-size: clamp(0.52rem, 0.6vw, 0.6rem);
    opacity: 0.72;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .index-item__arrow {
    display: flex;
    opacity: 0;
    transform: translate3d(-6px, 0, 0);
    transition: opacity 220ms ease, transform 280ms var(--lab-ease);
  }

  .index-item__arrow svg { width: 0.9rem; height: 0.9rem; }
  .index-item:hover .index-item__arrow { opacity: 1; transform: none; }

  /* Active Row Expansion */
  .index-row.is-active .index-item__number {
    align-self: start;
    padding-top: 0.32rem;
    color: var(--accent);
    font-size: 0.6rem;
  }

  .index-row.is-active .index-item__copy {
    gap: 0.5rem;
    transform: translate3d(0.5rem, 0, 0);
  }

  .index-row.is-active .index-item__copy strong {
    overflow: visible;
    color: var(--ink);
    font-size: clamp(1.65rem, 2.25vw, 2.35rem);
    font-weight: 560;
    letter-spacing: -0.055em;
    line-height: 0.86;
    text-overflow: clip;
    white-space: normal;
  }

  .index-row.is-active .index-item__copy small {
    max-height: 3em;
    color: var(--muted);
    font-size: 0.61rem;
    opacity: 0.9;
  }

  .index-row.is-active .index-item__arrow {
    align-self: end;
    margin-bottom: 0.4rem;
    opacity: 1;
    transform: none;
  }

  .project-index__list:has(.index-item:hover) .index-item:not(:hover) { opacity: 0.34; }

  .project-index__foot {
    display: grid;
    flex: 0 0 auto;
    grid-template-columns: auto minmax(3rem, 1fr);
    gap: 0.85rem;
    align-items: center;
    padding-top: 0.9rem;
    border-top: 1px solid color-mix(in srgb, var(--ink) 22%, transparent);
    color: var(--muted);
    font-size: 0.48rem;
    font-weight: 560;
    letter-spacing: 0.11em;
    text-transform: uppercase;
  }

  .index-progress {
    height: 1px;
    overflow: hidden;
    background: color-mix(in srgb, var(--ink) 20%, transparent);
  }

  .index-progress span {
    display: block;
    width: calc((var(--active-project, 1) / var(--project-count)) * 100%);
    height: 100%;
    background: var(--accent);
    transform-origin: left;
    transition: width 250ms ease, background-color 520ms ease;
  }

  .project-scroll-track {
    position: absolute;
    inset: 0;
    z-index: 1;
    display: flex;
    flex-direction: column;
    pointer-events: none;
  }

  .project-scroll-step { min-height: 102svh; flex: 1; }

  /* ─── COLLECTION END ─── */

  .collection-end {
    position: relative;
    z-index: 4;
    overflow: hidden;
    background: var(--gray-900);
    color: var(--white);
  }

  .collection-end__inner {
    display: grid;
    min-height: min(82svh, 52rem);
    grid-template-columns: minmax(0, 1fr) minmax(18rem, 0.38fr);
    gap: clamp(4rem, 10vw, 10rem);
    align-items: end;
    padding-top: clamp(6rem, 12vw, 10rem);
    padding-bottom: clamp(4rem, 8vw, 7rem);
  }

  .collection-end__count {
    margin: 0 0 clamp(2rem, 5vh, 4rem);
    color: var(--gray-400);
    font-size: 0.61rem;
    font-weight: 600;
    letter-spacing: 0.13em;
    text-transform: uppercase;
  }

  .collection-end h2 {
    margin: 0;
    color: var(--white);
    font-size: clamp(4rem, 8.5vw, 8.5rem);
    font-weight: 420;
    line-height: 0.82;
    letter-spacing: -0.075em;
  }

  .collection-end h2 span { display: block; }
  .collection-end h2 span:last-child { margin-left: 7vw; color: var(--gray-400); }

  .collection-end__action {
    padding-top: 1.25rem;
    border-top: 1px solid color-mix(in srgb, var(--gray-300) 28%, transparent);
  }

  .collection-end__action p {
    margin: 0 0 2rem;
    color: var(--gray-400);
    font-size: 0.9rem;
    line-height: 1.65;
  }

  .collection-end__action a {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    padding-bottom: 0.6rem;
    border-bottom: 1px solid color-mix(in srgb, var(--gray-200) 72%, transparent);
    color: var(--white);
    font-size: 0.72rem;
    font-weight: 620;
    letter-spacing: 0.09em;
    text-decoration: none;
    text-transform: uppercase;
    transition: border-color 220ms ease, color 220ms ease;
  }

  .collection-end__action svg {
    width: 1rem;
    height: 1rem;
    transition: transform 260ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  .collection-end__action a:hover { border-color: var(--sky-400); color: var(--sky-400); }
  .collection-end__action a:hover svg { transform: translateX(5px); }

  /* ─── MODAL — SINGLE-PAGE EDITORIAL PROJECT VIEWER (100VH) ─── */

  .project-modal[hidden] { display: none; }

  .project-modal {
    position: fixed;
    inset: 0;
    z-index: 9999;
    width: 100vw;
    height: 100vh;
    height: 100svh;
    overflow: hidden; /* Strict single screen — no page vertical scroll */
  }

  .modal-backdrop {
    position: fixed;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
    background: rgba(4, 7, 14, 0.92);
    backdrop-filter: blur(24px) saturate(180%);
    cursor: default;
  }

  .modal-window {
    --modal-surface: #060c1a;
    --modal-ink: #ffffff;
    --modal-muted: rgba(255, 255, 255, 0.65);
    --modal-accent: #38bdf8;
    position: absolute;
    inset: 0;
    z-index: 1;
    width: 100vw;
    height: 100vh;
    height: 100svh;
    display: flex;
    flex-direction: column;
    overflow: hidden;
    background: var(--modal-surface);
    color: var(--modal-ink);
    transition: background-color 450ms ease, color 450ms ease;
    animation: modal-canvas-enter 550ms cubic-bezier(0.16, 1, 0.3, 1) both;
  }

  @keyframes modal-canvas-enter {
    from { opacity: 0; transform: scale(0.985) translate3d(0, 18px, 0); }
    to   { opacity: 1; transform: none; }
  }

  /* ── Top Header Strip ── */
