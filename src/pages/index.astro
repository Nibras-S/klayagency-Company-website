// "Why Choose Us" scroll stages. One statistic is paired with each reason so the
// old 2x2 metric grid still surfaces all four numbers, one at a time.
const WCU = [
  {
    title: "Agile & Transparent",
    desc: "We iterate fast with full visibility into progress, timelines, and deliverables.",
    tags: ["Clear Timelines", "Fast Iterations", "Full Visibility"],
    stat: "50+",
    statLabel: "Projects Delivered",
  },
  {
    title: "Expert Team",
    desc: "Our engineers and designers bring proven expertise from Fortune 500 companies to fast-growing startups.",
    tags: ["Skilled Engineers", "Product Designers", "Proven Expertise"],
    stat: "40+",
    statLabel: "Expert Team Members",
  },
  {
    title: "Future-Proof Tech",
    desc: "We build for the long run, using scalable architectures and modern best practices.",
    tags: ["Scalable Systems", "Modern Stack", "Secure Architecture"],
    stat: "98%",
    statLabel: "Client Satisfaction",
  },
  {
    title: "End-to-End Ownership",
    desc: "From strategy to launch and beyond, we take responsibility for every stage.",
