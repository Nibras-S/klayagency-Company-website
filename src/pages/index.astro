  @media (max-width: 900px) {
    .about-preview__inner {
      grid-template-columns: 1fr;
      gap: 2.5rem;
      text-align: center;
    }
    .about-preview__desc {
      max-width: 600px;
      margin-left: auto;
      margin-right: auto;
    }
    .about-preview { padding: 3.5rem 0; }
  }

  /* ===== HOW IT WORKS ===== */
  .how-it-works {
    background: var(--white);
    padding-top: 6rem;
    padding-bottom: 6rem;
  }

  .process-interactive-layout {
    display: grid;
    grid-template-columns: 1.1fr 0.9fr;
    gap: 4rem;
    max-width: 1100px;
    margin: 4rem auto 0 auto;
    position: relative;
    align-items: start;
  }

  .process-steps-column {
    display: flex;
    flex-direction: column;
    gap: 0;
  }

  .process-step {
    display: block;
    cursor: pointer;
    opacity: 0.35;
    transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
    padding: 1.5rem 0;
    border-radius: 0;
    border: none;
    border-bottom: 1px solid var(--gray-150, rgba(226, 232, 240, 0.8));
    background: transparent !important;
  }

  .process-step:hover {
    opacity: 0.7;
    background: transparent !important;
  }

  .process-step.active {
    opacity: 1;
    background: transparent !important;
    border-bottom: 1px solid var(--gray-150, rgba(226, 232, 240, 0.8));
  }

  .step-progress-indicator {
    display: none;
  }

  .step-content {
    width: 100%;
  }

  .step-title {
    font-size: 1.625rem;
    font-weight: 700;
    color: var(--gray-900);
    margin-bottom: 0;
    transition: color 0.3s ease;
  }

  .process-step.active .step-title {
    color: var(--gray-900);
  }

  .step-desc-wrapper {
    display: grid;
    grid-template-rows: 0fr;
    transition: grid-template-rows 0.4s cubic-bezier(0.4, 0, 0.2, 1), opacity 0.4s ease, margin-top 0.4s ease;
    opacity: 0;
  }

  .process-step.active .step-desc-wrapper {
    grid-template-rows: 1fr;
    opacity: 1;
    margin-top: 0.75rem;
  }

  .step-desc {
    overflow: hidden;
    font-size: 0.925rem;
    color: var(--gray-600);
    line-height: 1.6;
  }

  /* Horizontal Process Progress Bar */
  .process-progress-horizontal {
    width: 100%;
    height: 2px;
    background: var(--gray-150, rgba(226, 232, 240, 0.8));
    position: relative;
    margin-bottom: 2rem;
    border-radius: 2px;
  }

  .process-progress-fill {
    position: absolute;
    top: 0;
    left: 0;
    height: 100%;
    width: 33.33%;
    background: var(--sky-600);
    transition: width 0.4s cubic-bezier(0.4, 0, 0.2, 1);
    border-radius: 2px;
  }

  /* Visual container styling */
  .process-visual-container {
    position: sticky;
    top: 150px;
    height: 400px;
    background: linear-gradient(135deg, rgba(2, 132, 199, 0.02) 0%, rgba(99, 102, 241, 0.02) 100%);
    border: 1px solid rgba(2, 132, 199, 0.08);
    border-radius: var(--radius-2xl);
    overflow: hidden;
    padding: 1.5rem;
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 
      0 4px 6px -1px rgba(0, 0, 0, 0.05),
      0 2px 4px -1px rgba(0, 0, 0, 0.03),
      inset 0 1px 0 0 rgba(255, 255, 255, 0.6);
  }

  .sticky-visual-wrapper {
    position: relative;
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .process-visual-card {
    position: absolute;
    width: 100%;
    display: flex;
    justify-content: center;
    align-items: center;
    opacity: 0;
    transform: scale(0.96) translateY(10px);
    pointer-events: none;
    transition: all 0.45s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .process-visual-card.active {
    opacity: 1;
    transform: scale(1) translateY(0);
    pointer-events: auto;
  }

  /* Mockup specific UI styles */

  /* 1. Inquiry Form Mockup */
  .inquiry-form-mockup {
    background: var(--white);
    border: 1.5px solid var(--gray-100);
    border-radius: var(--radius-xl);
    padding: 1.5rem;
