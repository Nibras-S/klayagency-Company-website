  .service-card__icon--sky { background: var(--sky-50); color: var(--sky-600); }
  .service-card__icon--violet { background: #f5f3ff; color: #7c3aed; }
  .service-card__icon--teal { background: #f0fdfa; color: #0d9488; }
  .service-card__icon--amber { background: #fffbeb; color: #d97706; }
  .service-card__icon--rose { background: #fff1f2; color: #e11d48; }
  .service-card__icon--indigo { background: #eef2ff; color: #4f46e5; }

  .service-card__title {
    font-size: 1.05rem;
    font-weight: 700;
    color: var(--gray-900);
  }

  .service-card__desc {
