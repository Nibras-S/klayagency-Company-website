  /* Shown only on touch devices that may need a deliberate motion-permission
     prompt (notably iPhone browsers). JavaScript removes it where permission
     is not required. */

  .btn-lg { padding: 0.875rem 2rem !important; font-size: 1rem !important; }

  /* Homepage CTA variants: spacious, simple pills matching the project, story,
     and contact calls-to-action used throughout the landing page. */
  .ws-cta__button {
