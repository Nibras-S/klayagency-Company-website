  }

  .services-cta {
    display: flex;
    justify-content: center;
    margin-top: 3rem;
  }

  /* ===== CUSTOM SERVICES INTERACTIVE ===== */
  .services-interactive-container {
    display: flex;
    background: #ffffff;
    border-radius: 24px;
    box-shadow: 0 10px 40px rgba(0,0,0,0.06);
    padding: 4rem 2rem 2rem 0;
    padding-left: 0;
    max-width: 1250px;
    margin: 0 auto;
    min-height: 560px;
  }

  .services-sidebar-col {
    width: 260px;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    position: relative;
    z-index: 2; /* Important: above the right pane */
  }

  .svc-nav-btn {
    background: transparent;
    border: none;
    cursor: pointer;
    color: var(--gray-400);
    padding: 0.5rem;
    margin: 0.5rem 0;
    transition: color 0.3s ease;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .svc-nav-btn:hover {
    color: var(--gray-900);
  }
  .svc-nav-btn:disabled {
    opacity: 0.3;
    cursor: default;
  }

  .services-sidebar-window {
    height: 280px; /* 4 tabs * 70px */
    width: 100%;
    overflow: hidden;
    position: relative;
  }

  .services-sidebar-track {
    display: flex;
    flex-direction: column;
    width: 100%;
    transition: transform 0.4s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .svc-tab {
    height: 70px;
    width: calc(100% - 1.5rem);
    margin-left: 1.5rem;
    margin-right: -1.5rem; /* This pulls it perfectly over the right pane margin! */
    padding: 0;
    padding-right: 1.5rem; /* Center the text visually */
    background: transparent;
    border: none;
    cursor: pointer;
    color: var(--gray-600);
    font-size: 1.1rem;
    font-weight: 500;
    transition: all 0.3s ease;
    border-radius: 24px 0 0 24px;
    text-align: center;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .svc-tab:hover {
    color: var(--gray-900);
  }

  .svc-tab.active {
    color: #ffffff;
    box-shadow: -8px 0 20px rgba(0, 0, 0, 0.05); /* Slight shadow to pop off the white bg */
  }

  .services-content-wrapper {
    flex: 1;
    position: relative;
    border-radius: 24px;
    box-shadow: 0 10px 30px rgba(0,0,0,0.08);
    z-index: 1;
  }

  .svc-pane {
    position: absolute;
    inset: 0;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.4s ease-in-out;
    display: flex;
  }

  .svc-pane.active {
    opacity: 1;
    pointer-events: auto;
    position: relative;
  }

  .svc-pane-bg {
    position: absolute;
    inset: 0;
    z-index: 0;
    border-radius: 24px;
  }
  
  .bg-blue { background: linear-gradient(135deg, #00c6ff 0%, #0072ff 100%); }
  .bg-orange { background: linear-gradient(135deg, #ff9a44 0%, #fc6076 100%); }
  .bg-sky { background: linear-gradient(135deg, #02aab0 0%, #00cdac 100%); }
  .bg-purple { background: linear-gradient(135deg, #00c6ff 0%, #0072ff 100%); } /* Matching mockup */
  .bg-pink { background: linear-gradient(135deg, #f857a6 0%, #ff5858 100%); }
  .bg-teal { background: linear-gradient(135deg, #48b1bf 0%, #06beb6 100%); }

  .svc-pane-inner {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.5rem;
    padding: 3rem;
    width: 100%;
    color: #ffffff;
  }

  .svc-pane-left {
    display: flex;
    flex-direction: column;
    justify-content: center;
  }

  .svc-pane-left h3 {
    color: #ffffff;
    font-size: 1.7rem;
    font-weight: 800;
    margin-bottom: 1rem;
    line-height: 1.25;
  }

  .svc-pane-left p {
    color: rgba(255, 255, 255, 0.9);
    font-size: 0.92rem;
    line-height: 1.6;
    margin-bottom: 1.5rem;
  }

  .svc-client-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }

  .svc-client-list li a {
    color: #ffffff;
    font-weight: 600;
    font-size: 0.9rem;
    display: inline-flex;
    align-items: center;
    transition: opacity 0.2s;
  }

  .svc-client-list li a::before {
    content: '»';
    margin-right: 0.5rem;
    color: #ff6b35; /* Orange arrows to match design */
    font-size: 1.5em;
    font-weight: 800;
  }

  .svc-client-list li a:hover {
    opacity: 0.8;
  }

  .svc-pane-right {
    position: relative;
    width: 100%;
    height: 100%;
    min-height: 420px;
  }

  .svc-img {
    position: absolute;
    border-radius: 20px;
    overflow: hidden;
    box-shadow: 0 20px 40px rgba(0,0,0,0.3);
    transition: transform 0.6s cubic-bezier(0.2, 0, 0.2, 1);
    border: 1px solid rgba(255,255,255,0.15);
  }

  /* Parallax-like slight move when hovering the entire pane */
  .svc-pane:hover .img-1 { transform: translate(-6px, 6px); }
  .svc-pane:hover .img-2 { transform: translate(-4px, -6px); }
  .svc-pane:hover .img-3 { transform: translate(6px, -4px); }

  /* Direct hover over the image */
  .svc-pane:hover .svc-img:hover {
    transform: scale(1.05) translateY(-8px) !important;
    z-index: 10;
  }

  .svc-img img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s ease;
    border-radius: 12px;
    box-shadow: 0 4px 15px rgba(0, 0, 0, 0.15);
  }

  .svc-img:hover img {
    transform: scale(1.05);
  }

  /* Default fallback positions */
  .img-1 { width: 40%; height: 45%; top: 5%; right: 5%; z-index: 3; }
  .img-2 { width: 38%; height: 40%; top: 20%; left: 5%; z-index: 2; }
  .img-3 { width: 40%; height: 45%; bottom: 5%; right: 25%; z-index: 4; }

  /* 1: Web Dev (1 image half out top-center/right) */
  #tab-web .img-1 { top: -10%; right: 4%; width: 60%; height: 35%; }
  #tab-web .img-2 { top: auto; bottom: 5%; left: -2%; width: 58%; height: 32%; }
  #tab-web .img-3 { bottom: -3%; right: -22%; width: 55%; height: 34%; }

  /* 2: Mobile App (2 images half out) */
  #tab-mobile .img-1 { top: -10%; right: -3%; width: 48%; height: 36%; }
  #tab-mobile .img-2 { top: -7%; left: 2%; width: 44%; height: 32%; }
  #tab-mobile .img-3 { bottom: 0%; right: 26%; width: 53%; height: 34%; }

  /* 3: Logo (1 image half out top-right) */
  #tab-uiux .img-1 { top: -10%; right: -3%; width: 46%; height: 36%; }
  #tab-uiux .img-2 { top: 12%; left: 5%; width: 43%; height: 30%; }
  #tab-uiux .img-3 { bottom: 0%; right: 16%; width: 50%; height: 34%; }

  /* 4: Branding (2 images half out) */
  #tab-brand .img-1 { top: -8%; right: 0%; width: 48%; height: 36%; }
  #tab-brand .img-2 { top: -10%; left: 5%; width: 43%; height: 32%; }
  #tab-brand .img-3 { bottom: -3%; right: 20%; width: 53%; height: 36%; }

  /* 5: Marketing (1 image half out) */
  #tab-marketing .img-1 { top: -12%; right: 4%; width: 50%; height: 32%; }
  #tab-marketing .img-2 { top: auto; bottom: 8%; left: 3%; width: 43%; height: 30%; }
  #tab-marketing .img-3 { bottom: 4%; right: 4%; width: 48%; height: 32%; }

  /* 6: Automation (2 images half out) */
  #tab-automation .img-1 { top: -9%; right: -8%; width: 46%; height: 35%; }
  #tab-automation .img-2 { top: -7%; left: 1%; width: 44%; height: 32%; }
  #tab-automation .img-3 { bottom: 4%; right: 30%; width: 50%; height: 34%; }

  @media (max-width: 900px) {
    .services-interactive-container {
      flex-direction: column;
      padding: 1rem 0 5rem 0; /* Add bottom padding so cards are not covered by sticky CTA */
      background: transparent;
      box-shadow: none;
    }
    .services-sidebar-col { display: none !important; }
    
    .services-content-wrapper {
      display: flex;
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      scrollbar-width: none;
      -webkit-overflow-scrolling: touch;
      overscroll-behavior-x: contain;
      gap: 1rem;
      /* No side padding: that inset was what left the neighbouring cards
         visible as strips at both edges. */
      padding: 0;
    }
    .services-content-wrapper::-webkit-scrollbar { display: none; }

    .svc-pane {
      position: relative !important;
      opacity: 1 !important;
      pointer-events: auto !important;
      /* Full width so exactly one card is on screen — no cropped neighbour.
         `start` lands it flush, and `stop: always` halts at every snap point so
         one swipe advances one card instead of flinging past several. */
      flex: 0 0 100% !important;
      max-width: 100%;
      scroll-snap-align: start;
      scroll-snap-stop: always;
      transition: none !important;
    }

    /* Longest title sets the height for the whole deck, so keep type compact. */
    /* Extra bottom padding: the image row is the last child, and without it the
       thumbnails sit hard against the card's lower edge. */
    .svc-pane-inner {
      grid-template-columns: 1fr;
      padding: 1.75rem 1.4rem 2.75rem;
    }
    .svc-pane-left h3 {
      font-size: 1.25rem;
      line-height: 1.3;
      margin-bottom: 0.75rem;
    }
    .svc-pane-left p {
      font-size: 0.875rem;
      line-height: 1.55;
      margin-bottom: 1.1rem;
    }
    .svc-client-list { gap: 0.45rem; }
    .svc-client-list li a { font-size: 0.85rem; }

    /* :hover sticks after a tap on touch and would leave images offset. */
    .svc-pane:hover .img-1,
    .svc-pane:hover .img-2,
    .svc-pane:hover .img-3 { transform: none; }
    
    .svc-pane-right {
      min-height: auto;
      margin-top: 1.5rem;
      display: flex;
      flex-direction: row;
      justify-content: center;
      align-items: flex-end;
      gap: 0.5rem;
    }
    
    .svc-pane-right .svc-img {
      position: relative !important;
      top: auto !important;
      bottom: auto !important;
      left: auto !important;
      right: auto !important;
      width: 32% !important;
      height: auto !important;
      aspect-ratio: 1;
    }
  }

  /* ===== WHAT N3 STANDS FOR / PRINCIPLES ===== */
  .principles-section {
    background: #ffffff;
    position: relative;
    overflow: hidden;
    isolation: isolate;
  }

  .principles__line {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    z-index: 0;
  }

  .principles__inner { position: relative; z-index: 1; }

  .principles__head {
    max-width: 900px;
    margin: 0 auto 3rem;
    text-align: center;
  }
  .principles__head .badge { margin-bottom: 1.25rem; }

  /* Same type spec as the hero and flow titles. */
  .principles__title {
    font-family: "Helvetica Neue", Helvetica, Arial, sans-serif;
    font-size: clamp(2.4rem, 6vw, 5rem);
    font-weight: 500;
    line-height: 0.95;
    letter-spacing: -0.05em;
    color: #000000;
    margin-bottom: 1.5rem;
  }

  .principles__row {
    display: block;
    overflow: hidden;
    padding-bottom: 0.16em;
    margin-bottom: -0.16em;
  }

  .principles__title .word {
    transform: translate3d(0, 110%, 0);
    transition: transform 0.9s cubic-bezier(0.16, 1, 0.3, 1);
    transition-delay: calc(var(--i) * 60ms);
  }
  .principles-section.is-visible .principles__title .word {
    transform: translate3d(0, 0, 0);
  }

  .principles__lede {
    color: var(--gray-500);
    font-size: 1.05rem;
    line-height: 1.7;
  }

  @media (prefers-reduced-motion: reduce) {
    .principles__title .word { transform: none; transition: none; }
  }

  /* Staggered left / right / left so the stroke weaves between the three N's
     instead of running behind a flat row of them. */
  .principles-grid {
    display: flex;
    flex-direction: column;
    gap: clamp(2rem, 6vw, 4.5rem);
    max-width: 1040px;
    margin: clamp(2.5rem, 6vw, 5rem) auto 0;
  }

  .principles-grid .principle-card {
    width: min(100%, 430px);
  }
  .principles-grid .principle-card:nth-child(1) { align-self: flex-start; }
  .principles-grid .principle-card:nth-child(2) { align-self: flex-end; }
  .principles-grid .principle-card:nth-child(3) { align-self: flex-start; }

  @media (max-width: 720px) {
    .principles-grid .principle-card,
    .principles-grid .principle-card:nth-child(n) {
      width: 100%;
      align-self: stretch;
    }
  }

  .principle-card {
    position: relative;
    background: #ffffff;
    border: 1.5px solid var(--gray-100);
    border-radius: var(--radius-xl);
    padding: 2.25rem 2rem 2rem;
    transition: var(--transition);
  }

  .principle-card:hover {
    transform: translateY(-4px);
    border-color: var(--sky-200);
    box-shadow: 0 12px 32px rgba(14, 165, 233, 0.12);
  }

  .principle-card__head {
    display: flex;
    align-items: baseline;
    gap: 0.85rem;
    margin-bottom: 0.85rem;
  }

  .principle-card__num {
    font-family: var(--font-heading);
    font-size: 1rem;
    font-weight: 800;
    color: var(--sky-700);
    letter-spacing: 0.1em;
    flex-shrink: 0;
  }

  .principle-card__title {
    font-size: 1.4rem;
    font-weight: 800;
    margin: 0;
    letter-spacing: -0.02em;
    color: var(--gray-900);
  }

  .principle-card__desc {
    color: var(--gray-600);
    line-height: 1.75;
    font-size: 0.97rem;
    margin: 0;
  }

  .principles-summary {
    max-width: 820px;
    margin: 3rem auto 0;
    padding: 1.75rem 2rem;
    background: var(--sky-50);
    border-radius: var(--radius-md);
  }

  .principles-summary p {
    margin: 0;
    color: var(--gray-700);
    line-height: 1.85;
    font-size: 1rem;
  }

  .principles-summary a {
    color: var(--sky-700);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  @media (max-width: 900px) {
    .principles-grid { grid-template-columns: 1fr; }
  }

  /* ===== WORK SHOWCASE — STICKY SCROLL ANIMATION ===== */

  /* Scroll track: gives the sticky panel room to animate */
  .ws-scroll-track {
    position: relative;
    height: 230vh;
    background: #ffffff;
  }

  /* Sticky panel fills viewport while track scrolls */
  .ws-sticky {
    position: sticky;
    top: 0;
    height: 100vh;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 0 1.5rem;
    overflow: hidden;
    background: #ffffff;
  }

  .ws-sticky-inner {
    width: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    position: relative;
    will-change: transform;
  }

  /* Heading block */
  .ws-heading {
    text-align: center;
    max-width: 680px;
    margin: 0 auto 2rem;
    position: relative;
    z-index: 10;
  }
  .ws-heading h2 {
    font-family: var(--font-heading);
    font-size: clamp(1.6rem, 3.5vw, 2.6rem);
    font-weight: 800;
    letter-spacing: -0.03em;
    color: var(--gray-900);
    margin: 0.5rem 0;
    line-height: 1.15;
  }
  .ws-heading p {
    color: var(--gray-500);
    font-size: 1rem;
    line-height: 1.7;
    margin: 0;
    max-width: 520px;
    margin-inline: auto;
  }

  /* Card stage — full available width, centered */
  .ws-stage {
    position: relative;
    width: 100%;
    max-width: 1100px;
    height: 290px;
    flex-shrink: 0;
  }

  /* Individual project cards — flex column: image top, meta bottom */
  .ws-card {
    position: absolute;
    /* size — 390×345 desktop (image + meta), sized by JS */
    width: 390px;
    height: 345px;
    border-radius: 18px;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    text-decoration: none;
    color: inherit;
    background: #ffffff;
    border: 1.5px solid rgba(0,0,0,0.07);
    box-shadow:
      0 4px 8px rgba(0,0,0,0.05),
      0 12px 32px rgba(0,0,0,0.10),
      0 28px 60px rgba(0,0,0,0.08);
    will-change: transform;
    transform-origin: center bottom;
    transition: box-shadow 0.35s ease;
    /* JS sets initial stacked transforms */
  }
  .ws-card:hover {
    box-shadow:
      0 8px 16px rgba(0,0,0,0.07),
      0 20px 48px rgba(0,0,0,0.14),
      0 40px 80px rgba(0,0,0,0.10);
  }

  /* Image section — takes all available space above meta */
  .ws-card__img {
    position: relative;
    flex: 1;
    min-height: 0;
    overflow: hidden;
    background: var(--gray-100);
  }
  .ws-card__img img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.55s cubic-bezier(0.4,0,0.2,1);
  }
  .ws-card:hover .ws-card__img img {
    transform: scale(1.04);
  }

  /* Subtle dark overlay on hover — removed */

  /* Meta panel — white text section below image */
  .ws-card__meta {
    flex-shrink: 0;
    padding: 0.85rem 1rem 0.9rem;
    background: #ffffff;
    border-top: 1px solid rgba(0,0,0,0.06);
  }
  .ws-card__name {
    display: block;
    font-size: 0.92rem;
    font-weight: 800;
    color: var(--gray-900);
    line-height: 1.3;
    margin-bottom: 0.25rem;
    letter-spacing: -0.01em;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .ws-card__desc {
    margin: 0;
    font-size: 0.78rem;
    color: var(--gray-500);
    line-height: 1.45;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  /* CTA */
  .ws-cta {
    margin-top: 2rem;
    display: flex;
    justify-content: center;
    opacity: 0;
    transform: translateY(10px);
    transition: opacity 0.4s ease 0.1s, transform 0.4s ease 0.1s;
    position: relative;
    z-index: 5;
  }
  .ws-cta.ws-visible {
    opacity: 1;
    transform: translateY(0);
  }


  /* Mobile */
  @media (max-width: 760px) {
    .ws-scroll-track { height: 300vh; }   /* more room for vertical card deal & camera pan */
    .ws-sticky { justify-content: flex-start; padding-top: 2.5rem; }
    .ws-heading { margin-bottom: 1.25rem; flex-shrink: 0; }
    .ws-stage { height: 830px; }          /* 3 × 250px + 16px gaps × 2 + buffer */
    .ws-card { width: 280px; height: 250px; border-radius: 14px; }
    .ws-labels { grid-template-columns: 1fr; gap: 0.6rem; margin-top: 1.25rem; }
    .ws-card__meta { padding: 0.7rem 0.85rem 0.75rem; }
    .ws-card__name { font-size: 0.85rem; }
    .ws-card__desc { font-size: 0.72rem; }
  }




  /* ===== ABOUT PREVIEW ===== */
  .about-preview {
    background: linear-gradient(180deg, #ffffff 0%, #f8fafc 100%);
    padding: 5rem 0;
  }

  .about-preview__inner {
    display: grid;
    grid-template-columns: 1.3fr 1fr;
    gap: 4rem;
    align-items: center;
    max-width: 1080px;
    margin: 0 auto;
  }

  .about-preview__title {
    font-size: clamp(1.75rem, 3.5vw, 2.5rem);
    font-weight: 800;
    letter-spacing: -0.02em;
    line-height: 1.2;
    margin: 1rem 0 1.25rem;
    color: var(--gray-900);
  }

  .about-preview__desc {
    color: var(--gray-600);
    font-size: 1.02rem;
    line-height: 1.8;
    margin-bottom: 2rem;
    max-width: 560px;
  }

  .about-preview__visual {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.25rem;
  }

  .founders-stack {
    display: flex;
    align-items: center;
  }

  .founder-mini {
    width: 78px;
    height: 78px;
    border-radius: 50%;
    padding: 3px;
    background: linear-gradient(135deg, #38bdf8, #0284c7);
