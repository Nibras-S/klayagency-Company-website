    display: flex;
    gap: 0.75rem;
    width: 100%;
    max-width: 420px;
    height: 280px;
  }

  .workflow-left, .workflow-right {
    flex: 1;
    background: var(--white);
    border: 1.5px solid var(--gray-100);
    border-radius: var(--radius-xl);
    overflow: hidden;
    display: flex;
    flex-direction: column;
    box-shadow: 
      0 10px 25px -5px rgba(0, 0, 0, 0.04),
      0 8px 10px -6px rgba(0, 0, 0, 0.02);
  }

  .editor-header {
    font-size: 0.65rem;
    font-weight: 700;
    color: var(--gray-400);
    background: var(--gray-50);
    padding: 0.4rem 0.6rem;
    border-bottom: 1px solid var(--gray-100);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .figma-canvas {
    flex: 1;
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: 0.75rem;
    gap: 0.5rem;
    background: #f8fafc;
  }

  .canvas-node {
    font-size: 0.65rem;
    font-weight: 500;
    padding: 0.4rem;
    border-radius: 4px;
    background: var(--white);
    border: 1px solid var(--gray-200);
    color: var(--gray-400);
    text-align: center;
  }

  .canvas-node.active-node {
    border-color: var(--sky-500);
    color: var(--sky-600);
    background: rgba(2, 132, 199, 0.02);
    position: relative;
    font-weight: 600;
  }

  .node-border {
    position: absolute;
    width: 4px;
    height: 4px;
    background: var(--white);
    border: 1px solid var(--sky-500);
  }

  .border-tl { top: -2.5px; left: -2.5px; }
  .border-tr { top: -2.5px; right: -2.5px; }
  .border-bl { bottom: -2.5px; left: -2.5px; }
  .border-br { bottom: -2.5px; right: -2.5px; }

  .node-tag {
    position: absolute;
    top: -14px;
    left: 50%;
    transform: translateX(-50%);
    font-size: 0.5rem;
    background: var(--sky-500);
    color: var(--white);
    padding: 1px 4px;
    border-radius: 2px;
    font-weight: 600;
    white-space: nowrap;
  }

  .code-editor {
    flex: 1;
    background: #0f172a;
    padding: 0.6rem;
    font-family: monospace;
    font-size: 0.6rem;
    line-height: 1.4;
    color: #cbd5e1;
    overflow: hidden;
  }

  .code-editor pre {
    margin: 0;
  }

  .code-keyword { color: #f43f5e; }
  .code-string { color: #10b981; }
  .code-func { color: #3b82f6; }
  .code-tag { color: #38bdf8; }
  .code-bool { color: #f59e0b; }

  .workflow-terminal {
    background: #020617;
    padding: 0.4rem 0.6rem;
    font-family: monospace;
    font-size: 0.55rem;
    border-top: 1px solid #1e293b;
    color: #94a3b8;
  }

  .term-line {
    margin-bottom: 0.15rem;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  /* 3. Launch & Grow dashboard */
  .dashboard-mockup {
    background: var(--white);
    border: 1.5px solid var(--gray-100);
    border-radius: var(--radius-xl);
    padding: 1.25rem;
    box-shadow: 
      0 10px 25px -5px rgba(0, 0, 0, 0.05),
      0 8px 10px -6px rgba(0, 0, 0, 0.03);
    max-width: 340px;
    width: 100%;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .dashboard-stats {
    display: flex;
    gap: 0.5rem;
  }

  .stat-card {
    flex: 1;
    background: var(--gray-50);
    border: 1px solid var(--gray-100);
    border-radius: var(--radius-md);
    padding: 0.5rem;
  }

  .stat-title {
    font-size: 0.6rem;
    font-weight: 700;
    color: var(--gray-400);
    text-transform: uppercase;
    letter-spacing: 0.03em;
    margin-bottom: 0.15rem;
  }

  .stat-value {
    font-size: 0.9rem;
    font-weight: 700;
    color: var(--gray-800);
    display: flex;
    align-items: center;
    gap: 0.25rem;
  }

  .stat-trend {
    font-size: 0.6rem;
    font-weight: 700;
    padding: 1px 4px;
    border-radius: 10px;
  }

  .stat-trend.trend-up {
    color: #10b981;
    background: rgba(16, 185, 129, 0.1);
  }

  .dashboard-chart-container {
    height: 100px;
    display: flex;
    align-items: flex-end;
    border: 1px solid var(--gray-100);
    border-radius: var(--radius-md);
    background: var(--gray-50);
    padding: 0.5rem;
    overflow: hidden;
  }

  .dashboard-chart {
    width: 100%;
    height: 100%;
    overflow: visible;
  }

  .dashboard-footer {
    border-top: 1px solid var(--gray-100);
    padding-top: 0.5rem;
    font-size: 0.7rem;
    color: var(--gray-500);
  }

  .status-indicator {
    display: flex;
    align-items: center;
    gap: 0.35rem;
  }

  .status-dot {
    width: 6px;
    height: 6px;
    background: #10b981;
    border-radius: 50%;
  }

  .pulsing {
    box-shadow: 0 0 0 rgba(16, 185, 129, 0.4);
    animation: status-pulse 2s infinite;
  }

  @keyframes status-pulse {
    0% {
      box-shadow: 0 0 0 0 rgba(16, 185, 129, 0.7);
    }
    70% {
      box-shadow: 0 0 0 6px rgba(16, 185, 129, 0);
    }
    100% {
      box-shadow: 0 0 0 0 rgba(16, 185, 129, 0);
    }
  }

  /* Responsive styles */
  @media (max-width: 1024px) {
    .how-it-works {
      padding-top: 4rem;
      padding-bottom: 4rem;
    }

    .process-interactive-layout {
      grid-template-columns: 1fr;
      gap: 1.5rem;
      margin-top: 2rem;
    }

    .process-steps-column {
      gap: 0;
    }

    .process-step {
      display: block;
      padding: 1.25rem 0;
      border-radius: 0;
      border: none;
      border-bottom: 1px solid var(--gray-150, rgba(226, 232, 240, 0.8));
      background: transparent !important;
      opacity: 0.35;
      transition: opacity 0.4s ease;
    }

    .process-step.active {
      opacity: 1;
      background: transparent !important;
      border-bottom: 1px solid var(--gray-150, rgba(226, 232, 240, 0.8));
    }

    .step-progress-indicator {
      display: none;
    }

    .step-title {
      font-size: 1.35rem;
    }

    .process-visual-container {
      display: none;
    }
  }

  .launch-demo__dot {
    width: 6px;
    height: 6px;
    background: #10b981;
    border-radius: 50%;
    animation: pulse-ring 2s ease-in-out infinite;
  }

  /* ===== WHY CHOOSE US — SCROLL-DRIVEN RADIAL SHOWCASE ===== */
  .wcu {
    position: relative;
    /* One viewport of scroll per stage, plus one so the last stage gets dwell time. */
    height: 400vh;
    background: linear-gradient(180deg, #ffffff 0%, #f2f7fe 10%, #eaf2fd 50%, #f3f8ff 90%, #ffffff 100%);
  }

  .wcu__sticky {
    position: sticky;
    top: 0;
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    justify-content: center;
    overflow: hidden;
    /* The navbar is position:fixed (68px + wrapper padding), so without this the
       title scrolls underneath it. box-sizing:border-box keeps 100vh honest. */
    padding-top: 6rem;
  }

  /* --- radial wheel: centre sits off-canvas so only the right arc shows --- */
  /* Centre pushed further off-canvas than the ring, so the numbers still land at
     ~6.5vw from the viewport edge — inside the gutter .wcu__body clears, never on
     top of the copy. Biased below centre to sit against the body row rather than
     the header above it. */
  .wcu__radial {
    position: absolute;
    top: 62%;
    left: 0;
    width: 0;
    height: 0;
    transform: translate(-23vw, -50%);
    pointer-events: none;
    z-index: 0;
  }

  .wcu__ring {
    position: absolute;
    width: 52vw;
    height: 52vw;
    left: -26vw;
    top: -26vw;
    border: 1px solid rgba(14, 165, 233, 0.2);
    border-radius: 50%;
  }

  /* Wheel container stays so JS doesn't break, but no longer rotates */
  .wcu__wheel {
    position: absolute;
    width: 0;
    height: 0;
  }

  .wcu__num {
    position: absolute;
    top: 0;
    left: 0;
    /* Fixed position exactly on the right edge of the ring */
    transform: translate(26vw, -50%);
    font-family: var(--font-heading);
    font-size: clamp(1.5rem, 2.5vw, 2.5rem);
    font-weight: 500;
    color: var(--gray-300);
    opacity: 0; /* Hide inactive numbers */
    pointer-events: none;
    white-space: nowrap;
    transition: opacity 0.5s ease, color 0.5s ease, transform 0.5s ease;
  }

  .wcu__num-inner {
    display: inline-flex;
    align-items: center;
    gap: 0.85rem;
  }

  .wcu__num.is-active {
    color: var(--primary);
    opacity: 1;
    transform: translate(26vw, -50%) scale(1.05); /* Slight pop effect */
  }

  .wcu__dot {
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: var(--primary);
    opacity: 0;
    transform: scale(0.4);
    transition: opacity 0.45s ease, transform 0.45s ease, box-shadow 0.45s ease;
  }
  .wcu__num.is-active .wcu__dot {
    opacity: 1;
    transform: scale(1);
    box-shadow: 0 0 0 4px rgba(14, 165, 233, 0.16), 0 0 14px 2px rgba(14, 165, 233, 0.5);
  }

  /* --- centre content --- */
  .wcu__inner {
    position: relative;
    z-index: 1;
  }

  .wcu__head {
    margin-bottom: clamp(2rem, 5vw, 4rem);
  }

  /* The body is the only part the wheel sits beside, so the left padding here
     is what keeps the numbers off the text. Numbers land at ~6vw from the
     viewport edge; this starts the content well right of that. */
  .wcu__body {
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(0, 0.95fr);
    gap: clamp(2rem, 5vw, 4.5rem);
    align-items: center;
    padding-left: clamp(0rem, 12vw, 13rem);
  }

  .wcu__content .badge { margin-bottom: 1rem; }

  /* Identical spec to .flow__title / .hero__title — now that the header spans
     the container, it can carry the full size. */
  .wcu__head h2 {
    font-family: "Helvetica Neue", Helvetica, Arial, sans-serif;
    font-size: clamp(2.5rem, 5vw, 4rem);
    font-weight: 500;
    line-height: 1.05;
    letter-spacing: -0.04em;
    color: #000000;
    margin-bottom: 1.5rem;
  }

  .wcu__lede {
    color: var(--gray-500);
    line-height: 1.75;
    max-width: 52ch;
    margin-bottom: 0;
  }

  /* All four share one grid cell, so switching stages never reflows the page. */
  .wcu__stages {
    display: grid;
    min-height: 14rem;
    margin-bottom: 2rem;
  }

  .wcu__stage {
    grid-area: 1 / 1;
    opacity: 0;
    transform: translateY(18px);
    filter: blur(6px);
    pointer-events: none;
    transition: opacity 0.55s ease,
                transform 0.55s cubic-bezier(0.22, 1, 0.36, 1),
                filter 0.55s ease;
  }
  .wcu__stage.is-active {
    opacity: 1;
    transform: none;
    filter: none;
    pointer-events: auto;
  }

  .wcu__stage-title {
    font-size: clamp(1.3rem, 2.2vw, 1.85rem);
    font-weight: 800;
    letter-spacing: -0.02em;
    margin-bottom: 0.7rem;
  }

  .wcu__stage-desc {
    color: var(--gray-600);
    line-height: 1.75;
    max-width: 44ch;
    margin-bottom: 1.25rem;
  }

  .wcu__tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    list-style: none;
  }
  .wcu__tags li {
    padding: 0.45rem 1rem;
    border-radius: var(--radius-full);
    background: #ffffff;
    border: 1px solid var(--gray-200);
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--gray-700);
  }

  /* Visuals come from .hero__pill-link (same black pill as "Our Approach");
     this only owns spacing. */
  .wcu__cta { margin-top: 0.25rem; }

  /* --- right visual --- */
  .wcu__visual {
    position: relative;
    display: grid;
    place-items: center;
    min-height: 26rem;
  }

  /* Abstract object built from gradients only — no image payload, and it can be
     reshaped per stage by swapping the border-radius. */
  .wcu__orb {
    position: absolute;
    width: min(22vw, 18rem);
    margin-top: -3rem;
    aspect-ratio: 1;
    border-radius: 42% 58% 54% 46% / 48% 42% 58% 52%;
    background: radial-gradient(circle at 32% 28%, #ffffff 0%, #f4f9ff 40%, #dbeafe 72%, #c3dafc 100%);
    box-shadow:
      inset -18px -22px 48px rgba(37, 99, 235, 0.14),
      inset 14px 16px 40px rgba(255, 255, 255, 0.95),
      0 40px 80px -30px rgba(14, 165, 233, 0.4);
    transition: transform 1.1s cubic-bezier(0.22, 1, 0.36, 1), border-radius 1.1s ease;
    will-change: transform;
  }

  .wcu__stats {
    position: relative;
    z-index: 1;
    display: grid;
  }

  .wcu__stat {
    grid-area: 1 / 1;
    text-align: center;
    mix-blend-mode: multiply;
    opacity: 0;
    transform: scale(0.94) translateX(14px) rotate(-1.5deg);
    pointer-events: none;
    /* Overshooting curve gives the spring feel without a physics library. */
    transition: opacity 0.6s ease, transform 0.75s cubic-bezier(0.34, 1.4, 0.5, 1);
  }
  .wcu__stat.is-active {
    opacity: 1;
    transform: scale(1) translateX(0) rotate(0deg);
    pointer-events: auto;
  }

  .wcu__stat-num {
    font-family: var(--font-heading);
    font-size: clamp(2.6rem, 5vw, 4rem);
    font-weight: 800;
    line-height: 1;
    letter-spacing: -0.03em;
    background: linear-gradient(135deg, var(--sky-500), var(--sky-700));
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .wcu__stat-label {
    margin-top: 0.5rem;
    color: var(--gray-500);
    font-weight: 600;
    font-size: 0.95rem;
  }

  /* --- step indicator: only shown where the wheel isn't --- */
  .wcu__steps {
    position: relative;
    z-index: 1;
    display: none;
    justify-content: center;
    gap: 0.6rem;
    margin-top: 2.25rem;
    list-style: none;
  }
  .wcu__steps li {
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    color: var(--gray-300);
    padding: 0.3rem 0.75rem;
    border-radius: var(--radius-full);
    transition: color 0.35s ease, background-color 0.35s ease;
  }
  .wcu__steps li.is-active {
    color: var(--primary);
    background-color: rgba(14, 165, 233, 0.1);
  }

  /* Tablet: drop the wheel, keep the scroll stages, add the step indicator. */
  @media (max-width: 1024px) {
    .wcu__radial { display: none; }
    .wcu__body { padding-left: 0; }
    .wcu__steps { display: flex; }
    .wcu__orb { width: min(46vw, 20rem); }
  }

  /* Phone: keep the desktop's pinned, one-stage-at-a-time interaction, but
     compress the composition so the active copy and its metric share one view. */
  @media (max-width: 860px) {
    .wcu { height: 400svh; }
    .wcu__sticky {
      position: sticky;
      top: 0;
      height: 100svh;
      min-height: 100svh;
      box-sizing: border-box;
      justify-content: center;
      padding:
        max(5rem, calc(env(safe-area-inset-top) + 4.25rem))
        0
        max(3rem, calc(env(safe-area-inset-bottom) + 2.5rem));
      overflow: hidden;
    }
    .wcu__inner { width: 100%; }
    .wcu__head {
      margin-bottom: clamp(1.25rem, 3.5svh, 2rem);
    }
    .wcu__head h2 {
      font-size: clamp(2rem, 9.5vw, 2.75rem);
      line-height: 1.02;
      margin-bottom: 0.85rem;
    }
    .wcu__lede {
      max-width: 40rem;
      font-size: clamp(0.84rem, 3.5vw, 0.95rem);
      line-height: 1.55;
    }
    .wcu__body {
      grid-template-columns: minmax(0, 1fr) minmax(6.75rem, 29vw);
      gap: clamp(0.65rem, 3vw, 1.25rem);
      align-items: center;
    }
    .wcu__stages {
      min-height: 13.25rem;
      margin-bottom: 0.85rem;
    }
    .wcu__stage-title {
      font-size: clamp(1.25rem, 5.6vw, 1.55rem);
      margin-bottom: 0.55rem;
    }
    .wcu__stage-desc {
      font-size: clamp(0.82rem, 3.45vw, 0.95rem);
      line-height: 1.55;
      margin-bottom: 0.85rem;
    }
    .wcu__tags {
      gap: 0.4rem;
    }
    .wcu__tags li {
      padding: 0.35rem 0.65rem;
      font-size: clamp(0.68rem, 2.85vw, 0.78rem);
    }
    .wcu__cta {
      margin-top: 0;
    }
    .wcu__visual {
      min-height: 10rem;
    }
    .wcu__orb {
      display: block;
      width: min(29vw, 8rem);
      margin-top: 0;
    }
    .wcu__stat-num {
      font-size: clamp(2.15rem, 10vw, 3rem);
    }
    .wcu__stat-label {
      max-width: 7.5rem;
      margin: 0.4rem auto 0;
      font-size: clamp(0.68rem, 2.8vw, 0.8rem);
      line-height: 1.25;
    }
    .wcu__steps {
      position: absolute;
      right: 0;
      bottom: max(0.65rem, env(safe-area-inset-bottom));
      left: 0;
      display: flex;
      margin-top: 0;
    }
    .wcu__steps li {
      padding: 0.25rem 0.65rem;
    }
  }


  /* ===== Touch-device paint budget =====
     Keyed on (hover: none) rather than a width breakpoint: what matters is that
     these effects are driven by a cursor that doesn't exist, so a large tablet
     should shed them too. Everything here is inert on touch anyway — this only
     stops the browser paying for it. */
  @media (hover: none) {
    /* Each will-change pins a GPU layer for the life of the page. On desktop
       that's the point; on touch nothing animates these, so the layers are pure
       memory pressure — and layer count is a common cause of mobile scroll jank. */
    .flow__parallax,
    .flow__card,
    .flow__grow,
    .principles__blob,
    .wcu__wheel,
    .wcu__orb { will-change: auto; }

    /* These stats sit over the gradient orb on touch, so keep their layer
       transparent and avoid any backdrop resampling. */
    .wcu__stat {
      backdrop-filter: none;
      -webkit-backdrop-filter: none;
      background: transparent;
    }

    /* The glows stacked conic-gradient + filter:blur + mask-image on one element.
       WebKit (i.e. every iPhone browser) forces an offscreen composite for each
       of those, and they sit over a decoding video — three of the most expensive
       things it can be asked to do, layered. A plain radial-gradient reads almost
       identically at this blur and opacity, with none of the cost. */
    .hero__glow--1 {
      background: radial-gradient(circle at 42% 40%, rgba(56,189,248,0.30) 0%, rgba(139,92,246,0.16) 45%, rgba(255,255,255,0) 72%);
      filter: none;
      -webkit-mask-image: none;
      mask-image: none;
    }
    .hero__glow--2 {
      background: radial-gradient(circle at 55% 50%, rgba(167,139,250,0.26) 0%, rgba(34,211,238,0.14) 48%, rgba(255,255,255,0) 74%);
      filter: none;
      -webkit-mask-image: none;
      mask-image: none;
    }

    /* contain:paint on a full-bleed playing video gives WebKit an extra layer to
       manage for no benefit once the scrub is gone. */
    .hero-video-full { contain: none; }
  }

  /* Hero glows are two ~620px conic gradients sitting over a playing video.
     Blur cost scales hard with radius, so halve it on phones instead of
     dropping them, and release the promoted layers since nothing moves them
     there (the parallax is pointer:fine only). */
  @media (max-width: 860px) {
    .hero__glow--1 { filter: blur(28px); }
    .hero__glow--2 { filter: blur(24px); }
    .hero__glow { will-change: auto; }
  }

  /* Same resolved layout as phone: everything visible, nothing moving. */
  @media (prefers-reduced-motion: reduce) {
    .wcu { height: auto; }
    .wcu__sticky {
      position: static;
      min-height: 0;
      padding: 3.5rem 0;
      overflow: visible;
    }
    .wcu__stages { min-height: 0; gap: 2.25rem; }
    .wcu__stage,
    .wcu__stat {
      grid-area: auto;
      opacity: 1;
      transform: none;
      filter: none;
      pointer-events: auto;
      transition: none;
    }
    .wcu__stats { gap: 1rem; }
    .wcu__radial,
    .wcu__steps { display: none; }
    .wcu__orb { transition: none; }
  }

  /* ===== RESPONSIVE ===== */

  /* Large screens: tighter inner widths */
  @media (min-width: 1440px) {
    .hero__inner {
      max-width: 1200px;
    }
    .process-grid {
      max-width: 1100px;
    }
  }

  @media (max-width: 1024px) {
    .hero {
      min-height: 100svh;
      padding-top: 80px;
      padding-bottom: 2rem;
    }
    .hero__inner {
      grid-template-columns: 1fr;
      text-align: center;
      gap: 2.5rem;
      max-width: 100%;
      padding-top: 1rem;
      padding-bottom: 1rem;
    }
    .hero__desc, .hero__cta, .hero__stats { justify-content: center; margin-left: auto; margin-right: auto; }
    .hero__cta { justify-content: center; }
    .hero__stats { justify-content: center; }
    .hero__visual { display: none; }
    .services-grid { grid-template-columns: repeat(2, 1fr); }
    .process-grid { grid-template-columns: 1fr; max-width: 100%; }
  }

  @media (max-width: 640px) {
    .hero { padding-bottom: 0; min-height: 100svh; }
    /* svh to match the hero's own unit — mixing vh here meant the fade was sized
       against the chrome-hidden viewport while the hero used the chrome-visible
       one, so the solid part could land below the fold and leave a sliver of
       video showing. Reaching full white at 72% guarantees an opaque band at the
       seam regardless of how the address bar is behaving. */
    .hero__video-bg::after {
      height: 42svh;
      background: linear-gradient(
        to bottom,
        rgba(255, 255, 255, 0) 0%,
        rgba(255, 255, 255, 0.9) 52%,
        #ffffff 72%,
        #ffffff 100%
      );
    }
    .hero-video-full { 
      object-position: 70% 0%; 
      transform: scale(1); /* Scale up video even more */
    }
    .hero__inner {
      margin-top: auto;
      text-align: left;
      padding-bottom: 0;
      gap: 0.75rem;
