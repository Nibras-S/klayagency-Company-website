          <!-- Logo -->
          <div class="svc-pane" id="tab-uiux">
            <div class="svc-pane-bg bg-sky"></div>
            <div class="svc-pane-inner">
              <div class="svc-pane-left">
                <h3>Custom Logo Design</h3>
                <p>Our design team creates intuitive, user-centric interfaces. We focus on wireframing, prototyping, and building comprehensive design systems that align with your brand's vision.</p>
                <ul class="svc-client-list">
                  <li><a href="/services#uiux">Design Systems</a></li>
