  { name: "Nabeel",  initials: "N", color: "violet", image: "/team/nabeel.webp"  },
  { name: "Nafi",    initials: "N", color: "teal",   image: "/team/nafi.webp"    },
  { name: "Farseen", initials: "F", color: "amber",  image: "/team/farseen.webp" },
