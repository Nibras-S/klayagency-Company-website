          </div>
        </div>
      </div>
    </div>
  </section>

  <script is:inline>
    document.addEventListener("DOMContentLoaded", () => {
      const tabs = document.querySelectorAll('.svc-tab');
      const panes = document.querySelectorAll('.svc-pane');
      const track = document.getElementById('svc-track');
      const btnUp = document.getElementById('svc-nav-up');
      const btnDown = document.getElementById('svc-nav-down');

      const colors = {
        'tab-web': '#0284c7',
        'tab-mobile': '#f97316',
        'tab-uiux': '#0ea5e9',
        'tab-brand': '#8b5cf6',
        'tab-marketing': '#ec4899',
        'tab-automation': '#14b8a6'
      };

      let currentIndex = 0; // Active tab index
      const totalTabs = tabs.length;
      const tabsVisible = 4;
      let scrollIndex = 0; // Topmost visible tab index

      function updateTabs() {
        tabs.forEach((t) => {
          t.classList.remove('active');
          t.style.background = 'transparent';
          t.style.color = 'var(--gray-600)';
        });
        panes.forEach(p => p.classList.remove('active'));

        const activeTab = tabs[currentIndex];
        const targetId = activeTab.getAttribute('data-tab');
        
        activeTab.classList.add('active');
        activeTab.style.background = colors[targetId];
        activeTab.style.color = '#ffffff';
        
        document.getElementById(targetId).classList.add('active');

        // Scroll track if active tab goes out of bounds
        if (currentIndex < scrollIndex) {
          scrollIndex = currentIndex;
        } else if (currentIndex >= scrollIndex + tabsVisible) {
          scrollIndex = currentIndex - tabsVisible + 1;
        }
        
        updateTrackPosition();
      }

      function updateTrackPosition() {
        const tabHeight = 70; // Must match CSS
        track.style.transform = `translateY(-${scrollIndex * tabHeight}px)`;
        btnUp.disabled = scrollIndex === 0;
        btnDown.disabled = scrollIndex >= totalTabs - tabsVisible;
      }

      tabs.forEach((tab, index) => {
        tab.addEventListener('click', () => {
          currentIndex = index;
          updateTabs();
        });
      });

      btnUp.addEventListener('click', () => {
        if (scrollIndex > 0) {
          scrollIndex--;
          updateTrackPosition();
        }
      });

      btnDown.addEventListener('click', () => {
        if (scrollIndex < totalTabs - tabsVisible) {
          scrollIndex++;
          updateTrackPosition();
        }
      });

      // Initialize
      updateTabs();
    });
  </script>

