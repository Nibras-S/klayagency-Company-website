  }

  /* Fullscreen Video Background */
  .hero--fullscreen-video {
  }
  
  .hero__video-bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: 0;
    overflow: hidden;
  }

  /* Fade out bottom of the video to blend seamlessly with the white section below */
  .hero__video-bg::after {
    content: '';
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    height: 18vh;
    background: linear-gradient(to bottom, rgba(255, 255, 255, 0) 0%, #ffffff 90%, #ffffff 100%);
    z-index: 1;
    pointer-events: none;
  }

  .hero-video-full {
    width: 100%;
    height: 100%;
    object-fit: cover;
    pointer-events: none;
    /* Keep the video on its own compositor layer so repainting a scrubbed
       frame never invalidates the hero text/glows stacked above it. */
    transform: translateZ(0);
    backface-visibility: hidden;
    contain: paint;
  }



  /* ===== FLOW — SCROLL-DRAWN PATH + LIQUID WARP ===== */
  .flow {
    position: relative;
    padding: clamp(4rem, 10vw, 9rem) 0 clamp(5rem, 12vw, 11rem);
    overflow: hidden;
    isolation: isolate;
    background: linear-gradient(180deg, #ffffff 0%, #f2f5fd 20%, #f2f5fd 80%, #ffffff 100%);
  }

  .flow__line {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: 0;
    pointer-events: none;
  }

  .flow__defs { position: absolute; width: 0; height: 0; }

  .flow__inner { position: relative; z-index: 1; }

  /* Each parallax layer is offset at its own rate — that spread is what reads as depth. */
  .flow__parallax {
    display: block;
    will-change: transform;
  }

  /* Matches .hero__title exactly — same face, size, weight and tracking. */
  .flow__title {
    font-family: "Helvetica Neue", Helvetica, Arial, sans-serif;
    font-size: clamp(3rem, 7.5vw, 6.5rem);
    font-weight: 500;
    line-height: 0.9;
    letter-spacing: -0.06em;
    color: #000000;
    margin-bottom: clamp(2.5rem, 7vw, 6rem);
  }

  /* Mask: words start below the line box and rise into it.
     line-height 0.9 makes the line box shorter than the glyphs, so descenders
     (the "g" in Brought) would be cut off by the mask. Pad, then pull back so
     the extra room costs nothing in layout. */
  .flow__row {
    display: block;
    overflow: hidden;
    padding-bottom: 0.18em;
    margin-bottom: -0.18em;
  }

  .word {
    display: inline-block;
    margin-right: 0.26em;
  }

  /* Reveal is pure CSS transition, triggered once by a class — no per-frame JS. */
  .flow__title .word {
    transform: translate3d(0, 110%, 0);
    transition: transform 0.9s cubic-bezier(0.16, 1, 0.3, 1);
    transition-delay: calc(var(--i) * 60ms);
  }

  .flow__desc .word {
    opacity: 0;
    transform: translate3d(0, 60%, 0);
    transition: opacity 0.6s ease, transform 0.6s cubic-bezier(0.16, 1, 0.3, 1);
    transition-delay: calc(var(--i) * 16ms);
  }

  .flow__cta {
    opacity: 0;
    transform: translate3d(0, 30px, 0);
    transition: opacity 0.6s ease 0.35s, transform 0.6s cubic-bezier(0.16, 1, 0.3, 1) 0.35s,
                box-shadow 0.25s ease;
  }

  .flow.is-visible .flow__title .word { transform: translate3d(0, 0, 0); }
  .flow.is-visible .flow__desc .word { opacity: 1; transform: translate3d(0, 0, 0); }
  .flow.is-visible .flow__cta { opacity: 1; transform: translate3d(0, 0, 0); }

  .flow__body {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(2rem, 6vw, 5rem);
    align-items: center;
  }

  .flow__card {
    position: relative;
    margin: 0;
    aspect-ratio: 3 / 2;
    clip-path: url(#flowClip);
    display: grid;
    will-change: transform;
    transform: translateZ(0);
  }

  /* Stacked in one cell so the canvas sits exactly over the image it distorts. */
  .flow__card > img,
  .flow__card > canvas {
    grid-area: 1 / 1;
    width: 100%;
    height: 100%;
  }

  /* cover, so the warp crops into the photo instead of exposing a gap where a
     background used to be. */
  .flow__card > img {
    object-fit: cover;
    transition: opacity 0.3s ease;
  }

  .flow__card > canvas {
    display: block;
    opacity: 0;
    /* Never intercepts clicks, hover or scroll — the effect is decoration only. */
    pointer-events: none;
    transition: opacity 0.3s ease;
  }

  /* WebGL took over: the canvas paints, the <img> goes transparent but stays in
     the layout and the a11y tree so its alt text is still exposed. */
  .flow__card.is-fluid > canvas { opacity: 1; }
  .flow__card.is-fluid > img { opacity: 0; }

  .flow__desc {
    font-size: clamp(1rem, 1.5vw, 1.35rem);
    line-height: 1.6;
    color: var(--gray-700);
    margin-bottom: 2rem;
  }



  @media (max-width: 860px) {
    .flow__body { grid-template-columns: 1fr; }
  }

  /* Everything resolves to its final state; nothing moves. */
  @media (prefers-reduced-motion: reduce) {
    .flow__card { clip-path: none; }
    .flow__card img { transform: none; }
    .flow__title .word,
    .flow__desc .word,
    .flow__cta {
      opacity: 1;
      transform: none;
      transition: none;
    }
  }

  /* ===== SERVICES GRID ===== */
  .services-grid {
