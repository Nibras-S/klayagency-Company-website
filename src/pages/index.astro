<style>
  /* ===== HERO ===== */
  .hero {
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding-top: 72px;
    background: var(--white);
    position: relative;
    /* `overflow-x: hidden` + `overflow-y: visible` is not a legal pair: per spec
       the `visible` axis computes to `auto`, which turns the hero into a scroll
       container and produces a second scrollbar. `clip` is the fix — it contains
       the axis without coercing the other one. `hidden` first as a fallback for
       browsers predating `clip` (Safari < 16). */
    overflow-x: hidden;
    overflow-x: clip;
    overflow-y: visible;
  }

  .hero__bg-dots {
    position: absolute;
    inset: 0;
    background-image: radial-gradient(circle, var(--sky-200) 1px, transparent 1px);
    background-size: 36px 36px;
    opacity: 0.35;
  }

  .hero__glow {
    position: absolute;
    border-radius: 50%;
    pointer-events: none;
    /* Parallax writes transform directly from JS; hint the compositor so the
       glows get their own layer instead of repainting the hero each frame. */
    will-change: transform;
    backface-visibility: hidden;
  }

  /* Iridescent film: a conic sweep through the spectrum, masked to a soft disc
     and heavily blurred so it reads as light on water rather than a colour wheel.
     The blur never changes, so it rasterises once and only transform animates. */
  .hero__glow--1 {
    width: 620px;
    height: 620px;
    top: -120px;
    right: -100px;
    background: conic-gradient(
      from 200deg at 50% 50%,
      rgba(56, 189, 248, 0.22),
      rgba(139, 92, 246, 0.20),
      rgba(236, 72, 153, 0.15),
      rgba(250, 204, 21, 0.13),
      rgba(45, 212, 191, 0.20),
      rgba(56, 189, 248, 0.22)
    );
    filter: blur(56px);
    -webkit-mask-image: radial-gradient(circle at 50% 50%, #000 12%, rgba(0,0,0,0.55) 45%, transparent 72%);
    mask-image: radial-gradient(circle at 50% 50%, #000 12%, rgba(0,0,0,0.55) 45%, transparent 72%);
  }

  .hero__glow--2 {
    width: 440px;
    height: 440px;
    bottom: -40px;
    left: -70px;
    background: conic-gradient(
      from 20deg at 50% 50%,
      rgba(167, 139, 250, 0.20),
      rgba(34, 211, 238, 0.18),
      rgba(244, 114, 182, 0.14),
      rgba(163, 230, 53, 0.10),
      rgba(167, 139, 250, 0.20)
    );
    filter: blur(48px);
    -webkit-mask-image: radial-gradient(circle at 50% 50%, #000 10%, rgba(0,0,0,0.5) 42%, transparent 70%);
    mask-image: radial-gradient(circle at 50% 50%, #000 10%, rgba(0,0,0,0.5) 42%, transparent 70%);
  }

  .hero__inner {
    display: grid;
    grid-template-columns: 1fr;
    gap: clamp(2rem, 4vw, 5rem);
    align-items: center;
    padding-top: 4rem;
    padding-bottom: 3rem;
    max-width: 1200px;
    margin-left: auto;
    margin-right: auto;
  }
  
  @media (min-width: 900px) {
