    border: 1.5px solid var(--gray-100);
    transition: var(--transition);
    position: relative;
    overflow: hidden;
  }

  .service-card::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 3px;
    border-radius: 3px 3px 0 0;
    opacity: 0;
    transition: opacity 0.25s;
  }

  .service-card:hover {
    transform: translateY(-6px);
    box-shadow: var(--shadow-xl);
  }

  .service-card:hover::before { opacity: 1; }

  .service-card--sky:hover { border-color: var(--sky-200); }
  .service-card--sky::before { background: var(--sky-500); }
  .service-card--violet:hover { border-color: #ddd6fe; }
  .service-card--violet::before { background: #8b5cf6; }
  .service-card--teal:hover { border-color: #99f6e4; }
  .service-card--teal::before { background: #14b8a6; }
  .service-card--amber:hover { border-color: #fde68a; }
  .service-card--amber::before { background: #f59e0b; }
  .service-card--rose:hover { border-color: #fecdd3; }
  .service-card--rose::before { background: #f43f5e; }
  .service-card--indigo:hover { border-color: #c7d2fe; }
