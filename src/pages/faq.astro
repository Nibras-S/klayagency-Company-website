---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import FaqSection from '../components/FaqSection.astro';

const faqs = [
  {
    question: "What services does Klay Agency offer?",
    answer: "We offer end-to-end digital transformation including website design & development, custom software solutions, cloud infrastructure, AI & intelligent automation, SaaS platforms, and technology consulting.",
  },
  {
    question: "Do you work with startups or only enterprises?",
    answer: "Both. We build MVPs for early-stage startups validating ideas, and ship full-scale platforms for growing companies and enterprises. We adapt our process to match the stage your business is in.",
  },
  {
    question: "How long does a typical software project take?",
    answer: "Landing pages take 1–2 weeks, MVPs typically 6–12 weeks, and full custom platforms 3–6 months depending on scope. We share a detailed timeline with every proposal.",
  },
  {
    question: "What technologies do you specialize in?",
    answer: "Our core stack includes React, Next.js, Astro, Node.js, React Native, PostgreSQL, MongoDB, Firebase, AWS and modern AI/ML frameworks. We choose the right stack per project, not a one-size-fits-all template.",
  },
  {
    question: "How does pricing work?",
    answer: "We offer fixed-price projects for well-defined scopes, and time-and-materials for flexible engagements. Pricing depends on team size, timeline, and technology requirements.",
  },
];
---

<Layout
  title="Frequently Asked Questions | Klay Agency"
  description="Answers to common questions about Klay Agency services, project timelines, technology, pricing, and ongoing support."
  keywords="Klay Agency FAQ, digital transformation questions, project timeline, technology consulting, cloud solutions, AI automation"
  faqs={faqs}
>
  <Navbar />

  <main style="padding-top: 5rem;">
    <FaqSection />
  </main>

  <Footer />
</Layout>
