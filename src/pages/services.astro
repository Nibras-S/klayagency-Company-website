---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import FaqSection from '../components/FaqSection.astro';

const serviceCategories = [
  {
    categoryId: "tech",
    categoryTitle: "Technology & Engineering",
    categoryDesc: "Full-cycle web development, native & cross-platform mobile apps, cloud infrastructure, and AI automation.",
    color: "teal",
    items: [
      {
        id: "web",
        anchorIds: ["web-development", "tech"],
        image: "/services/web-development.webp",
        imageAlt: "Web development interfaces and responsive website screens",
        icon: `<svg width="32" height="32" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8"><path stroke-linecap="round" stroke-linejoin="round" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4"/></svg>`,
        color: "teal",
        title: "Web Development",
        desc: "We craft modern, performant, and beautiful web experiences that convert visitors into customers. From high-speed marketing landing pages to complex enterprise platforms.",
        features: ["React / Next.js / Astro", "Progressive Web Apps", "E-Commerce Solutions", "CMS Integration", "Performance Optimization", "SEO-First Architecture"],
      },
      {
        id: "mobile",
        anchorIds: ["mobile-development"],
        image: "/services/mobile-app-development.webp",
        imageAlt: "Mobile app development interfaces and product screens",
        icon: `<svg width="32" height="32" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8"><path stroke-linecap="round" stroke-linejoin="round" d="M12 18h.01M8 21h8a2 2 0 002-2V5a2 2 0 00-2-2H8a2 2 0 00-2 2v14a2 2 0 002 2z"/></svg>`,
        color: "teal",
        title: "Mobile App Development",
        desc: "Native iOS/Android and cross-platform mobile apps built with Flutter and React Native. Seamless user experience with offline capability and real-time syncing.",
        features: ["React Native / Flutter", "iOS & Android Native", "Offline-First Design", "Push Notifications", "App Store Publishing", "Real-Time Features"],
      },
      {
        id: "cloud",
        anchorIds: ["cloud-solutions", "devops"],
        image: "/services/cloud-solutions.webp",
        imageAlt: "Cloud infrastructure dashboard and deployment workflow",
        icon: `<svg width="32" height="32" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8"><path stroke-linecap="round" stroke-linejoin="round" d="M3 15a4 4 0 004 4h9a5 5 0 10-.1-9.999 5.002 5.002 0 10-9.78 2.096A4.001 4.001 0 003 15z"/></svg>`,
        color: "teal",
        title: "Cloud Solutions & Infrastructure",
        desc: "Architecting, migrating, and managing cloud environments across AWS, GCP, and Azure. High-availability CI/CD pipelines, container orchestration, and serverless backends.",
        features: ["Cloud Migration", "Kubernetes & Docker", "CI/CD Pipelines", "Serverless Architecture", "Cost Optimization", "Multi-Cloud Security"],
      },
      {
        id: "ai",
        anchorIds: ["automation", "ai-automation"],
        image: "/services/ai-automation.webp",
        imageAlt: "AI automation dashboard and intelligent workflow tools",
        icon: `<svg width="32" height="32" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8"><path stroke-linecap="round" stroke-linejoin="round" d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z"/></svg>`,
        color: "teal",
        title: "Business & AI Automation",
        desc: "Leverage AI models, automated LLM integrations, and custom workflow bots to eliminate repetitive operational bottlenecks and scale output effortlessly.",
        features: ["Machine Learning Models", "LLM / ChatGPT Integration", "RPA Automation", "Predictive Analytics", "Workflow Bots", "Custom AI Agents"],
      }
    ]
  },
  {
    categoryId: "strategy",
    categoryTitle: "Strategy & Consulting",
    categoryDesc: "Roadmaps, architecture planning, and digital transformation audits to align your software with long-term business goals.",
    color: "sky",
    items: [
      {
        id: "strategy",
        anchorIds: ["consulting"],
        image: "/services/it-consulting.webp",
        imageAlt: "IT consulting strategy session and technology planning",
        icon: `<svg width="32" height="32" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8"><path stroke-linecap="round" stroke-linejoin="round" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0z"/></svg>`,
        color: "sky",
        title: "IT Consulting & Digital Strategy",
        desc: "Strategic technology consulting that aligns your digital infrastructure with your business vision. We map where you are, where you need to be, and the exact steps to get there.",
        features: ["Digital Audits", "Tech Stack Review", "Architecture Design", "Vendor Selection", "Team Augmentation", "Technology Roadmaps"],
      }
    ]
  },
  {
    categoryId: "brand",
    categoryTitle: "Brand & Design",
    categoryDesc: "Distinctive brand identities, visual design systems, and intuitive user interfaces built for scale.",
    color: "violet",
    items: [
      {
        id: "brand",
        anchorIds: ["logo", "branding"],
        image: "/services/branding-logo-design.webp",
        imageAlt: "Brand identity showcase and custom logo design",
        icon: `<svg width="32" height="32" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8"><path stroke-linecap="round" stroke-linejoin="round" d="M7 21a4 4 0 01-4-4V5a2 2 0 012-2h4a2 2 0 012 2v12a4 4 0 01-4 4zm0 0h12a2 2 0 002-2v-4a2 2 0 00-2-2h-2.343M11 7.343l1.657-1.657a2 2 0 012.828 0l2.829 2.829a2 2 0 010 2.828l-8.486 8.485M7 17h.01"/></svg>`,
        color: "violet",
        title: "Brand Identity & Logo Design",
        desc: "Custom logo design, full brand identity guidelines, and visual collateral. We craft memorable visual identities that stand out in crowded markets.",
        features: ["Custom Logo Design", "Brand Guidelines", "Typography & Color Systems", "Visual Assets", "Collateral Design", "Brand Re-positioning"],
      },
      {
        id: "uiux",
        anchorIds: ["product-design"],
        image: "/services/uiux-product-design.webp",
        imageAlt: "UI UX interface design and user experience prototyping",
        icon: `<svg width="32" height="32" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8"><path stroke-linecap="round" stroke-linejoin="round" d="M4 5a1 1 0 011-1h14a1 1 0 011 1v2a1 1 0 01-1 1H5a1 1 0 01-1-1V5zM4 13a1 1 0 011-1h6a1 1 0 011 1v6a1 1 0 01-1 1H5a1 1 0 01-1-1v-6zM16 13a1 1 0 011-1h2a1 1 0 011 1v6a1 1 0 01-1 1h-2a1 1 0 01-1-1v-6z"/></svg>`,
        color: "violet",
        title: "UI/UX & Product Design",
        desc: "User-centric wireframing, high-fidelity UI design, and interactive prototyping. We turn complex business logic into intuitive, pleasant digital experiences.",
        features: ["User Research & Personas", "Wireframing & Workflows", "High-Fidelity UI Design", "Interactive Prototypes", "Design Systems", "Usability Testing"],
      }
    ]
  },
  {
    categoryId: "marketing",
    categoryTitle: "Marketing & Growth",
    categoryDesc: "Data-backed search engine optimization, content strategy, and digital campaigns that drive qualified traffic and revenue.",
    color: "amber",
    items: [
      {
        id: "marketing",
        anchorIds: ["seo", "digital-marketing", "growth"],
        image: "/services/digital-marketing-seo.webp",
        imageAlt: "Digital marketing strategies, SEO performance and growth analytics",
        icon: `<svg width="32" height="32" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8"><path stroke-linecap="round" stroke-linejoin="round" d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6"/></svg>`,
        color: "amber",
        title: "Digital Marketing & SEO",
        desc: "Targeted digital marketing, Search Engine Optimization (SEO), performance ad management, and conversion rate optimization engineered for high ROI.",
        features: ["Search Engine Optimization (SEO)", "Digital Marketing Strategy", "Social Media Campaigns", "Content & Growth Marketing", "Conversion Optimization", "Performance Analytics"],
      }
    ]
  }
];
const faqs = [
  {
    question: "Do you only provide services, or do you build your own products?",
    answer: "We are a hybrid company. While we build custom software and SaaS platforms for our clients, we also engineer and operate our own proprietary SaaS products like N3 ServiceBook and N3 FitBook. This dual approach ensures we stay sharp on production-level operations, security, and scalability.",
  },
  {
    question: "What is your primary technology stack?",
    answer: "We are framework-agnostic but heavily favor modern, battle-tested technologies. For the frontend, we use React, Next.js, and Astro. For backend APIs, we rely on Node.js and scalable databases like PostgreSQL and MongoDB. For mobile, we build native-feeling apps using React Native and Flutter.",
  },
  {
    question: "Do you work with startups or established enterprises?",
    answer: "Both. We help founders build scalable MVPs from scratch, and we assist established enterprises in modernizing legacy systems, migrating to the cloud, and implementing digital transformation strategies.",
  },
  {
    question: "How do you handle project pricing and scoping?",
    answer: "We offer multiple engagement models. For well-defined scopes, we provide fixed-price contracts with clear milestones. For ongoing development or scaling SaaS platforms, we offer dedicated team retainers. We usually start with a paid discovery phase to map out the exact requirements and select the best model.",
  }
];
---

<Layout
  title="Software Development Services | Web, Mobile, Cloud & AI"
  description="End-to-end software development services from a Kerala-based team serving clients globally. Custom software, SaaS, web apps, mobile apps, cloud, AI/ML and digital transformation."
  keywords="software development services, custom software development, SaaS development, web development services, mobile app development services, cloud services, AI development services, software development Kerala, software company India"
  faqs={faqs}
>
  <Navbar />

  <!-- Page Hero -->
  <section class="page-hero">
    <div class="page-hero__glow"></div>
    <div class="container page-hero__inner">
      <h1 class="page-hero__title">
        Technology Services <br class="hide-sm" />
        <span class="text-gradient">Built for Impact</span>
      </h1>
    </div>
    <div class="page-hero__bg-dots"></div>
  </section>

  <!-- Interactive What We Do Overview (Stacked Cards Deck) -->
  <section class="section services-stacked-section" id="services">
    <div class="container">
      <div class="section-header" style="margin-bottom: 3.5rem;">
        <h2>
          <span style="color: var(--gray-900); font-size: 1.4em; font-weight: 900; letter-spacing: -0.02em;">What we do ?</span>
        </h2>
      </div>

      <div class="stacked-cards-container">
        
        <!-- CARD 1: Technology & Engineering -->
        <article class="stacked-card card-purple-magenta" id="card-tech">
          <div class="stacked-card__inner">
            <div class="stacked-card__visual">
              <div class="visual-hero-stage">
                <img
                  src="/servcie1.jpg"
                  alt="Technology & Engineering showcase"
                  class="visual-hero-img"
                  loading="lazy"
                />
              </div>
            </div>

            <div class="stacked-card__content">
              <h3 class="stacked-card__title">Technology &amp; Engineering</h3>
              
              <div class="stacked-card__chips">
                <span class="tech-chip">React</span>
                <span class="tech-chip">Next.JS</span>
                <span class="tech-chip">Flutter</span>
                <span class="tech-chip">Node.js</span>
                <span class="tech-chip">Python</span>
                <span class="tech-chip">AWS Cloud</span>
                <span class="tech-chip">AI &amp; Automation</span>
              </div>

              <p class="stacked-card__desc">
                We develop custom software and web/mobile platforms that stand out to international standards, ensuring peak quality and performance. Using cutting-edge technologies, we create platforms that are visually striking and highly functional.
              </p>

              <div class="stacked-card__footer">
                <a href="/services#tech" class="circular-badge-cta" aria-label="Explore Service">
                  <div class="badge-text-ring">
                    <svg viewBox="0 0 100 100" width="90" height="90">
                      <path id="circlePath-1" d="M 50, 50 m -37, 0 a 37,37 0 1,1 74,0 a 37,37 0 1,1 -74,0" fill="none" />
                      <text font-size="11.2" font-weight="700" letter-spacing="1.4" fill="#334155">
                        <textPath href="#circlePath-1" startOffset="0%">
                          EXPLORE OUR SERVICES • EXPLORE •
                        </textPath>
                      </text>
                    </svg>
                  </div>
                  <div class="badge-arrow-icon icon-magenta">
                    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                      <path d="M7 17L17 7M17 7H7M17 7V17" stroke-linecap="round" stroke-linejoin="round"/>
                    </svg>
                  </div>
                </a>
              </div>
            </div>
          </div>
        </article>

        <!-- CARD 2: Strategy & Consulting -->
        <article class="stacked-card card-electric-blue" id="card-strategy">
          <div class="stacked-card__inner layout-reverse">
            <div class="stacked-card__content">
              <h3 class="stacked-card__title">Strategy &amp; Consulting</h3>
              
              <div class="stacked-card__chips">
                <span class="tech-chip">Digital Audits</span>
                <span class="tech-chip">Tech Roadmaps</span>
                <span class="tech-chip">Cloud Architecture</span>
                <span class="tech-chip">IT Consulting</span>
                <span class="tech-chip">Growth Strategy</span>
              </div>

              <p class="stacked-card__desc">
                Digital transformation audits, technical roadmaps, and competitive benchmarking. We map where your business is, where you need to be, and the exact steps to get there — with complete clarity.
              </p>

              <div class="stacked-card__footer">
                <a href="/services#strategy" class="circular-badge-cta" aria-label="Explore Service">
                  <div class="badge-text-ring">
                    <svg viewBox="0 0 100 100" width="90" height="90">
                      <path id="circlePath-2" d="M 50, 50 m -37, 0 a 37,37 0 1,1 74,0 a 37,37 0 1,1 -74,0" fill="none" />
                      <text font-size="11.2" font-weight="700" letter-spacing="1.4" fill="#334155">
                        <textPath href="#circlePath-2" startOffset="0%">
                          EXPLORE OUR SERVICES • EXPLORE •
                        </textPath>
                      </text>
                    </svg>
                  </div>
                  <div class="badge-arrow-icon icon-blue">
                    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                      <path d="M7 17L17 7M17 7H7M17 7V17" stroke-linecap="round" stroke-linejoin="round"/>
                    </svg>
                  </div>
                </a>
              </div>
            </div>

            <div class="stacked-card__visual">
              <div class="visual-hero-stage">
                <img
                  src="/service2.jpg"
                  alt="Strategy & Consulting roadmap"
                  class="visual-hero-img"
                  loading="lazy"
                />
              </div>
            </div>
          </div>
        </article>

        <!-- CARD 3: Branding & Design -->
        <article class="stacked-card card-royal-purple" id="card-brand">
          <div class="stacked-card__inner">
            <div class="stacked-card__visual">
              <div class="visual-hero-stage">
                <img
                  src="/service3.jpg"
                  alt="Branding & Design showcase"
                  class="visual-hero-img"
                  loading="lazy"
                />
              </div>
            </div>

            <div class="stacked-card__content">
              <h3 class="stacked-card__title">Branding &amp; Design</h3>
              
              <div class="stacked-card__chips">
                <span class="tech-chip">Figma</span>
                <span class="tech-chip">UI/UX Design</span>
                <span class="tech-chip">Brand Identity</span>
                <span class="tech-chip">Logo Systems</span>
                <span class="tech-chip">Design Systems</span>
                <span class="tech-chip">Product Design</span>
              </div>

              <p class="stacked-card__desc">
                Identity systems, UI/UX, custom logo design, and product design. Visual languages that are distinctive, consistent, and built to scale effortlessly across every digital touchpoint.
              </p>

              <div class="stacked-card__footer">
                <a href="/services#brand" class="circular-badge-cta" aria-label="Explore Service">
                  <div class="badge-text-ring">
                    <svg viewBox="0 0 100 100" width="90" height="90">
                      <path id="circlePath-3" d="M 50, 50 m -37, 0 a 37,37 0 1,1 74,0 a 37,37 0 1,1 -74,0" fill="none" />
                      <text font-size="11.2" font-weight="700" letter-spacing="1.4" fill="#334155">
                        <textPath href="#circlePath-3" startOffset="0%">
                          EXPLORE OUR SERVICES • EXPLORE •
                        </textPath>
                      </text>
                    </svg>
                  </div>
                  <div class="badge-arrow-icon icon-purple">
                    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                      <path d="M7 17L17 7M17 7H7M17 7V17" stroke-linecap="round" stroke-linejoin="round"/>
                    </svg>
                  </div>
                </a>
              </div>
            </div>
          </div>
        </article>

        <!-- CARD 4: Marketing & Growth -->
        <article class="stacked-card card-sunset-coral" id="card-marketing">
          <div class="stacked-card__inner layout-reverse">
            <div class="stacked-card__content">
              <h3 class="stacked-card__title">Marketing &amp; Growth</h3>
              
              <div class="stacked-card__chips">
                <span class="tech-chip">SEO &amp; SEM</span>
                <span class="tech-chip">Digital Marketing</span>
                <span class="tech-chip">Social Media</span>
                <span class="tech-chip">Growth Analytics</span>
                <span class="tech-chip">Conversion Strategy</span>
              </div>

              <p class="stacked-card__desc">
                Grow your digital presence with targeted marketing campaigns, search engine optimization (SEO), performance marketing, and data-driven insights engineered for real ROI.
              </p>

              <div class="stacked-card__footer">
                <a href="/services#marketing" class="circular-badge-cta" aria-label="Explore Service">
                  <div class="badge-text-ring">
                    <svg viewBox="0 0 100 100" width="90" height="90">
                      <path id="circlePath-4" d="M 50, 50 m -37, 0 a 37,37 0 1,1 74,0 a 37,37 0 1,1 -74,0" fill="none" />
                      <text font-size="11.2" font-weight="700" letter-spacing="1.4" fill="#334155">
                        <textPath href="#circlePath-4" startOffset="0%">
                          EXPLORE OUR SERVICES • EXPLORE •
                        </textPath>
                      </text>
                    </svg>
                  </div>
                  <div class="badge-arrow-icon icon-coral">
                    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                      <path d="M7 17L17 7M17 7H7M17 7V17" stroke-linecap="round" stroke-linejoin="round"/>
                    </svg>
                  </div>
                </a>
              </div>
            </div>

            <div class="stacked-card__visual">
              <div class="visual-hero-stage">
                <img
                  src="/service4.jpg"
                  alt="Marketing & Growth analytics"
                  class="visual-hero-img"
                  loading="lazy"
                />
              </div>
            </div>
          </div>
        </article>

      </div>
    </div>
  </section>

  <!-- Services List -->
  <section class="section services-page" id="services-page">
    <svg class="svc-thread" viewBox="0 0 1200 3600" preserveAspectRatio="xMidYMid slice" aria-hidden="true" focusable="false">
      <defs>
        <linearGradient id="svcThread" gradientUnits="userSpaceOnUse" x1="0" y1="0" x2="1200" y2="3600">
          <stop offset="0%" stop-color="#38bdf8" />
          <stop offset="45%" stop-color="#8b5cf6" />
          <stop offset="100%" stop-color="#22d3ee" />
        </linearGradient>
      </defs>
      <path
        id="svc-thread-path"
        d="M 880,-40 C 900,220 320,300 300,560 C 280,820 900,880 880,1140 C 860,1400 300,1460 300,1720 C 300,1980 900,2020 880,2280 C 870,2540 600,2700 420,3200"
        fill="none"
        stroke="url(#svcThread)"
        stroke-width="18"
        stroke-linecap="round"
        stroke-linejoin="round"
      />
    </svg>

    <div class="container">
      <div class="services-list-grouped">
        {serviceCategories.map((cat) => (
          <div class="svc-category-group" id={cat.categoryId}>
            <div class="svc-category-header">
              <h2 class="svc-category-title">{cat.categoryTitle}</h2>
              <p class="svc-category-desc">{cat.categoryDesc}</p>
            </div>

            <div class="services-list">
              {cat.items.map((service, i) => (
                <div
                  class={`svc-block svc-block--${service.color} ${i % 2 === 1 ? 'svc-block--reverse' : ''}`}
                  id={service.id}
                  data-svc-block
                  style="position: relative;"
                >
                  {service.anchorIds?.map(anchor => (
                    <span id={anchor} style="position: absolute; top: -120px; left: 0; pointer-events: none; visibility: hidden;"></span>
                  ))}
                  <div class="svc-block__visual">
                    <div class="svc-block__media">
                      <img
                        src={service.image}
                        alt={service.imageAlt}
                        width="900"
                        height="640"
                        loading="lazy"
                        decoding="async"
                      />
                    </div>
                    <div class="svc-block__features">
                      {service.features.map(f => (
                        <div class="svc-feature">
                          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="var(--primary)" stroke-width="3"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>
                          {f}
                        </div>
                      ))}
                    </div>
                  </div>
                  <div class="svc-block__content">
                    <h3 class="svc-block__title">{service.title}</h3>
                    <p class="svc-block__desc">{service.desc}</p>
                  </div>
                </div>
              ))}
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Tech Stack -->
  <section class="section-sm tech-stack-section">
    <div class="container">
      <div class="section-header">
        <div class="badge badge-sky">Our Stack</div>
        <h2>The <span class="text-gradient">Tools</span> We Build With</h2>
        <p>We pick the right tool for the problem, not the other way around. Here's the stack we use most often across web, mobile, cloud, and SaaS projects.</p>
      </div>

      <div class="tech-grid">
        {[
          ['React', 'Frontend'],
          ['Next.js', 'Full-stack web'],
          ['Astro', 'Marketing & docs'],
          ['Node.js', 'Backend / APIs'],
          ['React Native', 'Mobile cross-platform'],
          ['Flutter', 'Mobile native UI'],
          ['PostgreSQL', 'Relational database'],
          ['MongoDB', 'Document database'],
          ['Firebase', 'Realtime / auth'],
          ['AWS', 'Cloud infrastructure'],
          ['Docker', 'Containers'],
          ['Kubernetes', 'Orchestration'],
        ].map(([name, role]) => (
          <div class="tech-tile">
            <span class="tech-tile__name">{name}</span>
            <span class="tech-tile__role">{role}</span>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Company Overview Banner -->
  <section class="company-overview-section">
    <div class="container">
      <p class="company-overview__desc">
        We are a hybrid <strong>product + service</strong> company building <a href="/custom-software-development/">custom software</a>, <a href="/saas-development-company/">SaaS platforms</a>,<br class="hide-sm" />
        web applications, and mobile apps for businesses in Kerala, India, and globally.<br class="hide-sm" />
        Every solution we ship is scalable, performance-focused, responsive, and user-centric.
      </p>
    </div>
  </section>

  <!-- Unified FAQ Section -->
  <FaqSection />

  <!-- CTA -->
  <section class="section-sm">
    <div class="container">
      <div class="services-cta-box">
        <div class="services-cta-box__content">
          <h2>Ready to Transform Your Business?</h2>
          <p>Let's discuss exactly what you need and build a plan that works for your goals and budget.</p>
        </div>
        <div class="services-cta-box__actions">
          <a href="/contact" class="btn btn-primary btn-lg">Start a Conversation</a>
          <a href="/work" class="btn btn-ghost btn-lg">See Our Work</a>
