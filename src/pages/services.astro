<script is:inline>
  (function () {
    var reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    // --- blocks slide in from their own side, once each
    var blocks = document.querySelectorAll('[data-svc-block]');
    if (reduced) {
      blocks.forEach(function (b) { b.classList.add('is-visible'); });
    } else if (blocks.length) {
      var blockIO = new IntersectionObserver(function (entries) {
        entries.forEach(function (e) {
          if (!e.isIntersecting) return;
          e.target.classList.add('is-visible');
          blockIO.unobserve(e.target);   // one-shot
        });
      }, { threshold: 0.2, rootMargin: '0px 0px -8% 0px' });
      blocks.forEach(function (b) { blockIO.observe(b); });
    }

    // --- thread draws itself as the section scrolls past
    var section = document.getElementById('services-page');
    var path = document.getElementById('svc-thread-path');
    if (reduced || !section || !path) return;

    var len = path.getTotalLength();
    path.style.strokeDasharray = String(len);
    path.style.strokeDashoffset = String(len);

    var inView = false;
    var raf = null;

    function wake() {
      if (inView && raf === null) raf = requestAnimationFrame(draw);
    }

    function draw() {
      raf = null;
      var r = section.getBoundingClientRect();
      var vh = window.innerHeight;
      // 0 -> 1 across the whole section travelling through the viewport
      var p = Math.max(0, Math.min(1, (vh - r.top) / (vh + r.height)));
      path.style.strokeDashoffset = String(len * (1 - p));
    }

    new IntersectionObserver(function (entries) {
      inView = entries[0].isIntersecting;
      wake();
    }, { rootMargin: '200px 0px' }).observe(section);

    // Purely scroll-driven, so one pass per scroll event is enough — no loop.
    window.addEventListener('scroll', wake, { passive: true });
    window.addEventListener('resize', wake, { passive: true });
    draw();
  })();
</script>
