---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
---

<Layout
  title="Our Mission | N3 Global Tech"
  description="We believe technology work should be judged by whether it holds up in production."
>
  <Navbar />

  <section class="mission-hero">
    <div class="mission-hero__glow"></div>
    <div class="container mission-hero__inner">
      <div class="badge badge-sky">Our Mission</div>
      <h1 class="mission-hero__title">Why we do this.</h1>
      <p class="mission-hero__lead">
        We believe technology work should be judged by whether it holds up in production, not how it reads in a proposal. Every engagement — a platform, a website, a piece of infrastructure — is scoped honestly, staffed with senior people, and handed over in a state we'd stand behind a year later.
      </p>
    </div>
  </section>

  <Footer />
</Layout>

<style>
  .mission-hero {
    position: relative;
    padding: calc(120px + 5rem) 0 8rem;
    background: linear-gradient(180deg, #f8fafc 0%, #ffffff 100%);
    overflow: hidden;
    text-align: center;
    min-height: 60vh;
    display: flex;
    align-items: center;
  }
  .mission-hero__glow {
    position: absolute;
    top: 0; left: 50%;
    transform: translateX(-50%);
    width: 900px; height: 450px;
    background: radial-gradient(ellipse, rgba(14,165,233,0.18) 0%, transparent 70%);
    pointer-events: none;
  }
  .mission-hero__inner {
    position: relative;
    z-index: 2;
    max-width: 860px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    align-items: center;
  }
  .mission-hero__title {
    font-size: clamp(2.5rem, 5vw, 4rem);
    font-weight: 800;
    letter-spacing: -0.03em;
    margin: 1.25rem 0 2rem;
    color: var(--gray-900);
  }
  .mission-hero__lead {
    font-size: clamp(1.2rem, 3vw, 1.45rem);
    color: var(--gray-700);
    line-height: 1.85;
    max-width: 800px;
    margin: 0 auto;
  }
</style>
