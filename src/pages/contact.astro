---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import FaqSection from '../components/FaqSection.astro';
---

<Layout
  title="Contact Klay Agency"
  description="Partner with Klay to design, build, and scale digital solutions that drive growth, improve efficiency, and create lasting business value."
  keywords="contact Klay Agency, digital transformation consultation, website development quote, custom software Dubai, AI automation UAE, cloud solutions GCC"
>
  <Navbar />

  <!-- Page Hero -->
  <section class="page-hero">
    <div class="page-hero__glow"></div>
    <div class="page-hero__bg-dots"></div>
    <div class="container page-hero__inner">
      <div class="badge badge-sky">Contact Us</div>
      <h1 class="page-hero__title">
        Transform Your Ideas Into Digital Reality
      </h1>
      <p class="page-hero__desc">
        Partner with Klay to design, build, and scale digital solutions that drive growth.
      </p>
    </div>
  </section>

  <!-- Contact section -->
  <section class="section contact-section">
    <div class="container">
      <div class="contact-grid">

        <!-- Info side -->
        <div class="contact-info">
          <h2>Get In Touch</h2>
          <p class="contact-info__desc">
            Whether you have a fully defined project or just a vague idea, we're here to help. Our team will analyze your requirements and respond with a thoughtful proposal.
          </p>

          <!-- Contact details -->
          <div class="contact-details">
            <div class="contact-detail">
              <div class="contact-detail__icon">
                <svg width="22" height="22" fill="none" viewBox="0 0 24 24" stroke="var(--sky-500)" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
              </div>
              <div>
                <div class="contact-detail__label">Email</div>
                <a href="mailto:hello@klay.agency" class="contact-detail__value">hello@klay.agency</a>
              </div>
            </div>

            <div class="contact-detail">
              <div class="contact-detail__icon">
                <svg width="22" height="22" fill="none" viewBox="0 0 24 24" stroke="var(--sky-500)" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/></svg>
              </div>
              <div>
                <div class="contact-detail__label">Phone</div>
                <a href="tel:+971585806313" class="contact-detail__value">+971 58 580 6313</a>
              </div>
            </div>

            <div class="contact-detail">
              <div class="contact-detail__icon">
                <svg width="22" height="22" fill="none" viewBox="0 0 24 24" stroke="var(--sky-500)" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/><path stroke-linecap="round" stroke-linejoin="round" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
              </div>
              <div>
                <div class="contact-detail__label">Office</div>
                <address class="contact-detail__value">
                  Klay Agency FZCO<br />
                  IFZA Business Park, Building A2<br />
                  Dubai Silicon Oasis<br />
                  Dubai, United Arab Emirates
                </address>
              </div>
            </div>

            <div class="contact-detail">
              <div class="contact-detail__icon">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="#25d366"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413"/></svg>
              </div>
              <div>
                <div class="contact-detail__label">WhatsApp</div>
                <a href="https://wa.me/971585806313?text=Hi%20Klay%20Agency%2C%20I%27d%20like%20to%20discuss%20a%20project." target="_blank" rel="noopener noreferrer" class="contact-detail__value">+971 58 580 6313</a>
              </div>
            </div>

            <div class="contact-detail">
              <div class="contact-detail__icon">
                <svg width="22" height="22" fill="none" viewBox="0 0 24 24" stroke="var(--sky-500)" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
              </div>
              <div>
                <div class="contact-detail__label">Response Time</div>
                <span class="contact-detail__value">Within 24 hours</span>
              </div>
            </div>
          </div>


        </div>

        <!-- Form side -->
        <div class="contact-form-wrap">
          <form class="contact-form" id="contact-form" novalidate>
            <div class="form-group">
              <label for="name">Name <span class="req">*</span></label>
              <input type="text" id="name" name="name" placeholder="John Doe" required />
            </div>

            <div class="form-row">
              <div class="form-group">
                <label for="company">Company</label>
                <input type="text" id="company" name="company" placeholder="Acme Corp" />
              </div>
              <div class="form-group">
                <label for="email">Email <span class="req">*</span></label>
                <input type="email" id="email" name="email" placeholder="john@company.com" required />
              </div>
            </div>

            <div class="form-group">
              <label for="service">Project Type <span class="req">*</span></label>
              <select id="service" name="service" required>
                <option value="" disabled selected>Select a project type...</option>
                <option value="custom_software">Custom Software</option>
                <option value="saas">SaaS</option>
                <option value="web">Web</option>
                <option value="mobile">Mobile</option>
                <option value="ai_automation">AI / Automation</option>
                <option value="branding">Branding</option>
                <option value="other">Other</option>
              </select>
            </div>

            <div class="form-group">
              <label for="message">Message <span class="req">*</span></label>
              <textarea id="message" name="message" rows="5" placeholder="Describe your project, goals, timeline, or any questions you have..." required></textarea>
            </div>

            <!-- Honeypot: invisible to humans, bots tend to fill every field -->
            <div class="hp-field" aria-hidden="true">
              <label for="website">Website</label>
              <input type="text" id="website" name="website" tabindex="-1" autocomplete="off" />
            </div>

            <button type="submit" class="btn btn-primary btn-submit" id="submit-btn">
              <svg width="18" height="18" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M12 19l9 2-9-18-9 18 9-2zm0 0v-8"/></svg>
              <span class="btn-submit__label">Send Message</span>
            </button>

            <p class="form-note">We take your privacy seriously. No spam, ever.</p>

            <!-- Error message -->
            <div class="form-error" id="form-error" role="alert" hidden>
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
              <span id="form-error-text">Something went wrong. Please try again or email us at hello@klay.agency.</span>
            </div>

            <!-- Success message -->
            <div class="form-success" id="form-success" aria-live="polite">
              <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="var(--sky-500)" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
              <h3>Message Sent!</h3>
              <p>Thank you for reaching out. Our team will review your message and get back to you within 24 hours.</p>
            </div>
          </form>
        </div>
      </div>
    </div>
  </section>


  <!-- Regional Offices / Global Presence -->
  <section class="section regional-offices-section">
    <div class="container">
      <div class="section-header text-center">
        <div class="badge badge-sky">GLOBAL PRESENCE</div>
        <h2>Regional <span class="text-gradient">Offices</span></h2>
        <p class="section-desc">
          Klay operates across key markets in the GCC and beyond — combining local presence with global technical expertise.
        </p>
      </div>

      <div class="offices-grid">
        <!-- UAE Office -->
        <article class="office-card">
          <header class="office-card__header">
            <div class="office-card__icon">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
                <path d="M10 12h4M10 8h4M14 21v-3a2 2 0 0 0-4 0v3M6 10H4a2 2 0 0 0-2 2v7a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2V9a2 2 0 0 0-2-2h-2M6 21V5a2 2 0 0 1 2-2h8a2 2 0 0 1 2 2v16"></path>
              </svg>
            </div>
            <h3 class="office-card__title">Klay Agency UAE</h3>
          </header>

          <address class="office-card__address">
            Klay Agency FZCO
            IFZA Business Park, Building A2
            Dubai Silicon Oasis
            Dubai, United Arab Emirates
          </address>

          <div class="office-card__divider"></div>

          <div class="office-card__contacts">
            <a href="tel:+971585806313" class="office-card__link">
              <svg width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
                <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/>
              </svg>
              <span>Mob: +971 58 580 6313</span>
            </a>
          </div>

          <div class="office-card__divider"></div>

          <div class="office-card__hours">
            <svg width="18" height="18" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="12" cy="12" r="10"></circle>
              <polyline points="12 6 12 12 16 14"></polyline>
            </svg>
            <div>
              <span class="office-card__hours-title">Working hours</span>
              <span class="office-card__hours-val">Monday — Saturday | 9:00 am — 6:00 pm</span>
            </div>
          </div>
        </article>

        <!-- India Office -->
        <article class="office-card">
          <header class="office-card__header">
            <div class="office-card__icon">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
                <path d="M10 12h4M10 8h4M14 21v-3a2 2 0 0 0-4 0v3M6 10H4a2 2 0 0 0-2 2v7a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2V9a2 2 0 0 0-2-2h-2M6 21V5a2 2 0 0 1 2-2h8a2 2 0 0 1 2 2v16"></path>
              </svg>
            </div>
            <h3 class="office-card__title">N3 Global Tech India</h3>
          </header>

          <address class="office-card__address">
            N3 Global Tech LLP
            Kannur, Kerala
            India
          </address>

          <div class="office-card__divider"></div>

          <div class="office-card__contacts">
            <a href="tel:+919188374340" class="office-card__link">
              <svg width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
                <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/>
              </svg>
              <span>Mob: +91 91883 74340</span>
            </a>
          </div>

          <div class="office-card__divider"></div>

          <div class="office-card__hours">
            <svg width="18" height="18" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="12" cy="12" r="10"></circle>
              <polyline points="12 6 12 12 16 14"></polyline>
            </svg>
            <div>
              <span class="office-card__hours-title">Working hours</span>
              <span class="office-card__hours-val">Monday — Saturday | 9:00 am — 7:30 pm</span>
            </div>
          </div>
        </article>
      </div>
    </div>
  </section>

  <!-- FAQ Section -->
  <FaqSection />

  <Footer />
</Layout>

<style>
  .page-hero {
    padding: calc(72px + 5rem) 0 5rem;
    background: var(--white);
    text-align: center;
    position: relative;
    overflow: hidden;
  }
  .page-hero__bg-dots {
    position: absolute;
    inset: 0;
    background-image: radial-gradient(circle, var(--sky-200) 1px, transparent 1px);
    background-size: 36px 36px;
    opacity: 0.25;
    pointer-events: none;
  }
  .page-hero__glow {
    position: absolute;
    width: 800px;
    height: 400px;
    background: radial-gradient(ellipse, rgba(14,165,233,0.12) 0%, transparent 70%);
    top: 0;
    left: 50%;
    transform: translateX(-50%);
    pointer-events: none;
  }
  .page-hero__inner { position: relative; z-index: 2; }
  .page-hero__inner .badge { margin-bottom: 1.25rem; }
  .page-hero__title {
    font-family: var(--font-sans);
    font-size: var(--display-lg);
    font-weight: 500;
    line-height: 0.95;
    letter-spacing: -0.04em;
    margin-bottom: 1.5rem;
  }
  .page-hero__desc {
    font-family: var(--font-sans);
    color: var(--text-secondary);
    font-size: var(--body-md);
    line-height: 1.7;
    max-width: 640px;
    margin: 0 auto;
  }
  .page-hero__desc a {
    color: var(--sky-700);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  /* Contact layout */
  .contact-grid {
    display: grid;
    grid-template-columns: 1fr 1.5fr;
    gap: 5rem;
    align-items: start;
  }

  /* Info side */
  .contact-info h2 {
    font-family: var(--font-sans);
    font-size: var(--heading-md);
    font-weight: 500;
    letter-spacing: -0.03em;
    margin-bottom: 1rem;
  }

  .contact-info__desc {
    font-family: var(--font-sans);
    color: var(--text-secondary);
    line-height: 1.7;
    margin-bottom: 2rem;
    font-size: var(--body-md);
  }

  .contact-details {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    margin-bottom: 2.5rem;
  }

  .contact-detail {
    display: flex;
    gap: 1rem;
    align-items: flex-start;
  }

  .contact-detail__icon {
    width: 44px;
    height: 44px;
    min-width: 44px;
    border-radius: var(--radius-md);
    background: var(--sky-50);
    border: 1px solid var(--sky-100);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .contact-detail__label {
    font-family: var(--font-sans);
    font-size: var(--label-sm);
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--gray-400);
    margin-bottom: 0.25rem;
  }

  .contact-detail__value {
    font-family: var(--font-sans);
    font-size: var(--body-sm);
    color: var(--gray-700);
    font-weight: 500;
    line-height: 1.55;
    transition: color 0.2s;
    font-style: normal;
    margin: 0;
  }

  a.contact-detail__value:hover { color: var(--primary); }




  /* Form */
  .contact-form-wrap {
    background: var(--white);
    border-radius: var(--radius-xl);
    border: 1.5px solid var(--gray-100);
    box-shadow: var(--shadow-xl);
    padding: 2.5rem;
  }

  .contact-form {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .form-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.25rem;
  }

  .form-group {
    display: flex;
    flex-direction: column;
    gap: 0.45rem;
  }

  .form-group label {
    font-family: var(--font-sans);
    font-size: var(--body-sm);
    font-weight: 500;
    color: var(--gray-700);
  }

  .req { color: var(--sky-700); }

  .form-group input,
  .form-group select,
  .form-group textarea {
    padding: 0.75rem 1rem;
    border: 1.5px solid var(--gray-200);
    border-radius: var(--radius-md);
    font-family: var(--font-sans);
    font-size: var(--body-sm);
    color: var(--gray-800);
    background: var(--white);
    transition: border-color 0.2s, box-shadow 0.2s;
    outline: none;
    width: 100%;
    resize: vertical;
  }

  .form-group input::placeholder,
  .form-group textarea::placeholder { color: var(--gray-300); }

  .form-group input:focus,
  .form-group select:focus,
  .form-group textarea:focus {
    border-color: var(--primary);
    box-shadow: 0 0 0 3px rgba(14,165,233,0.12);
  }

  .form-group--checkbox {
    flex-direction: row;
    align-items: center;
  }

  .checkbox-label {
    display: flex;
    align-items: flex-start;
    gap: 0.75rem;
    cursor: pointer;
    font-size: 0.875rem !important;
    font-weight: 400 !important;
    color: var(--gray-600) !important;
  }

  .checkbox-label input[type="checkbox"] {
    width: 18px;
    height: 18px;
    min-width: 18px;
    accent-color: var(--primary);
    margin-top: 1px;
    cursor: pointer;
  }

  .btn-submit {
    width: 100%;
    justify-content: center;
    padding: 0.875rem 1.75rem !important;
    font-family: var(--font-sans);
    font-size: 0.9375rem !important;
    font-weight: 500 !important;
    gap: 0.6rem;
  }

  .btn-submit:disabled {
    opacity: 0.6;
    cursor: not-allowed;
    transform: none !important;
  }

  .form-note {
    text-align: center;
    font-family: var(--font-sans);
    font-size: var(--body-sm);
    color: var(--gray-400);
    margin-top: -0.5rem;
  }

  .form-success {
    display: none;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 0.75rem;
    padding: 2rem;
    background: var(--sky-50);
    border-radius: var(--radius-lg);
    border: 1px solid var(--sky-100);
  }

  .form-success h3 {
    font-family: var(--font-sans);
    font-size: var(--heading-sm);
    font-weight: 500;
    color: var(--gray-900);
  }

  .form-success p {
    font-family: var(--font-sans);
    color: var(--text-secondary);
    font-size: var(--body-sm);
    line-height: 1.7;
  }

  .form-success.visible {
    display: flex;
  }

  /* Honeypot — visually hidden but accessible */
  .hp-field {
    position: absolute;
    left: -9999px;
    top: auto;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }

  /* Error message */
  .form-error {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    padding: 0.85rem 1rem;
    background: #fef2f2;
    border: 1px solid #fecaca;
    border-radius: var(--radius-md);
    color: #b91c1c;
    font-family: var(--font-sans);
    font-size: var(--body-sm);
    line-height: 1.5;
  }
  .form-error[hidden] {
    display: none;
  }
  .form-error svg {
    flex-shrink: 0;
  }



  @media (max-width: 500px) {
    .form-row { grid-template-columns: 1fr; }
    .contact-form-wrap { padding: 1.75rem; }
  }
  /* Regional Offices */
  .regional-offices-section {
    padding-top: 2rem;
    padding-bottom: 6rem;
  }

  .section-header.text-center {
    text-align: center;
    max-width: 680px;
    margin: 0 auto 3.5rem;
  }

  .section-header.text-center .badge {
    margin-bottom: 1rem;
  }

  .section-header.text-center h2 {
    font-family: var(--font-sans);
    font-size: var(--heading-md);
    font-weight: 500;
    letter-spacing: -0.03em;
    color: var(--gray-900);
    margin-bottom: 1rem;
  }

  .section-desc {
    font-family: var(--font-sans);
    font-size: var(--body-md);
    color: var(--text-secondary);
    line-height: 1.65;
    margin: 0;
  }

  .offices-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(2rem, 4vw, 3rem);
    max-width: 960px;
