---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import FaqSection from '../components/FaqSection.astro';
---

<Layout
  title="Contact Klay Agency"
  description="Partner with Klay to design, build, and scale digital solutions that drive growth, improve efficiency, and create lasting business value."
  keywords="contact Klay Agency, digital transformation consultation, website development quote, custom software Dubai, AI automation UAE, cloud solutions GCC"
>
  <Navbar />

  <!-- Page Hero -->
  <section class="page-hero">
    <div class="page-hero__glow"></div>
    <div class="page-hero__bg-dots"></div>
    <div class="container page-hero__inner">
      <div class="badge badge-sky">Contact Us</div>
      <h1 class="page-hero__title">
        Transform Your Ideas Into Digital Reality
      </h1>
      <p class="page-hero__desc">
        Partner with Klay to design, build, and scale digital solutions that drive growth.
      </p>
    </div>
  </section>

  <!-- Contact section -->
  <section class="section contact-section">
    <div class="container">
      <div class="contact-grid">

        <!-- Left Column: Form Card -->
        <div class="contact-form-card">
          <div class="contact-form-card__header">
            <h2 class="contact-form-card__title">Send Us a Message</h2>
            <p class="contact-form-card__subtitle">
              Fill in the details below and our team will respond within 24 hours.
            </p>
          </div>

          <form class="contact-form" id="contact-form" novalidate>
            <div class="form-row">
              <div class="form-group">
                <label for="name">Full Name <span class="req">*</span></label>
                <input type="text" id="name" name="name" placeholder="John Smith" required />
              </div>
              <div class="form-group">
                <label for="company">Company / Organisation</label>
                <input type="text" id="company" name="company" placeholder="Acme Corp" />
              </div>
            </div>

            <div class="form-row">
              <div class="form-group">
                <label for="email">Email Address <span class="req">*</span></label>
                <input type="email" id="email" name="email" placeholder="you@company.com" required />
              </div>
              <div class="form-group">
                <label for="phone">Phone Number</label>
                <input type="tel" id="phone" name="phone" placeholder="+971 50 000 0000" />
              </div>
            </div>

            <div class="form-group">
              <label for="service">Area of Interest <span class="req">*</span></label>
              <div class="select-wrapper">
                <select id="service" name="service" required>
                  <option value="" disabled selected>— Select a solution —</option>
                  <option value="custom_software">Custom Software Development</option>
                  <option value="saas">SaaS Platform Engineering</option>
                  <option value="web">Modern Web Application</option>
                  <option value="mobile">Mobile App (iOS &amp; Android)</option>
                  <option value="ai_automation">AI &amp; Intelligent Automation</option>
                  <option value="cloud_infra">Cloud Infrastructure &amp; DevOps</option>
                  <option value="branding">UI/UX &amp; Brand Identity</option>
                  <option value="other">Other Inquiry</option>
                </select>
                <svg class="select-chevron" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="m6 9 6 6 6-6"></path>
                </svg>
              </div>
            </div>

            <div class="form-group">
              <label for="message">Message <span class="req">*</span></label>
              <textarea id="message" name="message" rows="5" placeholder="Briefly describe your project or enquiry..." required></textarea>
            </div>

            <!-- Honeypot: invisible to humans, bots tend to fill every field -->
            <div class="hp-field" aria-hidden="true">
              <label for="website">Website</label>
              <input type="text" id="website" name="website" tabindex="-1" autocomplete="off" />
            </div>

            <div class="form-actions">
              <button type="submit" class="contact-submit-btn" id="submit-btn">
                <span class="btn-submit__label">Send Message</span>
                <span class="contact-submit-btn__icon">
                  <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                    <line x1="7" y1="17" x2="17" y2="7"></line>
                    <polyline points="7 7 17 7 17 17"></polyline>
                  </svg>
                </span>
              </button>

              <span class="form-privacy-note">We respect your privacy. No spam, ever.</span>
            </div>

            <!-- Error message -->
            <div class="form-error" id="form-error" role="alert" hidden>
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
              <span id="form-error-text">Something went wrong. Please try again or email us at hello@klay.agency.</span>
            </div>

            <!-- Success message -->
            <div class="form-success" id="form-success" aria-live="polite">
              <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="var(--sky-500)" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
              <h3>Message Sent!</h3>
              <p>Thank you for reaching out. Our team will review your message and get back to you within 24 hours.</p>
            </div>
          </form>
        </div>

        <!-- Right Column: Sidebar Cards Stack -->
        <div class="contact-sidebar">

          <!-- Card 1: Schedule a Consultation -->
          <div class="consultation-card">
            <div class="consultation-card__inner">
              <div class="consultation-card__icon">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
                  <line x1="16" y1="2" x2="16" y2="6"></line>
                  <line x1="8" y1="2" x2="8" y2="6"></line>
                  <line x1="3" y1="10" x2="21" y2="10"></line>
                </svg>
              </div>
              <div class="consultation-card__content">
                <h3 class="consultation-card__title">Schedule a Consultation</h3>
                <p class="consultation-card__desc">
                  Book a free 30-minute discovery call with our tech strategists to discuss your project needs.
                </p>
                <a href="https://wa.me/971585806313?text=Hi%20Klay%20Agency%2C%20I%27d%20like%20to%20schedule%20a%20consultation." target="_blank" rel="noopener noreferrer" class="consultation-btn">
                  <span>Book a Call</span>
                  <span class="consultation-btn__circle">
                    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                      <line x1="7" y1="17" x2="17" y2="7"></line>
                      <polyline points="7 7 17 7 17 17"></polyline>
                    </svg>
                  </span>
                </a>
              </div>
            </div>
          </div>

          <!-- Card 2: Contact Information -->
          <div class="contact-info-card">
            <h3 class="contact-info-card__title">Contact Information</h3>

            <div class="contact-info-list">
              <!-- Headquarters -->
              <div class="contact-info-item">
                <div class="contact-info-item__icon">
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path>
                    <circle cx="12" cy="10" r="3"></circle>
                  </svg>
                </div>
                <div class="contact-info-item__body">
                  <div class="contact-info-item__label">GLOBAL OPERATIONS — UAE</div>
                  <div class="contact-info-item__val">
                    IFZA Business Park, Building A2, Dubai Silicon Oasis, Dubai, UAE
                  </div>
                </div>
              </div>

              <!-- Email -->
              <div class="contact-info-item">
                <div class="contact-info-item__icon">
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <rect width="20" height="16" x="2" y="4" rx="2"></rect>
                    <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"></path>
                  </svg>
                </div>
                <div class="contact-info-item__body">
                  <div class="contact-info-item__label">EMAIL ADDRESS</div>
                  <a href="mailto:hello@klay.agency" class="contact-info-item__val contact-info-item__link">
                    hello@klay.agency
                  </a>
                </div>
              </div>

              <!-- Phone -->
              <div class="contact-info-item">
                <div class="contact-info-item__icon">
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path>
                  </svg>
                </div>
                <div class="contact-info-item__body">
                  <div class="contact-info-item__label">PHONE NUMBER</div>
                  <div class="contact-info-item__val">
                    <a href="tel:+971585806313" class="contact-info-item__link">Mob: +971 58 580 6313</a>
                  </div>
                </div>
              </div>

              <!-- Hours -->
              <div class="contact-info-item">
                <div class="contact-info-item__icon">
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <circle cx="12" cy="12" r="10"></circle>
                    <polyline points="12 6 12 12 16 14"></polyline>
                  </svg>
                </div>
                <div class="contact-info-item__body">
                  <div class="contact-info-item__label">BUSINESS HOURS</div>
                  <div class="contact-info-item__val">
                    Monday — Saturday | 9:00 am — 6:00 pm
                  </div>
                </div>
              </div>

              <!-- Global Presence -->
              <div class="contact-info-item">
                <div class="contact-info-item__icon">
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <circle cx="12" cy="12" r="10"></circle>
                    <line x1="2" y1="12" x2="22" y2="12"></line>
                    <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1 4-10z"></path>
                  </svg>
                </div>
                <div class="contact-info-item__body">
                  <div class="contact-info-item__label">GLOBAL PRESENCE</div>
                  <div class="contact-info-item__val">
                    UAE &amp; India | Operations across the GCC &amp; beyond
                  </div>
                </div>
              </div>
            </div>
          </div>

        </div>
      </div>
    </div>
  </section>
      </div>
    </div>
  </section>


  <!-- Regional Offices / Global Presence -->
  <section class="section regional-offices-section">
    <div class="container">
      <div class="section-header text-center">
        <div class="badge badge-sky">GLOBAL PRESENCE</div>
        <h2>Regional <span class="text-gradient">Offices</span></h2>
        <p class="section-desc">
          Klay operates across key markets in the GCC and beyond — combining local presence with global technical expertise.
        </p>
      </div>

      <div class="offices-grid">
        <!-- UAE Office -->
        <article class="office-card">
          <header class="office-card__header">
            <div class="office-card__icon">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
                <path d="M10 12h4M10 8h4M14 21v-3a2 2 0 0 0-4 0v3M6 10H4a2 2 0 0 0-2 2v7a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2V9a2 2 0 0 0-2-2h-2M6 21V5a2 2 0 0 1 2-2h8a2 2 0 0 1 2 2v16"></path>
              </svg>
            </div>
            <h3 class="office-card__title">Klay Agency UAE</h3>
          </header>

          <address class="office-card__address">
            Klay Agency FZCO
            IFZA Business Park, Building A2
            Dubai Silicon Oasis
            Dubai, United Arab Emirates
          </address>

          <div class="office-card__divider"></div>

          <div class="office-card__contacts">
            <a href="tel:+971585806313" class="office-card__link">
              <svg width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
                <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/>
              </svg>
              <span>Mob: +971 58 580 6313</span>
            </a>
          </div>

          <div class="office-card__divider"></div>

          <div class="office-card__hours">
            <svg width="18" height="18" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="12" cy="12" r="10"></circle>
              <polyline points="12 6 12 12 16 14"></polyline>
            </svg>
            <div>
              <span class="office-card__hours-title">Working hours</span>
              <span class="office-card__hours-val">Monday — Saturday | 9:00 am — 6:00 pm</span>
            </div>
          </div>
        </article>

        <!-- India Office -->
        <article class="office-card">
          <header class="office-card__header">
            <div class="office-card__icon">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
                <path d="M10 12h4M10 8h4M14 21v-3a2 2 0 0 0-4 0v3M6 10H4a2 2 0 0 0-2 2v7a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2V9a2 2 0 0 0-2-2h-2M6 21V5a2 2 0 0 1 2-2h8a2 2 0 0 1 2 2v16"></path>
              </svg>
            </div>
            <h3 class="office-card__title">N3 Global Tech India</h3>
          </header>

          <address class="office-card__address">
            N3 Global Tech LLP
            Kannur, Kerala
            India
          </address>

          <div class="office-card__divider"></div>

          <div class="office-card__contacts">
            <a href="tel:+919188374340" class="office-card__link">
              <svg width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
                <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/>
              </svg>
              <span>Mob: +91 91883 74340</span>
            </a>
          </div>

          <div class="office-card__divider"></div>

          <div class="office-card__hours">
            <svg width="18" height="18" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="12" cy="12" r="10"></circle>
              <polyline points="12 6 12 12 16 14"></polyline>
            </svg>
            <div>
              <span class="office-card__hours-title">Working hours</span>
              <span class="office-card__hours-val">Monday — Saturday | 9:00 am — 7:30 pm</span>
            </div>
          </div>
        </article>
      </div>
    </div>
  </section>

  <!-- FAQ Section -->
  <FaqSection />

  <Footer />
</Layout>

<style>
  .page-hero {
    padding: calc(72px + 5rem) 0 5rem;
    background: var(--white);
    text-align: center;
    position: relative;
    overflow: hidden;
  }
  .page-hero__bg-dots {
    position: absolute;
    inset: 0;
    background-image: radial-gradient(circle, var(--sky-200) 1px, transparent 1px);
    background-size: 36px 36px;
    opacity: 0.25;
    pointer-events: none;
  }
  .page-hero__glow {
    position: absolute;
    width: 800px;
    height: 400px;
    background: radial-gradient(ellipse, rgba(14,165,233,0.12) 0%, transparent 70%);
    top: 0;
    left: 50%;
    transform: translateX(-50%);
    pointer-events: none;
  }
  .page-hero__inner { position: relative; z-index: 2; }
  .page-hero__inner .badge { margin-bottom: 1.25rem; }
  .page-hero__title {
    font-family: var(--font-sans);
    font-size: var(--display-lg);
    font-weight: 500;
    line-height: 0.95;
    letter-spacing: -0.04em;
    margin-bottom: 1.5rem;
  }
  .page-hero__desc {
    font-family: var(--font-sans);
    color: var(--text-secondary);
    font-size: var(--body-md);
    line-height: 1.7;
    max-width: 640px;
    margin: 0 auto;
  }
  .page-hero__desc a {
    color: var(--sky-700);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  /* Contact Layout */
  .contact-section {
    padding: 3rem 0 5rem;
    background: #ffffff;
  }

  .contact-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.28fr) minmax(0, 1fr);
    gap: clamp(2rem, 3.5vw, 3.25rem);
    align-items: start;
  }

  /* Left Column: Form Card */
  .contact-form-card {
    background: var(--white);
    border-radius: var(--radius-xl);
    border: 1.5px solid var(--gray-100);
    box-shadow: 0 4px 24px -4px rgba(0, 0, 0, 0.05);
    padding: clamp(1.75rem, 3.5vw, 2.75rem);
  }

  .contact-form-card__header {
    margin-bottom: 2rem;
  }

  .contact-form-card__title {
    font-family: var(--font-sans);
    font-size: clamp(1.5rem, 2.2vw, 1.85rem);
    font-weight: 600;
    color: #003B64;
    letter-spacing: -0.025em;
    margin-bottom: 0.5rem;
  }

  .contact-form-card__subtitle {
    font-family: var(--font-sans);
    font-size: var(--body-sm);
    color: var(--text-secondary);
    line-height: 1.6;
    margin: 0;
  }

  .contact-form {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .form-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.25rem;
  }

  .form-group {
    display: flex;
    flex-direction: column;
    gap: 0.45rem;
  }

  .form-group label {
    font-family: var(--font-sans);
    font-size: 0.8125rem;
    font-weight: 500;
    color: var(--gray-700);
  }

  .req { color: var(--sky-700); }

  .form-group input,
  .form-group select,
  .form-group textarea {
    padding: 0.8rem 1rem;
    border: 1.5px solid var(--gray-200);
    border-radius: var(--radius-md);
    font-family: var(--font-sans);
    font-size: var(--body-sm);
    color: var(--gray-800);
    background: var(--white);
    transition: border-color 0.2s, box-shadow 0.2s;
    outline: none;
    width: 100%;
  }

  .form-group textarea {
    resize: vertical;
    min-height: 120px;
  }

  .form-group input::placeholder,
  .form-group textarea::placeholder {
    color: var(--gray-300);
  }

  .form-group input:focus,
  .form-group select:focus,
  .form-group textarea:focus {
    border-color: #003B64;
    box-shadow: 0 0 0 3px rgba(0, 59, 100, 0.1);
  }

  /* Custom Select Wrapper */
  .select-wrapper {
    position: relative;
    width: 100%;
  }

  .select-wrapper select {
    appearance: none;
    -webkit-appearance: none;
    -moz-appearance: none;
    padding-right: 2.5rem;
    cursor: pointer;
  }

  .select-chevron {
    position: absolute;
    right: 1rem;
    top: 50%;
    transform: translateY(-50%);
    pointer-events: none;
    color: var(--gray-400);
    transition: color 0.2s;
  }

  .select-wrapper:hover .select-chevron {
    color: #003B64;
  }

  /* Form Actions & Submit Button */
  .form-actions {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 1rem;
    margin-top: 0.5rem;
  }

  .contact-submit-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.85rem;
    background: #003B64;
    color: #ffffff;
    border: none;
    border-radius: 9999px;
    padding: 0.8rem 1.65rem;
    font-family: var(--font-sans);
    font-size: 0.9375rem;
    font-weight: 500;
    cursor: pointer;
    transition: all 0.25s ease;
    box-shadow: 0 4px 14px rgba(0, 59, 100, 0.2);
  }

  .contact-submit-btn:hover {
    background: #002642;
    transform: translateY(-2px);
    box-shadow: 0 6px 20px rgba(0, 59, 100, 0.3);
  }

  .contact-submit-btn:disabled {
    opacity: 0.6;
    cursor: not-allowed;
    transform: none !important;
  }

  .contact-submit-btn__icon {
    width: 26px;
    height: 26px;
    border-radius: 50%;
    background: #ffffff;
    color: #003B64;
    display: grid;
    place-items: center;
    transition: transform 0.25s ease;
  }

  .contact-submit-btn:hover .contact-submit-btn__icon {
    transform: translate(2px, -2px);
  }

  .form-privacy-note {
    font-family: var(--font-sans);
    font-size: 0.8125rem;
    color: var(--gray-400);
  }

  /* Right Column: Sidebar Stack */
  .contact-sidebar {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  /* Card 1: Consultation Card */
  .consultation-card {
    background: linear-gradient(135deg, #021a2f 0%, #003B64 100%);
    border-radius: var(--radius-xl);
    padding: clamp(1.75rem, 3vw, 2.25rem);
    color: #ffffff;
    border: 1px solid rgba(255, 255, 255, 0.08);
    box-shadow: 0 10px 25px -5px rgba(0, 59, 100, 0.25);
    position: relative;
    overflow: hidden;
  }

  .consultation-card__inner {
    display: flex;
    align-items: flex-start;
    gap: 1.25rem;
  }

  .consultation-card__icon {
    width: 48px;
    height: 48px;
