    font-family: var(--font-sans);
  }

  .about-stat-card__label {
    font-size: 0.88rem;
    color: #64748b;
    font-weight: 400;
  }

  /* STORY SECTION */
  .story-section {
    padding: 5rem 0;
    background: #ffffff;
  }

  .story-section__container {
    max-width: 1200px;
    padding: 0 1.5rem;
    margin: 0 auto;
  }

