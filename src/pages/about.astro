    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 1.5rem;
  }

  .story-section__title {
    font-size: clamp(2rem, 3.2vw, 2.75rem);
    font-weight: 400;
    color: #0f172a;
    font-family: var(--font-sans);
    margin: 0;
  }

  .story-section__kicker {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.82rem;
