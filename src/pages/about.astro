---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';

import ClientLogosMarquee from '../components/ClientLogosMarquee.astro';
import TeamSection from '../components/TeamSection.astro';

const founders = [
  {
    name: "Mohammed Rafeel",
    role: "Founder &amp; Digital Transformation Lead",
    bio: "Leads Klay's vision, client partnerships, and digital transformation initiatives.",
    initials: "M",
    color: "sky",
    image: "/team/rafeel.webp",
  },
  {
    name: "Nibras",
    role: "Cloud Infrastructure Architect",
    bio: "Designs and oversees the cloud environments that power Klay's digital solutions.",
    initials: "N",
    color: "sky",
    image: "/team/nibras.webp",
  },
  {
    name: "Nabeel PP",
    role: "Technology Strategist &amp; Solutions Architect",
    bio: "Defines the technical architecture behind Klay's platforms and digital systems.",
    initials: "N",
    color: "violet",
    image: "/team/nabeel.webp",
  },
  {
    name: "Ashwal P",
    role: "AI &amp; Intelligent Systems Architect",
    bio: "Develops AI-powered solutions that enhance operational efficiency and digital experiences.",
    initials: "A",
    color: "teal",
    image: "/team/ashwal.webp",
  },
  {
    name: "Abdul Nafih",
    role: "Platform &amp; Integration Architect",
    bio: "Ensures digital solutions are delivered with reliability and precision.",
    initials: "A",
    color: "amber",
    image: "/team/nafih.webp",
  },
];
---

<Layout
  title="About Klay | Our Story, Team & Mission"
  description="Klay is a digital transformation agency helping businesses modernize their digital presence, streamline operations, and unlock new opportunities through technology."
  keywords="about Klay Agency, klay.agency, digital transformation agency, Dubai tech company, GCC technology partner, Klay team, cloud infrastructure, AI automation"
>
  <Navbar />

  <script type="application/ld+json" is:inline set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "AboutPage",
    "mainEntityOfPage": {
      "@type": "WebPage",
      "@id": "https://klay.agency/about/"
    },
    "name": "About Klay Agency",
    "description": "Klay is a digital transformation agency helping businesses modernize through strategy, technology, cloud infrastructure, and intelligent automation.",
    "publisher": {
      "@id": "https://klay.agency/#organization"
    }
  })}></script>

  <!-- Dedicated Unique About Hero -->
  <section class="about-hero-custom">
    <div class="container about-hero-custom__container">
      <div class="story-section__kicker">
        <span class="story-section__kicker-sq"></span> ABOUT KLAY
      </div>
      <h1 class="about-hero-custom__title">
        Building Digital Systems That Drive Business Growth
      </h1>
      <p class="about-hero-custom__subtitle">
        Klay is a digital transformation agency helping businesses modernize their digital presence, streamline operations, and unlock new opportunities through technology.
      </p>

      <div class="about-stats-grid">
        <div class="about-stat-card">
          <div class="about-stat-card__num">05</div>
          <div class="about-stat-card__label">Leadership &amp; Tech Team</div>
        </div>
        <div class="about-stat-card">
          <div class="about-stat-card__num">30+</div>
          <div class="about-stat-card__label">Active Business Partners</div>
        </div>
        <div class="about-stat-card">
          <div class="about-stat-card__num">03+</div>
          <div class="about-stat-card__label">Years Delivering Solutions</div>
        </div>
        <div class="about-stat-card">
          <div class="about-stat-card__num">02</div>
          <div class="about-stat-card__label">Global Hubs (India &amp; UAE)</div>
        </div>
      </div>
    </div>
  </section>

  <!-- Client Logos Marquee -->
  <ClientLogosMarquee />

  <!-- What We Do & Our Approach -->
  <section class="section story-section">
    <div class="container story-section__container">
      <div class="story-section__header">
        <div class="story-section__kicker">
          <span class="story-section__kicker-sq"></span> WHAT WE DO
        </div>
        <h2 class="story-section__title">We help businesses navigate digital change through strategy, technology, and innovation.</h2>
      </div>
      <div class="story-section__divider"></div>

      <div class="story-grid">
        <!-- Intro -->
        <article class="story-card story-card--full">
          <p class="story-card__text story-card__text--lead">
            We partner with ambitious organizations to bridge the gap between business strategy and technical execution. By combining digital strategy, software solutions, cloud infrastructure, and intelligent automation, we create systems that improve efficiency, strengthen customer experiences, and support long-term growth.
          </p>
          <p class="story-card__text">
            Whether you're launching a new venture, modernizing an existing business, or exploring AI-driven transformation, Klay helps turn ideas into scalable digital solutions.
          </p>
        </article>

        <!-- Approach Card 1 -->
        <article class="story-card">
          <div class="story-card__badge">01 / STRATEGY FIRST</div>
          <h3 class="story-card__title">Strategy First</h3>
          <p class="story-card__text">
            Every project begins with a clear understanding of <strong>business objectives and growth priorities</strong>. Technology is most effective when it serves a clear business purpose — so we start by understanding your organization, challenges, goals, and opportunities.
          </p>
        </article>

        <!-- Approach Card 2 -->
        <article class="story-card">
          <div class="story-card__badge">02 / SCALABLE SYSTEMS</div>
          <h3 class="story-card__title">Build for Scale</h3>
          <p class="story-card__text">
            We create <strong>digital systems designed to evolve alongside your business</strong>. Every solution we deliver is built on modern architecture that supports growth, adapts to change, and creates measurable business value — not just technical functionality.
          </p>
        </article>

        <!-- Approach Card 3 -->
        <article class="story-card story-card--full">
          <div class="story-card__badge">03 / INTELLIGENT INNOVATION</div>
          <h3 class="story-card__title">Intelligent Innovation</h3>
          <p class="story-card__text story-card__text--lead">
            We leverage <strong>cloud technologies, automation, and AI</strong> where they create meaningful impact. Our capabilities span:
          </p>

          <div class="experience-grid">
            <div class="experience-pill">
              <div class="experience-pill__header">
                <span class="experience-pill__name">Digital Transformation</span>
              </div>
              <p class="experience-pill__desc">Strategy, website design &amp; development, and business process digitization.</p>
            </div>

            <div class="experience-pill">
              <div class="experience-pill__header">
                <span class="experience-pill__name">Software &amp; Cloud</span>
              </div>
              <p class="experience-pill__desc">Custom software solutions, SaaS platforms, cloud infrastructure &amp; architecture.</p>
            </div>

            <div class="experience-pill">
              <div class="experience-pill__header">
                <span class="experience-pill__name">AI &amp; Automation</span>
              </div>
              <p class="experience-pill__desc">AI &amp; intelligent automation, platform modernization, and technology consulting.</p>
            </div>
          </div>
        </article>

        <!-- Global Impact Card -->
        <article class="story-card story-card--full story-card--highlight">
          <div class="story-card__flex-row">
            <div class="story-card__col">
              <div class="story-card__badge story-card__badge--sky">04 / LONG-TERM PARTNERSHIP</div>
              <h3 class="story-card__title">One Team. Global Perspective.</h3>
              <p class="story-card__text">
                We remain invested in our clients' success beyond deployment, supporting <strong>continuous growth and improvement</strong>. Klay has delivered multiple digital platforms and solutions — empowering over 30 companies to transition from manual workflows to robust digital infrastructure.
              </p>
            </div>
            <div class="story-card__col">
              <div class="dubai-badge">
                <span class="dubai-badge__dot"></span>
                Dubai Headquarters
              </div>
              <p class="story-card__text">
                Klay operates as the GCC-facing brand of N3 Global Tech, bringing together a multidisciplinary team across India and the UAE — delivering high-grade software solutions to clients across the wider GCC.
              </p>
            </div>
          </div>
        </article>
      </div>
    </div>
  </section>

  <!-- Creative Team Spotlight -->
  <TeamSection />

  <!-- Mission & Vision -->
  <section class="section mv-section">
    <div class="container mv-section__container">
      <div class="mv-section__header">
        <div class="story-section__kicker">
          <span class="story-section__kicker-sq"></span> OUR PURPOSE
        </div>
        <h2 class="mv-section__title">Mission &amp; Vision</h2>
      </div>
      <div class="story-section__divider"></div>

      <div class="mv-grid">
        <article class="mv-card">
          <div class="mv-card__icon mv-card__icon--mission">
            <svg width="26" height="26" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M4.5 16.5c-1.5 1.26-2 5-2 5s3.74-.5 5-2c.71-.84.7-2.13-.09-2.91a2.18 2.18 0 0 0-2.91-.09z"/>
              <path d="m12 15 3.3 3.3a1 1 0 0 0 1.4 0l2.6-2.6a1 1 0 0 0 0-1.4L16 11"/>
              <path d="m11 16-4.3-4.3a1 1 0 0 1 0-1.4l2.6-2.6a1 1 0 0 1 1.4 0L14 11"/>
              <path d="M15 4c-5-2-12 1-12 1s3 7 1 12l2.6 2.6c5 2 12-1 12-1s-3-7-1-12z"/>
            </svg>
          </div>
          <h3 class="mv-card__heading">Our Mission</h3>
          <p class="mv-card__desc">To help organizations harness technology more effectively through modern digital systems, intelligent automation, and innovative solutions that drive sustainable growth.</p>
        </article>

        <article class="mv-card">
          <div class="mv-card__icon mv-card__icon--vision">
            <svg width="26" height="26" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="12" cy="12" r="10"/>
              <circle cx="12" cy="12" r="6"/>
              <circle cx="12" cy="12" r="2"/>
            </svg>
          </div>
          <h3 class="mv-card__heading">Our Vision</h3>
          <p class="mv-card__desc">To become a trusted digital transformation partner across the GCC and beyond, helping businesses innovate, adapt, and thrive in an increasingly connected world.</p>
        </article>
      </div>
    </div>
  </section>

  <!-- Why Klay -->
  <section class="section mv-section">
    <div class="container mv-section__container">
      <div class="mv-section__header">
        <div class="story-section__kicker">
          <span class="story-section__kicker-sq"></span> WHY KLAY
        </div>
        <h2 class="mv-section__title">Businesses don't need more technology. They need better systems.</h2>
      </div>
      <div class="story-section__divider"></div>
      <p class="story-card__text" style="max-width: 780px; font-size: 1.05rem; line-height: 1.7; color: #475569;">
        Klay helps organizations connect strategy, technology, and execution to build digital foundations that improve efficiency, enhance customer experiences, and support long-term growth. Our focus is on delivering outcomes, creating value, and building lasting partnerships.
      </p>
    </div>
  </section>

  <!-- High-End Glassmorphic CTA -->
  <section class="section about-cta-section">
    <div class="container">
      <div class="about-cta">
        <div class="about-cta__glow"></div>
        <h2 class="about-cta__title">Ready to Build What's Next?</h2>
        <p class="about-cta__desc">Whether you're launching a new venture, modernizing your digital presence, or exploring AI-driven transformation, Klay helps turn ambitious ideas into scalable digital systems. Let's start the conversation.</p>
        
        <div class="about-cta__actions">
          <a href="/contact/" class="hero__pill-link">
            <span class="hero__pill-text">Start a Project</span>
            <span class="hero__pill-icon">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                <line x1="7" y1="17" x2="17" y2="7"></line>
                <polyline points="7 7 17 7 17 17"></polyline>
              </svg>
            </span>
          </a>
          <a href="/work/" class="about-cta__secondary-btn">See Our Work</a>
        </div>
      </div>
    </div>
  </section>

  <script is:inline>
    (function() {
      function initAboutHeroScroll() {
        var statement = document.getElementById("about-hero-title");
        if (!statement) return;

        var text = statement.textContent.trim();
        var words = text.split(/\s+/);
        statement.innerHTML = words.map(function(w) {
          return '<span class="about-word">' + w + ' </span>';
        }).join('');

        var wordSpans = statement.querySelectorAll(".about-word");
        var heroSection = statement.closest(".about-hero");

        function updateProgress() {
          if (!heroSection || !wordSpans.length) return;
          var rect = heroSection.getBoundingClientRect();
          var windowH = window.innerHeight;
          
          var start = windowH * 0.85;
          var end = windowH * 0.35;
          var progress = (start - rect.top) / (start - end);
          progress = Math.max(0, Math.min(1, progress));

          var activeIndex = Math.floor(progress * wordSpans.length);
          wordSpans.forEach(function(span, idx) {
            if (idx <= activeIndex) {
              span.classList.add("is-active");
            } else {
              span.classList.remove("is-active");
            }
          });
        }

        window.addEventListener("scroll", updateProgress, { passive: true });
        updateProgress();
      }

      if (document.readyState === "loading") {
        document.addEventListener("DOMContentLoaded", initAboutHeroScroll);
      } else {
        initAboutHeroScroll();
      }
    })();
  </script>

  <Footer />
</Layout>

<style>
  /* DEDICATED ABOUT HERO */
  .about-hero-custom {
    padding-top: calc(80px + 4rem);
    padding-bottom: 4rem;
    background: #ffffff;
  }

  .about-hero-custom__container {
    max-width: 1200px;
    padding: 0 1.5rem;
    margin: 0 auto;
  }

  .about-hero-custom__title {
    font-size: clamp(2.2rem, 3.8vw, 3.25rem);
    font-weight: 400;
    color: #0f172a;
    font-family: var(--font-sans);
    line-height: 1.25;
    letter-spacing: -0.02em;
    margin: 1.25rem 0 1rem;
    max-width: 980px;
  }

  .about-hero-custom__subtitle {
    font-size: 1.15rem;
    line-height: 1.65;
    color: #475569;
    max-width: 820px;
    margin-bottom: 3.5rem;
  }

  .about-stats-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1.5rem;
    padding-top: 2rem;
    border-top: 1px solid #e2e8f0;
  }

  .about-stat-card {
