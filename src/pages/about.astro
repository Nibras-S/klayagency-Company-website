  }

  .story-section__divider {
    width: 100%;
    height: 1px;
    background: #e2e8f0;
    margin-bottom: 3rem;
  }

  .story-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 2rem;
  }

  .story-card {
    background: #f8fafc;
    border: 1px solid #f1f5f9;
    border-radius: 20px;
    padding: 2.5rem;
    display: flex;
    flex-direction: column;
    gap: 1rem;
    transition: transform 0.3s ease, box-shadow 0.3s ease, border-color 0.3s ease;
  }

  .story-card:hover {
    transform: translateY(-3px);
    box-shadow: 0 12px 32px rgba(15, 23, 42, 0.04);
    border-color: #e2e8f0;
  }

  .story-card--full {
    grid-column: 1 / -1;
  }

  .story-card--highlight {
    background: linear-gradient(135deg, #f8fafc 0%, #f0f9ff 100%);
    border-color: #e0f2fe;
  }

  .story-card__badge {
    font-size: 0.72rem;
    font-weight: 500;
    letter-spacing: 0.12em;
    color: #64748b;
    text-transform: uppercase;
  }

  .story-card__badge--sky {
    color: #0284c7;
  }

  .story-card__title {
    font-size: 1.5rem;
    font-weight: 450;
    color: #0f172a;
    font-family: var(--font-sans);
