---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import PrinciplesSection from '../components/PrinciplesSection.astro';

const founders = [
  {
    name: "Nibras",
    role: "Founder &amp; CEO",
    bio: "Cloud and DevOps engineer with industry experience in Abu Dhabi. Drives infrastructure, scalability, and deployment strategy.",
    initials: "N",
    color: "sky",
    image: "/team/nibras.webp",
  },
  {
    name: "Nabeel",
    role: "Co-founder &amp; CTO",
    bio: "Mobile developer who began his career in Kochi. Leads native iOS, Android, and cross-platform work across our products.",
    initials: "N",
    color: "violet",
    image: "/team/nabeel.webp",
  },
  {
    name: "Nafi",
    role: "Co-founder",
    bio: "Java developer with hands-on experience in Wayanad. Anchors backend architecture, APIs, and integrations.",
    initials: "N",
    color: "teal",
    image: "/team/nafi.webp",
  },
  {
    name: "Farseen",
    role: "Co-founder",
    bio: "Our earliest mentor. Guided us from first projects to industry practice, and still shapes how we build today.",
    initials: "F",
    color: "amber",
    image: "/team/farseen.webp",
  },
];

const foundersWithPhotos = founders;

const stats = [
  { value: "4", label: "Co-founders" },
  { value: "30+", label: "Companies Served" },
  { value: "3+", label: "Years in Production" }
];
---

<Layout
  title="About Us | Our Story, Founders & Mission"
  description="Meet the team behind N3 Global Tech. Founded by Nibras, Nabeel, Nafi, and Farseen, four engineers turned co-founders building custom software and SaaS for businesses in Kerala, India, and beyond."
  keywords="about N3 Global Tech, n3globaltech, N3GlobalTech, software company Kerala, software company Kannur, custom software founders, N3 team, Nibras Nabeel Nafi Farseen, Kerala tech founders, software company story"
>
  <Navbar />

  <script type="application/ld+json" is:inline set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "AboutPage",
    "mainEntityOfPage": {
      "@type": "WebPage",
      "@id": "https://www.n3global.tech/about/"
    },
    "name": "About N3 Global Tech",
    "description": "Meet the team behind N3 Global Tech. Four engineers turned founders building custom software and SaaS for businesses worldwide.",
    "publisher": {
      "@id": "https://www.n3global.tech/#organization"
    }
  })}></script>

  <section class="page-hero">
    <div class="page-hero__glow"></div>
    <div class="page-hero__bg-dots"></div>
    <div class="container page-hero__inner">
      <div class="badge badge-sky">About Us</div>
      <h1 class="page-hero__title">
        From Classmates to <span class="text-gradient">Co-founders</span>
      </h1>
      <p class="page-hero__desc">
        N3 Global Tech was built on a simple idea: that the right team, building practical software, can change how a business operates. Four engineers who started as classmates — this is how we got here.
      </p>
    </div>
  </section>

  <!-- Stats strip -->
  <section class="stats-strip">
    <div class="container">
      <div class="stats-grid">
        {stats.map(s => (
          <div class="stat-item">
            <div class="stat-item__value">{s.value}</div>
            <div class="stat-item__label">{s.label}</div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Origin story -->
  <section class="section about-section">
    <div class="container content-narrow">

      <h2>Where it began</h2>
      <p>
        Our story starts at <strong>Thalassery Engineering College</strong>, where the four of us — Nibras, Nabeel, Nafi, and Farseen — studied together. What began as a shared interest in solving real problems through technology grew, project by project, into something bigger.
      </p>
      <p>
        Across our third-year mini projects and final-year build, we got hands-on with the kind of work that doesn't show up in a textbook: shipping software that real people actually rely on. Farseen played a defining role here, both as a peer and a mentor, shaping how we approach problems to this day.
      </p>

      <h2>Our first client</h2>
      <p>
        Our first real opportunity came in our final year: a <strong>perfume e-commerce platform for a client in the UAE</strong>. It was the moment we stopped being students with a project and became a team with a customer.
      </p>
      <p>
        Soon after came our first product: a <strong>fitness management system for gym owners</strong> — member management, payments, automated reminders, daily operations. That platform is still in active use more than two years on, with regular updates and new features as the client's needs evolve.
      </p>

      <h2>Real-world experience, before we came back together</h2>
      <p>
        After graduation, each of us went a different direction to build real industry experience:
      </p>
      <ul class="content-list">
        <li><strong>Nabeel</strong> — Mobile Developer, Kochi — native and cross-platform apps for production users.</li>
        <li><strong>Nafi</strong> — Java Developer, Wayanad — backend systems and enterprise integrations.</li>
        <li><strong>Nibras</strong> — Cloud &amp; DevOps Engineer, Abu Dhabi — infrastructure for global-scale applications.</li>
      </ul>
      <p>
        Different paths, one shared plan: get real experience first, then come back and build something of our own.
      </p>

      <h2>Today</h2>
      <p>
        We reunited and founded N3 Global Tech. Since then we've shipped multiple products — <strong>N3 FitBook, N3 ServiceBook, and N3 BusinessBook</strong> — and we're actively building new platforms for everyday operational problems businesses actually have.
      </p>
      <p>
        We've supported <strong>more than 30 companies</strong> so far, helping them adopt modern technology and move from manual, traditional processes to systems that actually hold up.
      </p>

      <h2>Building for the GCC</h2>
      <p>
        That first UAE client wasn't a one-off. Today, N3 Global Tech is also the engineering and delivery arm behind <strong>Klay Agency</strong>, our Dubai-based studio — same team, same standard, serving clients across the UAE and wider GCC alongside our work in India.
      </p>

    </div>
  </section>

  <!-- Founders -->
  <section class="section founders-section">
    <div class="container">
      <div class="section-header">
        <div class="badge badge-sky">The Team</div>
        <h2>Meet the <span class="text-gradient">Co-founders</span></h2>
        <p>Four engineers who grew up building together, and never stopped.</p>
      </div>

      <div class="founders-grid">
        {foundersWithPhotos.map(f => (
          <article class={`founder-card founder-card--${f.color}`}>
            {f.image ? (
              <div class={`founder-card__photo-wrap founder-card__photo-wrap--${f.color}`}>
                <img src={f.image} alt={`${f.name}, ${f.role.replace(/&amp;/g, '&').replace(/<[^>]+>/g, '')}`} class="founder-card__photo" width="80" height="80" loading="lazy" />
              </div>
            ) : (
              <div class={`founder-card__avatar founder-card__avatar--${f.color}`} aria-hidden="true">
                {f.initials}
              </div>
            )}
            <h3 class="founder-card__name">{f.name}</h3>
            <p class="founder-card__role" set:html={f.role} />
            <p class="founder-card__bio">{f.bio}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- Mission & Vision -->
  <section class="section mv-section">
    <div class="container">
      <div class="section-header">
        <div class="badge badge-sky">Our Purpose</div>
        <h2>Mission &amp; <span class="text-gradient">Vision</span></h2>
      </div>

      <div class="mv-grid">
        <article class="mv-card">
          <div class="mv-card__icon mv-card__icon--mission">
            <svg width="28" height="28" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M4.5 16.5c-1.5 1.26-2 5-2 5s3.74-.5 5-2c.71-.84.7-2.13-.09-2.91a2.18 2.18 0 0 0-2.91-.09z"/>
              <path d="m12 15 3.3 3.3a1 1 0 0 0 1.4 0l2.6-2.6a1 1 0 0 0 0-1.4L16 11"/>
              <path d="m11 16-4.3-4.3a1 1 0 0 1 0-1.4l2.6-2.6a1 1 0 0 1 1.4 0L14 11"/>
              <path d="M15 4c-5-2-12 1-12 1s3 7 1 12l2.6 2.6c5 2 12-1 12-1s-3-7-1-12z"/>
            </svg>
          </div>
          <h3>Our Mission</h3>
          <p>To give businesses practical, scalable, user-focused digital solutions that solve real problems and drive sustainable growth.</p>
        </article>

        <article class="mv-card">
          <div class="mv-card__icon mv-card__icon--vision">
            <svg width="28" height="28" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="12" cy="12" r="10"/>
              <circle cx="12" cy="12" r="6"/>
              <circle cx="12" cy="12" r="2"/>
            </svg>
          </div>
          <h3>Our Vision</h3>
          <p>To become a trusted technology partner — building digital solutions that improve everyday operations and add up to a more connected, efficient way of working.</p>
        </article>
      </div>
    </div>
  </section>

  <!-- Three Ideas Behind Everything We Build -->
  <PrinciplesSection />

  <!-- Engineering Culture -->
  <section class="section culture-section">
    <div class="container content-narrow">
      <div class="section-header">
        <div class="badge badge-sky">How We Build</div>
        <h2><span class="text-gradient">How We Build</span></h2>
        <p>Software is only as good as the process and the people behind it. We don't just write code — we engineer systems built to last, and hold ourselves to real quality standards.</p>
      </div>
      
      <div class="culture-grid">
        <article class="culture-card">
          <h3>Pragmatic technology choices</h3>
          <p>No hype-driven development. We choose tools for the problem in front of us — React, Node.js, PostgreSQL — battle-tested technology that's easier to maintain for years, not just to demo.</p>
        </article>
        
        <article class="culture-card">
          <h3>Built for scale from day one</h3>
          <p>Whether it's a fast MVP or a complex enterprise SaaS platform, we architect for horizontal scale from the first commit: proper database indexing, caching, stateless API design.</p>
        </article>

        <article class="culture-card">
          <h3>Security by default</h3>
          <p>Role-based access control, secure authentication, automated security testing built into CI/CD — not bolted on after the fact.</p>
        </article>

        <article class="culture-card">
          <h3>Continuous delivery</h3>
          <p>Transparent, agile sprints. Automated testing and continuous integration mean features ship to staging weekly, so clients see progress and give feedback long before final release.</p>
        </article>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="section about-cta-section">
    <div class="container">
      <div class="about-cta">
        <h2>Want to work with us?</h2>
        <p>Whether you have a project in mind or just want to talk through what's possible, tell us where things stand — we'll respond within 24 hours.</p>
        <div class="about-cta__actions">
          <a href="/contact/" class="btn btn-primary btn-xl">Start a Project</a>
          <a href="/work/" class="btn btn-ghost btn-xl">See Our Work</a>
        </div>
      </div>
    </div>
  </section>

  <Footer />
</Layout>

<style>
  .page-hero {
    position: relative;
    padding: calc(80px + 4rem) 0 3rem;
    background: linear-gradient(180deg, #f8fafc 0%, #ffffff 100%);
    overflow: hidden;
  }
  .page-hero__glow {
    position: absolute;
    top: 0; left: 50%;
    transform: translateX(-50%);
    width: 800px; height: 400px;
    background: radial-gradient(ellipse, rgba(14,165,233,0.18) 0%, transparent 70%);
    pointer-events: none;
  }
  .page-hero__bg-dots {
    position: absolute;
    inset: 0;
    background-image: radial-gradient(circle, var(--sky-200) 1px, transparent 1px);
    background-size: 36px 36px;
    opacity: 0.2;
    pointer-events: none;
  }
  .page-hero__inner {
    position: relative;
    z-index: 2;
    text-align: center;
    max-width: 760px;
  }
  .page-hero__title {
    font-size: clamp(2.25rem, 5vw, 3.5rem);
    font-weight: 800;
    letter-spacing: -0.03em;
    line-height: 1.1;
    margin: 1rem 0 1.5rem;
  }
  .page-hero__desc {
    font-size: 1.1rem;
    color: var(--gray-600);
    line-height: 1.75;
    max-width: 640px;
    margin: 0 auto;
  }

  /* Stats strip */
  .stats-strip {
    padding: 0 0 3rem;
    background: linear-gradient(180deg, #ffffff 0%, #f8fafc 100%);
  }
  .stats-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1rem;
    max-width: 880px;
    margin: 0 auto;
    padding: 2.5rem;
    background: #ffffff;
    border: 1.5px solid var(--gray-100);
    border-radius: var(--radius-xl);
    box-shadow: 0 12px 32px rgba(14, 165, 233, 0.06);
  }
  .stat-item {
    text-align: center;
    border-right: 1px solid var(--gray-100);
  }
  .stat-item:last-child { border-right: none; }
  .stat-item__value {
    font-family: var(--font-heading);
    font-size: clamp(1.75rem, 3vw, 2.5rem);
    font-weight: 800;
    color: var(--sky-600);
    letter-spacing: -0.02em;
    line-height: 1;
    margin-bottom: 0.4rem;
  }
  .stat-item__label {
    font-size: 0.85rem;
    color: var(--gray-600);
    font-weight: 600;
  }

  /* About content */
  .about-section { padding-top: 4rem; padding-bottom: 4rem; }
  .content-narrow { max-width: 960px; }
  .content-narrow h2 {
    font-size: clamp(1.6rem, 3vw, 2rem);
    font-weight: 800;
    margin: 3rem 0 1rem;
    letter-spacing: -0.02em;
  }
  .content-narrow h2:first-child { margin-top: 0; }
  .content-narrow p {
    color: var(--gray-700);
    line-height: 1.85;
    margin-bottom: 1.2rem;
    font-size: 1.05rem;
  }
  .content-narrow p a {
    color: var(--sky-700);
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .content-list {
    margin: 1rem 0 1.5rem 1.5rem;
    color: var(--gray-700);
    line-height: 1.85;
  }
  .content-list li { margin-bottom: 0.85rem; }

  /* Founders */
  .founders-section {
    background: linear-gradient(180deg, #f8fafc 0%, #ffffff 100%);
    padding: 5rem 0;
  }
  .founders-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1.5rem;
    margin-top: 3rem;
  }
  .founder-card {
    background: #ffffff;
    border: 1.5px solid var(--gray-100);
    border-radius: var(--radius-xl);
    padding: 2rem 1.5rem;
    text-align: center;
    transition: var(--transition);
  }
  .founder-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 12px 32px rgba(14, 165, 233, 0.12);
  }
  .founder-card--sky:hover { border-color: var(--sky-300); }
  .founder-card--violet:hover { border-color: #ddd6fe; }
  .founder-card--teal:hover { border-color: #99f6e4; }
  .founder-card--amber:hover { border-color: #fde68a; }

  .founder-card__avatar {
    width: 72px;
    height: 72px;
    border-radius: 50%;
    margin: 0 auto 1rem;
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: var(--font-heading);
    font-size: 1.75rem;
    font-weight: 800;
    color: #ffffff;
  }
  .founder-card__avatar--sky    { background: linear-gradient(135deg, #38bdf8, #0284c7); }
  .founder-card__avatar--violet { background: linear-gradient(135deg, #a78bfa, #7c3aed); }
  .founder-card__avatar--teal   { background: linear-gradient(135deg, #2dd4bf, #0d9488); }
  .founder-card__avatar--amber  { background: linear-gradient(135deg, #fbbf24, #d97706); }

  /* Founder photo (when image present) */
  .founder-card__photo-wrap {
    width: 88px;
    height: 88px;
    border-radius: 50%;
    margin: 0 auto 1rem;
    padding: 3px;
    background: linear-gradient(135deg, #38bdf8, #0284c7);
  }
  .founder-card__photo-wrap--violet { background: linear-gradient(135deg, #a78bfa, #7c3aed); }
  .founder-card__photo-wrap--teal   { background: linear-gradient(135deg, #2dd4bf, #0d9488); }
  .founder-card__photo-wrap--amber  { background: linear-gradient(135deg, #fbbf24, #d97706); }
  .founder-card__photo {
    width: 100%;
    height: 100%;
    border-radius: 50%;
    object-fit: cover;
    display: block;
    background: #ffffff;
  }

  .founder-card__name {
    font-size: 1.2rem;
    font-weight: 800;
    margin-bottom: 0.25rem;
    letter-spacing: -0.02em;
    color: var(--gray-900);
  }
  .founder-card__role {
    font-size: 0.85rem;
    font-weight: 700;
    color: var(--sky-700);
    margin-bottom: 0.75rem;
    letter-spacing: 0.02em;
  }
  .founder-card__bio {
    font-size: 0.92rem;
    color: var(--gray-600);
    line-height: 1.65;
    margin: 0;
  }

  /* Mission & Vision */
  .mv-section { padding: 5rem 0; }
  .mv-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.5rem;
    margin-top: 2.5rem;
    max-width: 900px;
    margin-left: auto;
    margin-right: auto;
  }
  .mv-card {
    background: #ffffff;
    border: 1.5px solid var(--gray-100);
    border-radius: var(--radius-xl);
    padding: 2.25rem 2rem;
    transition: var(--transition);
  }
  .mv-card:hover {
    transform: translateY(-3px);
    box-shadow: 0 12px 32px rgba(14, 165, 233, 0.1);
    border-color: var(--sky-200);
  }
  .mv-card__icon {
    width: 56px;
    height: 56px;
    border-radius: var(--radius-md);
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 1.25rem;
  }
  .mv-card__icon--mission { background: var(--sky-50); color: var(--sky-600); }
  .mv-card__icon--vision  { background: #f5f3ff; color: #7c3aed; }
  .mv-card h3 {
    font-size: 1.35rem;
    font-weight: 800;
    margin-bottom: 0.85rem;
    letter-spacing: -0.02em;
    color: var(--gray-900);
  }
  .mv-card p {
    color: var(--gray-700);
    line-height: 1.75;
    margin: 0;
  }

  /* CTA */
  .about-cta-section { padding-top: 0; padding-bottom: 6rem; }
  .about-cta {
    background: linear-gradient(135deg, var(--gray-900), var(--sky-900));
    color: #ffffff;
    padding: 3.5rem 2.5rem;
    border-radius: 1.5rem;
    text-align: center;
    max-width: 880px;
    margin: 0 auto;
  }
  .about-cta h2 {
    color: #ffffff;
    margin: 0 0 1rem;
    font-size: clamp(1.6rem, 3vw, 2.25rem);
  }
  .about-cta p {
    color: rgba(255,255,255,0.75);
    max-width: 520px;
    margin: 0 auto 2rem;
    line-height: 1.7;
  }
  .about-cta__actions {
    display: flex;
    gap: 1rem;
    justify-content: center;
    flex-wrap: wrap;
  }
  .about-cta__actions .btn-ghost {
    background: rgba(255,255,255,0.08);
    color: #ffffff;
    border-color: rgba(255,255,255,0.2);
  }
  .about-cta__actions .btn-ghost:hover {
    background: rgba(255,255,255,0.15);
    color: #ffffff;
    border-color: rgba(255,255,255,0.4);
  }

  .btn-xl { padding: 1rem 2.5rem; font-size: 1.05rem; }

  /* Culture Section */
  .culture-section { background: linear-gradient(180deg, #ffffff 0%, #f8fafc 100%); padding-top: 5rem; padding-bottom: 5rem; }
  .culture-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 1.5rem; margin-top: 2rem; }
  .culture-card { background: #ffffff; padding: 2.25rem 2rem; border-radius: var(--radius-xl); border: 1.5px solid var(--gray-100); transition: var(--transition); }
  .culture-card:hover { transform: translateY(-3px); box-shadow: 0 12px 32px rgba(14, 165, 233, 0.1); border-color: var(--sky-200); }
  .culture-card h3 { font-size: 1.25rem; font-weight: 800; color: var(--gray-900); margin-bottom: 0.85rem; letter-spacing: -0.01em; }
  .culture-card p { color: var(--gray-600); line-height: 1.75; font-size: 0.95rem; margin: 0; }

  /* Responsive */
  @media (max-width: 900px) {
    .stats-grid { padding: 1.5rem; }
    .founders-grid { grid-template-columns: repeat(2, 1fr); }
    .mv-grid { grid-template-columns: 1fr; }
    .culture-grid { grid-template-columns: 1fr; }
  }
  @media (max-width: 600px) {
    .stats-grid { grid-template-columns: 1fr; gap: 1.5rem; }
    .stat-item { border-right: none; border-bottom: 1px solid var(--gray-100); padding-bottom: 1.5rem; }
    .stat-item:last-child { border-bottom: none; padding-bottom: 0; }
    .founders-grid { grid-template-columns: 1fr; }
  }
</style>
