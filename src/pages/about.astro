  .mv-section {
    padding: 5rem 0;
    background: #ffffff;
  }

  .mv-section__container {
    max-width: 1200px;
    padding: 0 1.5rem;
    margin: 0 auto;
  }

  .mv-section__header {
    display: flex;
    align-items: center;
    justify-content: space-between;
