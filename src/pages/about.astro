  }

  .story-card__text {
    font-size: 1rem;
    line-height: 1.65;
    color: #475569;
    margin: 0;
  }

  .story-card__text--lead {
    font-size: 1.05rem;
    color: #334155;
  }

  .story-card__flex-row {
    display: grid;
