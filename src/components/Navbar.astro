---
const navLinks = [
  { href: "/", label: "Home" },
  { href: "/about", label: "About" },
  { href: "/services", label: "Services" },
  { href: "/work", label: "Work" },
  { href: "/process", label: "Process" },
  { href: "/products", label: "Products" },
  { href: "/blog", label: "Guides & Blog" },
  { href: "/testimonials", label: "Testimonials" },
  { href: "/contact", label: "Contact" },
];

const pathname = Astro.url.pathname;
---

<header class="site-header" id="site-header">
  <div class="site-header__container">
    <!-- Logo -->
    <a href="/" class="site-logo" aria-label="N3 Global Tech Home">
      <img
        src="/n3logo.webp"
        alt="N3 Global Tech Logo"
        class="site-logo__img"
        width="40"
        height="40"
      />
      <span class="site-logo__text">Global Tech</span>
    </a>

    <!-- Minimalist Menu Trigger (Hamburger) -->
    <button
      class="site-menu-trigger"
      id="site-menu-trigger"
      type="button"
      aria-label="Open navigation menu"
      aria-expanded="false"
    >
      <span class="site-menu-trigger__bars" aria-hidden="true">
        <span></span>
        <span></span>
      </span>
    </button>
  </div>
</header>

<!-- Full-Screen Editorial Menu Overlay -->
<div class="nav-overlay" id="nav-overlay" aria-hidden="true">
  <div class="nav-overlay__bg-glow"></div>

  <div class="nav-overlay__header">
    <a href="/" class="site-logo site-logo--overlay" aria-label="N3 Global Tech Home">
      <img
        src="/n3logo.webp"
        alt="N3 Global Tech Logo"
        class="site-logo__img"
        width="40"
        height="40"
      />
      <span class="site-logo__text">Global Tech</span>
    </a>

    <button
      class="nav-overlay__close"
      id="nav-overlay-close"
      type="button"
      aria-label="Close navigation menu"
    >
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
        <line x1="18" y1="6" x2="6" y2="18"></line>
        <line x1="6" y1="6" x2="18" y2="18"></line>
      </svg>
    </button>
  </div>

  <div class="nav-overlay__content">
    <div class="nav-overlay__grid">
      <!-- Left Meta Info -->
      <div class="nav-overlay__meta">
        <div class="nav-overlay__section">
          <h4 class="nav-overlay__label">LET'S MEET</h4>
          <p class="nav-overlay__text">
            TK Junction, Near Capital Mall,<br />
            Thana, Kannur, Kerala 670002, India
          </p>
        </div>

        <div class="nav-overlay__section">
          <h4 class="nav-overlay__label">LET'S TALK</h4>
          <p class="nav-overlay__text">
            <a href="tel:+919645091256">+91 96450 91256</a><br />
            <a href="mailto:contact@n3global.tech">contact@n3global.tech</a>
          </p>
        </div>

        <div class="nav-overlay__section">
          <h4 class="nav-overlay__label">CONNECT</h4>
          <div class="nav-overlay__socials">
            <a href="https://www.linkedin.com/company/n3-global-tech" target="_blank" rel="noopener noreferrer" aria-label="LinkedIn">LinkedIn</a>
            <a href="https://www.instagram.com/n3globaltech" target="_blank" rel="noopener noreferrer" aria-label="Instagram">Instagram</a>
            <a href="mailto:contact@n3global.tech" aria-label="Email">Email</a>
          </div>
        </div>

        <div class="nav-overlay__footer-tag">
          <p>Let's build something <strong>great together</strong></p>
          <a href="mailto:contact@n3global.tech" class="nav-overlay__footer-email">contact@n3global.tech</a>
        </div>
      </div>

      <!-- Right Navigation Links Stack -->
      <nav class="nav-overlay__nav" aria-label="Full menu">
        <ul class="nav-overlay__list">
          {navLinks.map((link) => {
            const isActive = pathname === link.href || (link.href !== "/" && pathname.startsWith(link.href));
            return (
              <li>
                <a
                  href={link.href}
                  class:list={["nav-overlay__link", { "is-active": isActive }]}
                >
                  {link.label}
                </a>
              </li>
            );
          })}
        </ul>
      </nav>
    </div>

    <!-- Mobile Footer -->
    <div class="nav-overlay__mobile-footer">
      <p>Let's build something <strong>great together</strong></p>
      <a href="mailto:contact@n3global.tech" class="nav-overlay__footer-email">contact@n3global.tech</a>
    </div>
  </div>
</div>

<style>
  /* ── SITE HEADER ── */
  .site-header {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 1000;
    height: 80px;
    display: flex;
    align-items: center;
    background: transparent;
    border-bottom: 1px solid transparent;
    backdrop-filter: blur(0px);
    -webkit-backdrop-filter: blur(0px);
    transition: height 0.4s cubic-bezier(0.16, 1, 0.3, 1),
                background-color 0.4s ease,
                border-color 0.4s ease,
                backdrop-filter 0.4s ease,
                box-shadow 0.4s ease;
  }

  .site-header.scrolled {
    height: 66px;
    background: rgba(255, 255, 255, 0.5);
    border-bottom: 1px solid rgba(0, 0, 0, 0.06);
    backdrop-filter: blur(16px) saturate(180%);
    -webkit-backdrop-filter: blur(16px) saturate(180%);
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.04);
  }

  :global(.dark) .site-header.scrolled,
  :global([data-theme="dark"]) .site-header.scrolled {
    background: rgba(15, 23, 42, 0.5);
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.2);
  }

  .site-header__container {
    width: 100%;
    max-width: 100%;
    margin: 0;
    padding: 0 3rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  /* Logo */
  .site-logo {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    text-decoration: none;
    color: inherit;
    z-index: 10;
  }

  .site-logo__img {
    width: 40px;
    height: 40px;
    object-fit: contain;
    border-radius: 9px;
  }

  .site-logo__text {
    font-family: var(--font-sans);
    font-size: 1.2rem;
    font-weight: 650;
    letter-spacing: -0.02em;
    color: var(--gray-900, #0f172a);
    white-space: nowrap;
    transition: color 0.3s ease;
  }

  :global(.dark) .site-logo__text,
  :global([data-theme="dark"]) .site-logo__text,
  :global(.dark) .site-header.scrolled .site-logo__text,
  :global([data-theme="dark"]) .site-header.scrolled .site-logo__text {
    color: #ffffff;
  }

  /* Minimalist Hamburger Trigger */
  .site-menu-trigger {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 48px;
    height: 48px;
    background: transparent;
    border: none;
    cursor: pointer;
    padding: 0;
    color: var(--gray-900, #0f172a);
    border-radius: 50%;
    transition: background-color 0.2s ease, transform 0.2s ease;
  }

  :global(.dark) .site-menu-trigger,
  :global([data-theme="dark"]) .site-menu-trigger,
  :global(.dark) .site-header.scrolled .site-menu-trigger,
  :global([data-theme="dark"]) .site-header.scrolled .site-menu-trigger {
    color: #ffffff;
  }

  .site-menu-trigger:hover {
    background: color-mix(in srgb, currentColor 10%, transparent);
    transform: scale(1.06);
  }

  .site-menu-trigger__bars {
    display: flex;
    flex-direction: column;
    gap: 7px;
    width: 26px;
  }

  .site-menu-trigger__bars span {
    display: block;
    width: 100%;
    height: 2.5px;
    background-color: currentColor;
    border-radius: 2px;
    transition: transform 0.3s ease, width 0.25s ease;
  }

  .site-menu-trigger__bars span:nth-child(2) {
    width: 68%;
    margin-left: auto;
  }

  .site-menu-trigger:hover .site-menu-trigger__bars span:nth-child(2) {
    width: 100%;
  }

  /* ── FULL-SCREEN EDITORIAL MENU OVERLAY ── */
  .nav-overlay {
    position: fixed;
    inset: 0;
    z-index: 2000;
    display: flex;
    flex-direction: column;
    background: var(--gray-900, #0f172a);
    color: #f8fafc;
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transform: translateY(-12px);
    transition: opacity 0.35s ease, transform 0.35s cubic-bezier(0.16, 1, 0.3, 1), visibility 0.35s ease;
    overflow-y: auto;
  }

  .nav-overlay__bg-glow {
    position: absolute;
    top: -100px;
    right: -100px;
    width: 600px;
    height: 600px;
    background: radial-gradient(circle, rgba(14, 165, 233, 0.15) 0%, transparent 70%);
    pointer-events: none;
  }

  .nav-overlay.is-open {
    opacity: 1;
    visibility: visible;
    pointer-events: all;
    transform: translateY(0);
  }

  .nav-overlay__header {
    width: 100%;
    max-width: 100%;
    margin: 0;
    padding: 1.75rem 3rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-shrink: 0;
  }

  .site-logo--overlay .site-logo__text {
    color: #ffffff;
  }

  .nav-overlay__close {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 48px;
    height: 48px;
    background: rgba(255, 255, 255, 0.08);
    border: 1px solid rgba(255, 255, 255, 0.14);
    border-radius: 50%;
    color: #ffffff;
    cursor: pointer;
    transition: background-color 0.2s ease, transform 0.25s ease;
  }

  .nav-overlay__close:hover {
    background: rgba(255, 255, 255, 0.18);
    transform: rotate(90deg);
  }

  .nav-overlay__close svg {
    width: 22px;
    height: 22px;
  }

  .nav-overlay__content {
    flex: 1;
    width: 100%;
    max-width: 1400px;
    margin: 0 auto;
    padding: 1rem 2.25rem 3rem;
    display: flex;
    flex-direction: column;
    justify-content: center;
  }

  .nav-overlay__grid {
    display: grid;
    grid-template-columns: 1fr 1.25fr;
    gap: 4rem;
    align-items: center;
  }

  /* Left Meta Details */
  .nav-overlay__meta {
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }

  .nav-overlay__section {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  .nav-overlay__label {
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--sky-400, #38bdf8); /* N3 Sky Blue Accent */
    margin: 0;
  }

  .nav-overlay__text {
    font-size: 0.95rem;
    line-height: 1.6;
    color: var(--gray-400, #94a3b8);
    margin: 0;
  }

  .nav-overlay__text a {
    color: #cbd5e1;
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .nav-overlay__text a:hover {
    color: var(--sky-400, #38bdf8);
  }

  .nav-overlay__socials {
    display: flex;
    gap: 1.25rem;
  }

  .nav-overlay__socials a {
    font-size: 0.9rem;
    color: var(--gray-400, #94a3b8);
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .nav-overlay__socials a:hover {
    color: var(--sky-400, #38bdf8);
  }

  .nav-overlay__footer-tag {
    margin-top: 2rem;
    padding-top: 2rem;
    border-top: 1px solid rgba(255, 255, 255, 0.08);
  }

  .nav-overlay__footer-tag p {
    font-size: 0.95rem;
    color: var(--gray-500, #64748b);
    margin: 0 0 0.25rem;
  }

  .nav-overlay__footer-tag strong {
    color: #e2e8f0;
  }

  .nav-overlay__footer-email {
    font-size: 0.9rem;
    color: var(--sky-400, #38bdf8);
    text-decoration: none;
  }

  /* Right Navigation Links List */
  .nav-overlay__nav {
    display: flex;
    flex-direction: column;
  }

  .nav-overlay__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.55rem;
  }

  .nav-overlay__link {
    display: inline-block;
    font-family: var(--font-sans);
    font-size: clamp(2rem, 3.6vw, 3.1rem);
    font-weight: 500;
    line-height: 1.15;
    color: #cbd5e1;
    text-decoration: none;
    letter-spacing: -0.02em;
    transition: color 0.25s ease, transform 0.25s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .nav-overlay__link:hover {
    color: #ffffff;
    transform: translateX(12px);
  }

  .nav-overlay__link.is-active {
    color: var(--sky-400, #38bdf8); /* N3 Sky Blue Active Highlight */
    font-weight: 600;
  }

  .nav-overlay__mobile-footer {
    display: none;
  }

  /* Responsive Media Queries */
  @media (max-width: 900px) {
    .nav-overlay__grid {
      grid-template-columns: 1fr;
      gap: 2.5rem;
    }

    .nav-overlay__meta {
      display: none; /* Hide left column on tablet/mobile so links take priority */
    }

    .nav-overlay__link {
      font-size: clamp(1.85rem, 7vw, 2.75rem);
    }

    .nav-overlay__mobile-footer {
      display: block;
      margin-top: 3rem;
      padding-top: 1.5rem;
      border-top: 1px solid rgba(255, 255, 255, 0.08);
    }

    .nav-overlay__mobile-footer p {
      font-size: 0.9rem;
      color: var(--gray-500, #64748b);
      margin: 0 0 0.25rem;
    }

    .nav-overlay__mobile-footer strong {
      color: #e2e8f0;
    }
  }

  @media (max-width: 600px) {
    .site-header__container,
    .nav-overlay__header,
    .nav-overlay__content {
      padding-left: 1.25rem;
      padding-right: 1.25rem;
    }
  }
</style>

<script is:inline>
  (function () {
    var header = document.getElementById("site-header");
    var trigger = document.getElementById("site-menu-trigger");
    var overlay = document.getElementById("nav-overlay");
    var closeBtn = document.getElementById("nav-overlay-close");
    if (!header || !trigger || !overlay || !closeBtn) return;

    function onScroll() {
      if (window.scrollY > 50) {
        header.classList.add("scrolled");
      } else {
        header.classList.remove("scrolled");
      }
    }

    window.addEventListener("scroll", onScroll, { passive: true });
    onScroll();

    function openMenu() {
      overlay.classList.add("is-open");
      trigger.setAttribute("aria-expanded", "true");
      overlay.setAttribute("aria-hidden", "false");
      document.body.style.overflow = "hidden";
    }

    function closeMenu() {
      overlay.classList.remove("is-open");
      trigger.setAttribute("aria-expanded", "false");
      overlay.setAttribute("aria-hidden", "true");
      document.body.style.overflow = "";
    }

    trigger.addEventListener("click", openMenu);
    closeBtn.addEventListener("click", closeMenu);

    // Close when clicking any nav link
    overlay.querySelectorAll("a").forEach(function (link) {
      link.addEventListener("click", closeMenu);
    });

    // Close on Escape key press
    window.addEventListener("keydown", function (e) {
      if (e.key === "Escape" && overlay.classList.contains("is-open")) {
        closeMenu();
      }
    });
  })();
</script>
