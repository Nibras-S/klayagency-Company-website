---
// "Let's work together" — sits after About Us, before the footer.
//
// Scroll choreography:
//   1. Enters as an inset rounded card, video paused on its poster.
//   2. As you scroll, the card opens out to full-bleed (clip-path inset, so the
//      video never reflows or rescales — only the reveal window changes).
//   3. Once mostly open, the full video begins its seamless loop and the copy
//      fades in near the end of its first pass.
---

<section class="lwt" id="lwt" aria-labelledby="lwt-title">
  <div class="lwt__sticky">
    <div class="lwt__stage" id="lwt-stage">
      <!-- `src` is assigned only when this below-the-fold section approaches
           the viewport. The full-resolution H.264 source is hardware-decodable
           across modern desktop and mobile browsers. -->
      <video
        id="lwt-video"
        class="lwt__video lwt__video--is-active"
        muted
        playsinline
        webkit-playsinline
        loop
        preload="none"
        disablepictureinpicture
        poster="/video/lwt/letwork-full-poster.webp"
        data-src="/video/lwt/letwork-full-loop-1080.mp4"
        aria-hidden="true"
      ></video>
    </div>

    <div class="container lwt__content" id="lwt-content">
      <h2 class="lwt__title" id="lwt-title">Let's work together</h2>
      <div class="lwt__actions">
        <a href="/contact" class="lwt__btn lwt__btn--primary">
          <span>Start a Project</span>
          <span class="lwt__btn-icon" aria-hidden="true">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <line x1="7" y1="17" x2="17" y2="7"></line>
              <polyline points="7 7 17 7 17 17"></polyline>
            </svg>
          </span>
        </a>
        <a href="/contact" class="lwt__btn lwt__btn--ghost">Let's Talk</a>
      </div>
    </div>
  </div>
</section>

<style>
  /* Track gives the sticky child room to run the open-out sequence. */
  .lwt {
    position: relative;
    height: 220vh;
    background: #04050c;
  }

  .lwt__sticky {
    position: sticky;
    top: 0;
    height: 100svh;
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  /* clip-path rather than width/height: the video keeps its size and layout, so
     opening out costs no reflow and never rescales the picture. */
  .lwt__stage {
    position: absolute;
    inset: 0;
    z-index: 0;
    clip-path: inset(
      var(--lwt-inset-top, 6%)
      var(--lwt-inset-x, 13%)
      var(--lwt-inset-bottom, 14%)
      round var(--lwt-radius, 28px)
    );
    background: #04050c;
  }

  .lwt__video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0;
    transition: opacity 0.5s ease;
    pointer-events: none;
  }
  .lwt__video--is-active { opacity: 1; }

  /* Copy sits above the stage; only the buttons take pointer events. */
  .lwt__content {
    position: relative;
    z-index: 1;
    text-align: center;
    color: #ffffff;
    pointer-events: none;
    opacity: 0;
    transform: translate3d(0, 26px, 0);
    filter: blur(8px);
    transition:
      opacity 0.9s ease,
      transform 0.9s cubic-bezier(0.16, 1, 0.3, 1),
      filter 0.9s ease;
  }
  .lwt.is-revealed .lwt__content {
    opacity: 1;
    transform: none;
    filter: none;
  }

  /* Same display voice as the hero / flow / services titles. */
  .lwt__title {
    font-family: var(--font-sans);
    font-size: var(--display-lg);
    font-weight: 500;
    line-height: 0.95;
    letter-spacing: -0.04em;
    color: #ffffff;
    margin-bottom: 2.25rem;
    text-shadow: 0 2px 40px rgba(0, 0, 0, 0.6);
  }

  .lwt__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    justify-content: center;
  }

  .lwt__btn {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    border-radius: var(--radius-full);
    font-family: var(--font-sans);
    font-weight: 500;
    font-size: 0.9375rem;
    letter-spacing: -0.01em;
    text-decoration: none;
    pointer-events: auto;
    transition: transform 0.25s ease, box-shadow 0.25s ease, background-color 0.25s ease;
  }
  .lwt__btn:hover { transform: translateY(-2px); }

  .lwt__btn--primary {
    padding: 0.25rem 0.25rem 0.25rem 1.25rem;
    background: #000000;
    color: #ffffff;
    box-shadow: 0 12px 32px rgba(0, 0, 0, 0.28);
  }
  .lwt__btn-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.5rem;
    height: 2.5rem;
    border-radius: 50%;
    background: #ffffff;
    color: var(--sky-500);
    transition: transform 0.25s ease;
  }
  .lwt__btn--primary:hover .lwt__btn-icon { transform: rotate(45deg); }

  .lwt__btn--ghost {
    padding: 0.95rem 1.9rem;
    background: rgba(255, 255, 255, 0.08);
    border: 1px solid rgba(255, 255, 255, 0.22);
    color: #ffffff;
  }
  .lwt__btn--ghost:hover { background: rgba(255, 255, 255, 0.16); }

  .lwt__btn:focus-visible {
    outline: 3px solid var(--sky-400);
    outline-offset: 3px;
  }

  @media (max-width: 860px) {
    .lwt { height: 200vh; }
    .lwt__stage {
      --lwt-inset-top: 5%;
      --lwt-inset-x: 6%;
      --lwt-inset-bottom: 9%;
    }
    .lwt__content {
      width: min(82%, 22rem);
      padding-inline: 0;
    }
    .lwt__title {
      max-width: 100%;
      margin-bottom: 1.75rem;
      font-size: clamp(2rem, 8.5vw, 2.5rem);
      line-height: 1;
      letter-spacing: -0.045em;
      white-space: nowrap;
    }
    .lwt__actions { flex-direction: column; align-items: stretch; }
    .lwt__btn { justify-content: center; }
  }

  /* No scroll choreography: one screen, open, copy visible, video still loops
     only if the user's setting allows it (the script keeps it paused). */
  @media (prefers-reduced-motion: reduce) {
    .lwt { height: auto; }
    .lwt__sticky { position: static; height: 100svh; }
    .lwt__stage { clip-path: none; }
    .lwt__content {
      opacity: 1;
      transform: none;
      filter: none;
      transition: none;
    }
    .lwt__btn:hover { transform: none; }
  }
</style>

<script>
  function initLwt() {
    const section = document.getElementById('lwt');
    const stage = document.getElementById('lwt-stage');
    const video = document.getElementById('lwt-video') as HTMLVideoElement | null;
    if (!section || !stage || !video) return;

    // Astro view transitions re-run scripts; don't double-bind.
    if (section.dataset.lwtBound === '1') return;
    section.dataset.lwtBound = '1';

    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    const videoSrc = video.dataset.src || '';
    if (!videoSrc) {
      console.warn('[lwt] no video source resolved; leaving poster in place');
      section.classList.add('is-revealed');
      return;
    }

    if (reduced) {
      // CSS presents the static poster and copy without requesting the video.
      section.classList.add('is-revealed');
      return;
    }

    // Opening geometry, driven by scroll progress.
    const RADIUS = 28;     // px at rest
    const OPEN_AT = 0.55;  // progress by which the card is fully open
    const PLAY_AT = 0.42;  // start playback just before the card finishes opening

    let inView = false;
    let raf: number | null = null;
    let started = false;
    let revealed = false;
    let sourceAssigned = false;

    function ensureVideoLoaded() {
      if (sourceAssigned) return;
      sourceAssigned = true;
      video!.src = videoSrc;
      video!.preload = 'auto';
      video!.load();
    }

    function wake() {
      if (inView && raf === null) raf = requestAnimationFrame(tick);
    }

    function tick() {
      raf = null;
      const r = section!.getBoundingClientRect();
      const travel = r.height - window.innerHeight;
      const p = travel > 0 ? Math.min(Math.max(-r.top / travel, 0), 1) : 1;

      // Remap so the card is fully open by OPEN_AT, then holds.
      const o = Math.min(p / OPEN_AT, 1);
      const eased = o * o * (3 - 2 * o);   // smoothstep
      const compact = window.innerWidth <= 860;
      const insetTop = compact ? 5 : 6;
      const insetX = compact ? 6 : 13;
      const insetBottom = compact ? 9 : 14;

      stage!.style.setProperty('--lwt-inset-top', `${(insetTop * (1 - eased)).toFixed(2)}%`);
      stage!.style.setProperty('--lwt-inset-x', `${(insetX * (1 - eased)).toFixed(2)}%`);
      stage!.style.setProperty('--lwt-inset-bottom', `${(insetBottom * (1 - eased)).toFixed(2)}%`);
      stage!.style.setProperty('--lwt-radius', `${(RADIUS * (1 - eased)).toFixed(1)}px`);

      // Playback starts only once the section is genuinely open.
      if (!started && p >= PLAY_AT) {
        started = true;
        ensureVideoLoaded();
        video!.play().catch(() => {});
      }
    }

    // Reveal the copy near the end of the first pass. The video itself loops,
    // so playback stays gapless without a second media-element handoff.
    video.addEventListener('timeupdate', () => {
      if (!revealed && video.duration && video.currentTime >= video.duration - 0.25) {
        revealed = true;
        section.classList.add('is-revealed');
      }
    });
    video.addEventListener('error', () => {
      // Keep the call-to-action usable even if a media request is blocked.
      section.classList.add('is-revealed');
    }, { once: true });

    // --- visibility: nothing decodes while the section is off-screen
    const io = new IntersectionObserver(
      (entries) => {
        inView = entries[0].isIntersecting;
        if (inView) {
          ensureVideoLoaded();
          wake();
          if (started) video.play().catch(() => {});
        } else {
          video.pause();
          if (raf !== null) { cancelAnimationFrame(raf); raf = null; }
        }
      },
      // Begin fetching shortly before the section arrives, without competing
      // with above-the-fold resources during initial page load.
      { rootMargin: '600px 0px' }
    );
    io.observe(section);

    window.addEventListener('scroll', wake, { passive: true });
    window.addEventListener('resize', wake, { passive: true });
    tick();

    function destroy() {
      io.disconnect();
      window.removeEventListener('scroll', wake);
      window.removeEventListener('resize', wake);
      if (raf !== null) cancelAnimationFrame(raf);
      video!.pause();
      section!.dataset.lwtBound = '';
    }
    window.addEventListener('pagehide', destroy, { once: true });
    document.addEventListener('astro:before-swap', destroy, { once: true });
  }

  initLwt();
  document.addEventListener('astro:page-load', initLwt);
</script>
