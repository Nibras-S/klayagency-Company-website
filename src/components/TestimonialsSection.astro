---
interface Testimonial {
  id: string;
  name: string;
  role: string;
  company: string;
  avatar?: string;
  rating: number;
  quote: string;
  featured?: boolean;
  image?: string;
  audioUrl?: string | null;
  audioDuration?: string | null;
}

const testimonials: Testimonial[] = [
  {
    id: "featured-sparemec",
    name: "Shabin Malandy",
    role: "Founder & CEO",
    company: "SpareMec®",
    featured: true,
    image: "/sparemeclient.png",
    rating: 5,
    quote: "Working with N3 Global Tech felt less like hiring an agency and more like gaining a strategic partner for company.",
    audioUrl: "https://actions.google.com/sounds/v1/ambiences/rain_heavy.ogg", // Audio voice feedback URL
    audioDuration: "38s"
  },
  {
    id: "card-azeefit",
    name: "AzeeFit Founder",
    role: "Founder",
    company: "AzeeFit",
    rating: 5,
    quote: "Working with N3 Global Tech was fantastic. They built exactly what we needed with N3 FitBook and felt like an extension of our team.",
    audioUrl: "https://actions.google.com/sounds/v1/ambiences/outdoor_theme_park.ogg", // Voice feedback sample
    audioDuration: "28s"
  },
  {
    id: "card-viera",
    name: "Viera Management",
    role: "Client",
    company: "Viera ERP & Website",
    rating: 5,
    quote: "N3 Global Tech delivered our ERP system and website with exceptional detail, streamlining our operations and digital presence.",
    audioUrl: null, // No voice audio file (play button hidden)
    audioDuration: null
  }
];

const featuredTestimonial = testimonials.find((t) => t.featured) || testimonials[0];
const standardTestimonials = testimonials.filter((t) => !t.featured);

const metrics = [
  {
    value: "92%",
    label: "of our clients return for a second project",
    progress: 92
  },
  {
    value: "87%",
    label: "reported a stronger brand perception",
    progress: 87
  },
  {
    value: "74%",
    label: "saw increased engagement on digital",
    progress: 74
  }
];
---

<section class="testimonials-section reveal" id="testimonials">
  <div class="container testimonials-container">
    <div class="testimonials-grid">
      
      <!-- COLUMN 1: Header & Key Metrics -->
      <div class="testimonials-col testimonials-col--meta">
        <div class="testimonials-meta-header">
          <div class="testimonials-badge">
            <span class="badge-dot"></span>
            <span>TESTIMONIALS</span>
          </div>
          <h2 class="testimonials-title">What our clients are saying</h2>
          <p class="testimonials-subtitle">Some data about our clients</p>
        </div>

        <div class="testimonials-metrics-list">
          {metrics.map((m) => (
            <div class="metric-item">
              <div class="metric-value">{m.value}</div>
              <p class="metric-label">{m.label}</p>
              <div class="metric-progress-track">
                <div class="metric-progress-fill" style={`width: ${m.progress}%`}></div>
              </div>
            </div>
          ))}
        </div>
      </div>

      <!-- COLUMN 2: Featured Hero Card (Center Image Card) -->
      <div class="testimonials-col testimonials-col--featured">
        <article class="featured-card">
          <img 
            src={featuredTestimonial.image} 
            alt={`${featuredTestimonial.name} - ${featuredTestimonial.company}`} 
            class="featured-card__bg"
            loading="lazy"
          />
          <div class="featured-card__overlay"></div>

          <!-- Play Audio Center Button (Only displayed if audioUrl exists) -->
          {featuredTestimonial.audioUrl && (
            <div class="featured-card__play-wrapper">
              <button 
                class="featured-play-btn audio-play-trigger" 
                data-audio={featuredTestimonial.audioUrl}
                data-id={featuredTestimonial.id}
                aria-label="Play audio feedback"
              >
                <div class="play-icon-circle">
                  <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor" class="icon-play">
                    <polygon points="6 3 20 12 6 21 6 3"></polygon>
                  </svg>
                  <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor" class="icon-pause" style="display: none;">
                    <rect x="6" y="4" width="4" height="16"></rect>
                    <rect x="14" y="4" width="4" height="16"></rect>
                  </svg>
                </div>
                <span class="play-btn-text">
                  Listen {featuredTestimonial.audioDuration ? featuredTestimonial.audioDuration : ""} client story
                </span>
              </button>
            </div>
          )}

          <!-- Card Content Overlay at Bottom -->
          <div class="featured-card__content">
            <div class="star-rating">
              {Array.from({ length: featuredTestimonial.rating }).map(() => (
                <svg width="18" height="18" viewBox="0 0 24 24" fill="#f59e0b" stroke="#f59e0b" stroke-width="1">
                  <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon>
                </svg>
              ))}
            </div>

            <blockquote class="featured-quote">
              “{featuredTestimonial.quote}”
            </blockquote>

            <div class="featured-author">
              <span class="author-name">{featuredTestimonial.name}</span>
              <span class="author-role">{featuredTestimonial.role} at {featuredTestimonial.company}</span>
            </div>
          </div>
        </article>
      </div>

      <!-- COLUMN 3: Right Column Testimonial Cards -->
      <div class="testimonials-col testimonials-col--list">
        {standardTestimonials.map((t) => (
          <article class="testimonial-card">
            <div class="testimonial-card__header">
              <!-- Stars -->
              <div class="star-rating">
                {Array.from({ length: t.rating }).map(() => (
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="#f59e0b" stroke="#f59e0b" stroke-width="1">
                    <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon>
                  </svg>
                ))}
              </div>

              <!-- Audio Play Button (Rendered ONLY if audioUrl is present) -->
              {t.audioUrl ? (
                <button 
                  class="audio-listen-pill audio-play-trigger" 
                  data-audio={t.audioUrl}
                  data-id={t.id}
                >
                  <span class="pill-icon-play">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor">
                      <polygon points="6 3 20 12 6 21 6 3"></polygon>
                    </svg>
                  </span>
                  <span class="pill-icon-pause" style="display: none;">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor">
                      <rect x="6" y="4" width="4" height="16"></rect>
                      <rect x="14" y="4" width="4" height="16"></rect>
                    </svg>
                  </span>
                  <span class="pill-label">Listen {t.audioDuration}</span>
                </button>
              ) : null}
            </div>

            <blockquote class="testimonial-quote">
              “{t.quote}”
            </blockquote>

            <div class="testimonial-author">
              {t.avatar ? (
                <img src={t.avatar} alt={t.name} class="author-avatar" loading="lazy" />
              ) : (
                <div class="author-avatar-fallback">{t.name.charAt(0)}</div>
              )}
              <div class="author-details">
                <span class="author-name">{t.name}</span>
                <span class="author-role">{t.role} at {t.company}</span>
              </div>
            </div>
          </article>
        ))}
      </div>

    </div>
  </div>
</section>

<!-- Audio Feedback Script -->
<script is:inline>
  document.addEventListener("DOMContentLoaded", () => {
    let currentAudio = null;
    let activeTriggerBtn = null;

    const triggers = document.querySelectorAll(".audio-play-trigger");

    triggers.forEach((btn) => {
      btn.addEventListener("click", (e) => {
        e.preventDefault();
        const audioSrc = btn.getAttribute("data-audio");
        if (!audioSrc) return;

        // If clicking currently playing audio button -> pause it
        if (currentAudio && activeTriggerBtn === btn) {
          if (!currentAudio.paused) {
            currentAudio.pause();
            resetButtonState(btn);
            return;
          } else {
            currentAudio.play();
            setPlayingButtonState(btn);
            return;
          }
        }

        // If another audio was playing -> stop it and reset its button
        if (currentAudio) {
          currentAudio.pause();
          if (activeTriggerBtn) resetButtonState(activeTriggerBtn);
        }

        // Create new audio instance & play
        currentAudio = new Audio(audioSrc);
        activeTriggerBtn = btn;
        setPlayingButtonState(btn);

        currentAudio.play().catch((err) => {
          console.log("Audio play error:", err);
          resetButtonState(btn);
        });

        // Reset button state when audio finishes playing
        currentAudio.addEventListener("ended", () => {
          resetButtonState(btn);
          currentAudio = null;
          activeTriggerBtn = null;
        });
      });
    });

    function setPlayingButtonState(btn) {
      const playIcon = btn.querySelector(".icon-play, .pill-icon-play");
      const pauseIcon = btn.querySelector(".icon-pause, .pill-icon-pause");
      const label = btn.querySelector(".play-btn-text, .pill-label");

      if (playIcon) playIcon.style.display = "none";
      if (pauseIcon) pauseIcon.style.display = "inline-block";
      if (label) {
        if (btn.classList.contains("featured-play-btn")) {
          label.textContent = "Playing voice note...";
        } else {
          label.textContent = "Playing...";
        }
      }
      btn.classList.add("is-playing");
    }

    function resetButtonState(btn) {
      const playIcon = btn.querySelector(".icon-play, .pill-icon-play");
      const pauseIcon = btn.querySelector(".icon-pause, .pill-icon-pause");
      const label = btn.querySelector(".play-btn-text, .pill-label");

      if (playIcon) playIcon.style.display = "inline-block";
      if (pauseIcon) pauseIcon.style.display = "none";
      if (label) {
        if (btn.classList.contains("featured-play-btn")) {
          label.textContent = "Listen 38s client story";
        } else {
          label.textContent = "Listen 28s";
        }
      }
      btn.classList.remove("is-playing");
    }
  });
</script>

<style>
  .testimonials-section {
    padding: 6rem 0;
    background: #fdfdfd;
    position: relative;
    z-index: 5;
  }

  .testimonials-container {
    width: 100%;
    max-width: 1380px;
    margin: 0 auto;
  }

  /* 3-Column Desktop Grid Layout */
  .testimonials-grid {
    display: grid;
    grid-template-columns: 320px 1fr 1fr;
    gap: 2.25rem;
    align-items: stretch;
  }

  /* COLUMN 1: Meta Column */
  .testimonials-col--meta {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    padding-right: 1rem;
  }

  .testimonials-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    color: var(--gray-800);
    text-transform: uppercase;
    margin-bottom: 1.5rem;
  }

  .badge-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: #0284c7;
    box-shadow: 0 0 0 3px rgba(2, 132, 199, 0.15);
  }

  .testimonials-title {
    font-size: clamp(2.4rem, 3.5vw, 3.25rem);
    font-weight: 800;
    color: var(--gray-900);
    line-height: 1.08;
    letter-spacing: -0.03em;
    margin-bottom: 1.25rem;
  }

  .testimonials-subtitle {
    font-size: 0.95rem;
    color: var(--gray-500);
    line-height: 1.5;
    margin-bottom: 2.5rem;
  }

  .testimonials-metrics-list {
    display: flex;
    flex-direction: column;
    gap: 1.75rem;
    padding-top: 1.5rem;
    border-top: 1px dashed var(--gray-200);
  }

  .metric-item {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  .metric-value {
    font-size: 1.85rem;
    font-weight: 800;
    color: var(--gray-900);
    line-height: 1;
    letter-spacing: -0.02em;
  }

  .metric-label {
    font-size: 0.82rem;
    color: var(--gray-500);
    line-height: 1.4;
  }

  .metric-progress-track {
    width: 100%;
    height: 3px;
    background: #e2e8f0;
    border-radius: 2px;
    margin-top: 0.5rem;
    overflow: hidden;
  }

  .metric-progress-fill {
    height: 100%;
    background: var(--gray-900);
    border-radius: 2px;
  }

  /* COLUMN 2: Featured Hero Card */
  .testimonials-col--featured {
    display: flex;
  }

  .featured-card {
    position: relative;
    width: 100%;
    min-height: 540px;
    border-radius: 28px;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    padding: 2.5rem 2rem;
    box-shadow: 0 16px 40px rgba(0, 0, 0, 0.12);
  }

  .featured-card__bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 20%;
    z-index: 1;
    transition: transform 0.6s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .featured-card:hover .featured-card__bg {
    transform: scale(1.03);
  }

  .featured-card__overlay {
    position: absolute;
    inset: 0;
    z-index: 2;
    background: linear-gradient(
      to top, 
      rgba(15, 23, 42, 0.95) 0%, 
      rgba(15, 23, 42, 0.65) 45%, 
      rgba(0, 0, 0, 0.25) 100%
    );
  }

  /* Play Button on Featured Card - Centered on Desktop & Mobile */
  .featured-card__play-wrapper {
    position: absolute;
    top: 48%;
    left: 50%;
    transform: translate(-50%, -50%);
    z-index: 4;
    display: flex;
    justify-content: center;
    align-items: center;
    width: max-content;
  }

  .featured-play-btn {
    display: inline-flex;
    flex-direction: column;
    align-items: center;
    gap: 0.75rem;
    background: transparent;
    border: none;
    cursor: pointer;
    color: #ffffff;
    opacity: 0.65;
    transition: transform 0.3s ease, opacity 0.3s ease;
  }

  .featured-play-btn:hover {
    transform: scale(1.05);
    opacity: 1;
  }

  .play-icon-circle {
    width: 72px;
    height: 72px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.18);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border: 1.5px solid rgba(255, 255, 255, 0.4);
    display: flex;
    align-items: center;
    justify-content: center;
    color: #ffffff;
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.2);
    transition: background 0.3s ease, border-color 0.3s ease;
  }

  .featured-play-btn:hover .play-icon-circle {
    background: #0284c7;
    border-color: #0284c7;
  }

  .play-btn-text {
    font-size: 0.82rem;
    font-weight: 600;
    color: #ffffff;
    background: rgba(0, 0, 0, 0.35);
    padding: 0.4rem 1rem;
    border-radius: var(--radius-full);
    backdrop-filter: blur(8px);
    letter-spacing: 0.01em;
  }

  /* Featured Card Bottom Content */
  .featured-card__content {
    position: relative;
    z-index: 3;
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    margin-top: auto;
  }

  .star-rating {
    display: flex;
    align-items: center;
    gap: 0.25rem;
  }

  .featured-quote {
    font-size: clamp(1.15rem, 1.5vw, 1.35rem);
    font-weight: 600;
    color: #ffffff;
    line-height: 1.4;
    letter-spacing: -0.015em;
  }

  .featured-author {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
  }

  .featured-author .author-name {
    font-size: 1rem;
    font-weight: 700;
    color: #ffffff;
  }

  .featured-author .author-role {
    font-size: 0.85rem;
    color: #cbd5e1;
  }

  /* COLUMN 3: Testimonial Cards List */
  .testimonials-col--list {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    justify-content: space-between;
  }

  .testimonial-card {
    background: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 24px;
    padding: 2rem 1.75rem;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 1.5rem;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.02);
    transition: transform 0.3s ease, box-shadow 0.3s ease, border-color 0.3s ease;
    height: 100%;
  }

  .testimonial-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 16px 36px rgba(0, 0, 0, 0.06);
    border-color: #cbd5e1;
  }

  .testimonial-card__header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }

  /* Pill Audio Button */
  .audio-listen-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.4rem 0.9rem;
    border-radius: var(--radius-full);
    background: #f1f5f9;
    border: 1px solid #e2e8f0;
    color: var(--gray-800);
    font-size: 0.8rem;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.25s ease;
  }

  .audio-listen-pill:hover {
    background: #0284c7;
    border-color: #0284c7;
    color: #ffffff;
  }

  .audio-listen-pill.is-playing {
    background: #0284c7;
    border-color: #0284c7;
    color: #ffffff;
  }

  .testimonial-quote {
    font-size: 0.98rem;
    font-weight: 600;
    color: var(--gray-900);
    line-height: 1.55;
    letter-spacing: -0.01em;
  }

  .testimonial-author {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    margin-top: auto;
  }

  .author-avatar {
    width: 44px;
    height: 44px;
    border-radius: 12px;
    object-fit: cover;
  }

  .author-avatar-fallback {
    width: 44px;
    height: 44px;
    border-radius: 12px;
    background: var(--sky-100);
    color: var(--sky-700);
    font-weight: 700;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.1rem;
  }

  .author-details {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
  }

  .author-details .author-name {
    font-size: 0.95rem;
    font-weight: 700;
    color: var(--gray-900);
  }

  .author-details .author-role {
    font-size: 0.82rem;
    color: var(--gray-500);
  }

  /* Responsive Design */
  @media (max-width: 1200px) {
    .testimonials-grid {
      grid-template-columns: 1fr 1fr;
    }

    .testimonials-col--meta {
      grid-column: span 2;
      flex-direction: row;
      align-items: flex-end;
      gap: 3rem;
      padding-right: 0;
      margin-bottom: 1rem;
    }

    .testimonials-metrics-list {
      flex-direction: row;
      gap: 2rem;
      border-top: none;
      padding-top: 0;
    }
  }

  @media (max-width: 768px) {
    .testimonials-section {
      padding: 3.5rem 0 2.5rem 0;
    }

    .testimonials-grid {
      display: flex;
      flex-direction: column;
      gap: 1.5rem;
    }

    .testimonials-col--meta {
      grid-column: span 1;
      flex-direction: column;
      align-items: flex-start;
      gap: 0.5rem;
      padding-right: 0;
      margin-bottom: 0.5rem;
    }

    .testimonials-title {
      font-size: 2.25rem;
      font-weight: 800;
      line-height: 1.1;
      margin-bottom: 0;
      letter-spacing: -0.025em;
    }

    /* Hide subtitle and metrics list on mobile to match reference screenshot */
    .testimonials-subtitle,
    .testimonials-metrics-list {
      display: none !important;
    }

    .featured-card {
      min-height: 380px;
      border-radius: 20px;
      padding: 1.75rem 1.25rem;
    }

    .featured-quote {
      font-size: 1.1rem;
      line-height: 1.4;
    }

    .testimonial-card {
      border-radius: 20px;
      padding: 1.5rem 1.25rem;
    }
  }
</style>
