---
interface Testimonial {
  id: string;
  name: string;
  role: string;
  image: string;
  quote: string;
}

const testimonials: Testimonial[] = [
  {
    id: "t1",
    name: "Shabin Malandy",
    role: "Founder & CEO, SpareMec®",
    image: "/sparemeclient.png",
    quote: "Working with N3 Global Tech felt less like hiring an agency and more like gaining a strategic technology partner."
  },
  {
    id: "t2",
    name: "Aslam",
    role: "Founder, Enjoyfulife",
    image: "https://images.unsplash.com/photo-1534528741775-53994a69daeb?q=80&w=800&auto=format&fit=crop",
    quote: "N3 Global Tech delivered a clean, modern website improving usability, brand clarity, and customer experience."
  },
  {
    id: "t3",
    name: "Confidential Client",
    role: "Flyger",
    image: "https://images.unsplash.com/photo-1507003211169-0a1dd7228f2d?q=80&w=800&auto=format&fit=crop",
    quote: "Clear communication and fast delivery helped our team launch confidently with a scalable, high-performance website."
  },
  {
    id: "t4",
    name: "Sharika",
    role: "Founder, Red Force Fitness",
    image: "https://images.unsplash.com/photo-1517841905240-472988babdf9?q=80&w=800&auto=format&fit=crop",
    quote: "They built an intuitive fitness management app that simplified our daily operations with responsive support."
  },
  {
    id: "t5",
    name: "Nadeer Shah",
    role: "CEO, Viera",
    image: "https://images.unsplash.com/photo-1500648767791-00dcc994a43e?q=80&w=800&auto=format&fit=crop",
    quote: "Our website and ERP system transformed how we manage operations — intuitive, efficient, and effortless."
  },
  {
    id: "t6",
    name: "Azeees",
    role: "Founder, AzeeFit",
    image: "https://images.unsplash.com/photo-1494790108377-be9c29b29330?q=80&w=800&auto=format&fit=crop",
    quote: "N3 FitBook has been essential for managing our fitness center for over two years. Reliable, intuitive, and built to scale."
  },
  {
    id: "t7",
    name: "Shivaprasad",
    role: "Managing Director, Casbridge",
    image: "https://images.unsplash.com/photo-1522075469751-3a6694fb2f61?q=80&w=800&auto=format&fit=crop",
    quote: "A reliable technology partner consistently delivering high-quality design, solid architecture, and seamless communication."
  }
];

// Double list for seamless marquee loop
const marqueeList = [...testimonials, ...testimonials];
---

<section class="testimonials-section reveal" id="testimonials">
  <div class="container testimonials-container">
    <!-- Header -->
    <div class="ts-header">
      <div class="ts-badge">
        <span class="ts-badge__square"></span>
        <span>TESTIMONIAL</span>
      </div>
      <h2 class="ts-title">Client Stories</h2>
    </div>

    <div class="ts-divider"></div>
  </div>

  <!-- Full Width Edge-to-Edge Infinite Auto-Scrolling Marquee -->
  <div class="ts-slider-wrapper">
    <div class="ts-slider-track">
      {marqueeList.map((t, idx) => (
        <article class="ts-card" data-card-idx={idx}>
          <img 
            src={t.image} 
            alt={`${t.name} - ${t.role}`} 
            class="ts-card__bg" 
            loading="lazy"
          />
          <div class="ts-card__overlay"></div>

          <div class="ts-card__content">
            <blockquote class="ts-card__quote">
              “{t.quote}”
            </blockquote>
            <div class="ts-card__line"></div>
            <div class="ts-card__author">
              <span class="ts-card__name">{t.name}</span>
              <span class="ts-card__role">{t.role}</span>
            </div>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .testimonials-section {
    padding: 5rem 0 6rem 0;
    background: #ffffff;
    position: relative;
    z-index: 5;
    overflow: hidden;
  }

  .testimonials-container {
    width: 100%;
    max-width: 1380px;
    margin: 0 auto;
  }

  /* Header */
  .ts-header {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .ts-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    color: #475569;
    text-transform: uppercase;
  }

  .ts-badge__square {
    width: 7px;
    height: 7px;
    background: #0ea5e9;
    display: inline-block;
    border-radius: 1px;
  }

  .ts-title {
    font-size: clamp(2.2rem, 4vw, 3.25rem);
    font-weight: 800;
    color: #0f172a;
    line-height: 1.1;
    letter-spacing: -0.03em;
  }

  .ts-divider {
    width: 100%;
    height: 1px;
    background: #e2e8f0;
    margin: 1.25rem 0 2.5rem 0;
  }

  /* Marquee Slider Wrapper */
  .ts-slider-wrapper {
    width: 100%;
    overflow: hidden;
    position: relative;
    cursor: grab;
    mask-image: linear-gradient(
      to right,
      transparent 0%,
      #000 3%,
      #000 97%,
      transparent 100%
    );
    -webkit-mask-image: linear-gradient(
      to right,
      transparent 0%,
      #000 3%,
      #000 97%,
      transparent 100%
    );
  }

  .ts-slider-wrapper:active {
    cursor: grabbing;
  }

  .ts-slider-track {
    display: flex;
    gap: 1.5rem;
    width: max-content;
    animation: tsMarquee 38s linear infinite;
    will-change: transform;
  }

  .ts-slider-wrapper:hover .ts-slider-track {
    animation-play-state: paused;
  }

  @keyframes tsMarquee {
    0% {
      transform: translateX(0);
    }
    100% {
      transform: translateX(calc(-50% - 0.75rem));
    }
  }

  /* Individual Vertical Card */
  .ts-card {
    position: relative;
    width: 310px;
    height: 460px;
    border-radius: 20px;
    overflow: hidden;
    flex-shrink: 0;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.08);
    transition: transform 0.4s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.4s ease;
  }

  .ts-card:hover {
    transform: translateY(-6px) scale(1.02);
    box-shadow: 0 20px 40px rgba(14, 165, 233, 0.18);
  }

  .ts-card__bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center top;
    z-index: 1;
    transition: transform 0.6s ease;
  }

  .ts-card:hover .ts-card__bg {
    transform: scale(1.05);
  }

  /* Overlay: Sleek Blue Glass Overlay Gradient */
  .ts-card__overlay {
    position: absolute;
    inset: 0;
    z-index: 2;
    background: linear-gradient(
      to top,
      rgba(15, 23, 42, 0.96) 0%,
      rgba(14, 165, 233, 0.65) 45%,
      rgba(15, 23, 42, 0.15) 100%
    );
  }

  /* Content Overlay */
  .ts-card__content {
    position: relative;
    z-index: 3;
    padding: 1.75rem 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
  }

  .ts-card__quote {
    font-size: 1.02rem;
    font-weight: 600;
    color: #ffffff;
    line-height: 1.45;
    letter-spacing: -0.015em;
  }

  .ts-card__line {
    width: 100%;
    height: 1px;
    background: rgba(255, 255, 255, 0.35);
    margin: 0.4rem 0;
  }

  .ts-card__author {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
  }

  .ts-card__name {
    font-size: 1rem;
    font-weight: 700;
    color: #ffffff;
  }

  .ts-card__role {
    font-size: 0.85rem;
    color: rgba(255, 255, 255, 0.82);
    font-weight: 450;
  }

  /* Responsive Adjustments */
  @media (max-width: 768px) {
    .testimonials-section {
      padding: 3.5rem 0 4rem 0;
    }

    .ts-divider {
      margin: 1rem 0 1.75rem 0;
    }

    .ts-card {
      width: 270px;
      height: 410px;
      border-radius: 16px;
    }

    .ts-card__content {
      padding: 1.35rem 1.15rem;
    }

    .ts-card__quote {
      font-size: 0.95rem;
      line-height: 1.4;
    }

    .ts-slider-track {
      gap: 1.15rem;
      animation-duration: 28s;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .ts-slider-track {
      animation: none;
      overflow-x: auto;
    }
  }
</style>
